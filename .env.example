# Control Plane only. Never forward these variables to a Worker.
# Copy this file to .env, chmod 600 .env, and fill in the key locally.
# VulnLoom's current CUC connectivity probe reads CUC_DEEPSEEK_API_KEY.
CUC_DEEPSEEK_API_KEY=

# Generic model-provider settings reserved for the future general adapter.
# Keep these aligned with the CUC endpoint and requested model identity.
VULNLOOM_MODEL_API_KEY=
VULNLOOM_MODEL_BASE_URL=https://openai.cuc.edu.cn/v1
VULNLOOM_MODEL_NAME=cuc/deepseek
