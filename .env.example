# Control Plane only. Never forward these variables to a Worker.
# Copy this file to .env, chmod 600 .env, and fill in the key locally.
# Provider-specific variables are optional compatibility hooks. Store real
# values only in the ignored .env file or an external secret manager.
CUC_DEEPSEEK_API_KEY=

# Generic model-provider settings reserved for the future general adapter.
# Endpoints, model aliases, and credentials are intentionally blank here.
VULNLOOM_MODEL_API_KEY=
VULNLOOM_MODEL_BASE_URL=
VULNLOOM_MODEL_NAME=
