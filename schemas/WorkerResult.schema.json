{
  "$defs": {
    "TaskBudget": {
      "additionalProperties": false,
      "properties": {
        "wall_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Wall Seconds",
          "type": "integer"
        },
        "model_tokens": {
          "minimum": 0,
          "title": "Model Tokens",
          "type": "integer"
        },
        "tool_calls": {
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        }
      },
      "required": [
        "wall_seconds",
        "model_tokens",
        "tool_calls"
      ],
      "title": "TaskBudget",
      "type": "object"
    },
    "WorkerClaim": {
      "additionalProperties": false,
      "properties": {
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "statement"
      ],
      "title": "WorkerClaim",
      "type": "object"
    },
    "WorkerRole": {
      "enum": [
        "scope_interpreter",
        "source_mapper",
        "hypothesis",
        "validator",
        "critic",
        "reporter"
      ],
      "title": "WorkerRole",
      "type": "string"
    },
    "WorkerStatus": {
      "enum": [
        "completed",
        "partial",
        "blocked",
        "failed"
      ],
      "title": "WorkerStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "worker_role": {
      "$ref": "#/$defs/WorkerRole"
    },
    "status": {
      "$ref": "#/$defs/WorkerStatus"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "claims": {
      "default": [],
      "items": {
        "$ref": "#/$defs/WorkerClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "candidate_refs": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Candidate Refs",
      "type": "array"
    },
    "checkpoint_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checkpoint Ref"
    },
    "budget_used": {
      "$ref": "#/$defs/TaskBudget"
    },
    "policy_decision_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Policy Decision Refs",
      "type": "array"
    },
    "errors": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "worker_role",
    "status",
    "confidence",
    "budget_used"
  ],
  "title": "WorkerResult",
  "type": "object"
}
