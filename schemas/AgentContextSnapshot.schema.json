{
  "$defs": {
    "AgentContextFragment": {
      "additionalProperties": false,
      "properties": {
        "ordinal": {
          "maximum": 1023,
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "source_ref_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Ref Digest",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AgentContextSourceKind"
        },
        "redacted_text": {
          "title": "Redacted Text",
          "type": "string"
        },
        "text_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Text Digest",
          "type": "string"
        },
        "byte_size": {
          "maximum": 1048576,
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "untrusted": {
          "default": true,
          "title": "Untrusted",
          "type": "boolean"
        }
      },
      "required": [
        "ordinal",
        "source_ref_digest",
        "kind",
        "redacted_text",
        "text_digest",
        "byte_size"
      ],
      "title": "AgentContextFragment",
      "type": "object"
    },
    "AgentContextSourceKind": {
      "enum": [
        "task_summary",
        "evidence_summary",
        "observation_summary"
      ],
      "title": "AgentContextSourceKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "task_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Task Digest",
      "type": "string"
    },
    "target_id": {
      "format": "uuid",
      "title": "Target Id",
      "type": "string"
    },
    "target_version": {
      "minLength": 1,
      "title": "Target Version",
      "type": "string"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_version": {
      "minimum": 1,
      "title": "Scope Version",
      "type": "integer"
    },
    "input_refs_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Refs Digest",
      "type": "string"
    },
    "input_ref_digests": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Input Ref Digests",
      "type": "array"
    },
    "redaction_policy": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Redaction Policy",
      "type": "string"
    },
    "redaction_policy_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Redaction Policy Digest",
      "type": "string"
    },
    "fragments": {
      "items": {
        "$ref": "#/$defs/AgentContextFragment"
      },
      "maxItems": 1024,
      "title": "Fragments",
      "type": "array"
    },
    "total_bytes": {
      "maximum": 4194304,
      "minimum": 0,
      "title": "Total Bytes",
      "type": "integer"
    },
    "assembled_at": {
      "format": "date-time",
      "title": "Assembled At",
      "type": "string"
    }
  },
  "required": [
    "snapshot_id",
    "task_id",
    "task_digest",
    "target_id",
    "target_version",
    "scope_id",
    "scope_version",
    "input_refs_digest",
    "input_ref_digests",
    "redaction_policy",
    "redaction_policy_digest",
    "fragments",
    "total_bytes",
    "assembled_at"
  ],
  "title": "AgentContextSnapshot",
  "type": "object"
}
