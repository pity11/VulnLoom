{
  "$defs": {
    "EndpointSeed": {
      "additionalProperties": false,
      "properties": {
        "seed_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Seed Id",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "path_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Path Digest",
          "type": "string"
        }
      },
      "required": [
        "seed_id",
        "path",
        "path_digest"
      ],
      "title": "EndpointSeed",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "seed_set_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Seed Set Id",
      "type": "string"
    },
    "flow_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Flow Plan Id",
      "type": "string"
    },
    "source_checkpoint_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Checkpoint Id",
      "type": "string"
    },
    "target_id": {
      "format": "uuid",
      "title": "Target Id",
      "type": "string"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_version": {
      "minimum": 1,
      "title": "Scope Version",
      "type": "integer"
    },
    "operator_ref": {
      "pattern": "^operator:[a-zA-Z0-9._-]{1,200}$",
      "title": "Operator Ref",
      "type": "string"
    },
    "seeds": {
      "items": {
        "$ref": "#/$defs/EndpointSeed"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Seeds",
      "type": "array"
    },
    "sealed_at": {
      "format": "date-time",
      "title": "Sealed At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "seed_set_id",
    "flow_plan_id",
    "source_checkpoint_id",
    "target_id",
    "scope_id",
    "scope_version",
    "operator_ref",
    "seeds",
    "sealed_at",
    "expires_at",
    "idempotency_key"
  ],
  "title": "EndpointSeedSet",
  "type": "object"
}
