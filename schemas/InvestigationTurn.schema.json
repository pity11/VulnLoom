{
  "$defs": {
    "InvestigationObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Id",
          "type": "string"
        },
        "query_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Query Digest",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/InvestigationQueryKind"
        },
        "matched_symbols": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceSymbol"
          },
          "title": "Matched Symbols",
          "type": "array"
        },
        "matched_references": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Matched References",
          "type": "array"
        },
        "source_excerpts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceExcerpt"
          },
          "title": "Source Excerpts",
          "type": "array"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "observation_id",
        "query_digest",
        "kind"
      ],
      "title": "InvestigationObservation",
      "type": "object"
    },
    "InvestigationQueryKind": {
      "enum": [
        "symbol",
        "callers",
        "callees",
        "references",
        "source_window"
      ],
      "title": "InvestigationQueryKind",
      "type": "string"
    },
    "SourceExcerpt": {
      "additionalProperties": false,
      "properties": {
        "symbol_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Symbol Id",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "redacted_text": {
          "maxLength": 32768,
          "title": "Redacted Text",
          "type": "string"
        },
        "text_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Text Digest",
          "type": "string"
        }
      },
      "required": [
        "symbol_id",
        "path",
        "start_line",
        "end_line",
        "redacted_text",
        "text_digest"
      ],
      "title": "SourceExcerpt",
      "type": "object"
    },
    "SourceLanguage": {
      "enum": [
        "python",
        "javascript",
        "typescript"
      ],
      "title": "SourceLanguage",
      "type": "string"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        }
      },
      "required": [
        "path",
        "line"
      ],
      "title": "SourceLocation",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "reference_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reference Id",
          "type": "string"
        },
        "language": {
          "$ref": "#/$defs/SourceLanguage"
        },
        "kind": {
          "$ref": "#/$defs/SourceReferenceKind"
        },
        "source_symbol": {
          "title": "Source Symbol",
          "type": "string"
        },
        "target_name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Target Name",
          "type": "string"
        },
        "resolved_symbol_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved Symbol Id"
        },
        "location": {
          "$ref": "#/$defs/SourceLocation"
        }
      },
      "required": [
        "reference_id",
        "language",
        "kind",
        "source_symbol",
        "target_name",
        "location"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "SourceReferenceKind": {
      "enum": [
        "call",
        "import"
      ],
      "title": "SourceReferenceKind",
      "type": "string"
    },
    "SourceSymbol": {
      "additionalProperties": false,
      "properties": {
        "symbol_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Symbol Id",
          "type": "string"
        },
        "language": {
          "$ref": "#/$defs/SourceLanguage"
        },
        "qualified_name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Qualified Name",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SourceSymbolKind"
        },
        "location": {
          "$ref": "#/$defs/SourceLocation"
        }
      },
      "required": [
        "symbol_id",
        "language",
        "qualified_name",
        "kind",
        "location"
      ],
      "title": "SourceSymbol",
      "type": "object"
    },
    "SourceSymbolKind": {
      "enum": [
        "function",
        "class"
      ],
      "title": "SourceSymbolKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "index_id": {
      "title": "Index Id",
      "type": "string"
    },
    "revision": {
      "title": "Revision",
      "type": "integer"
    },
    "queries_remaining": {
      "title": "Queries Remaining",
      "type": "integer"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/InvestigationObservation"
      },
      "title": "Observations",
      "type": "array"
    }
  },
  "required": [
    "plan_id",
    "index_id",
    "revision",
    "queries_remaining",
    "observations"
  ],
  "title": "InvestigationTurn",
  "type": "object"
}
