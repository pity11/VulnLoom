{
  "$defs": {
    "CampaignCandidateCriticIntakeLimits": {
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "default": 10.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "title": "CampaignCandidateCriticIntakeLimits",
      "type": "object"
    },
    "CounterevidenceAngle": {
      "enum": [
        "security_control",
        "reachability",
        "environment_parity",
        "version_binding"
      ],
      "title": "CounterevidenceAngle",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "critic_intake_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Critic Intake Plan Id",
      "type": "string"
    },
    "validation_execution_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Execution Plan Id",
      "type": "string"
    },
    "validation_execution_plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Execution Plan Digest",
      "type": "string"
    },
    "validation_execution_outcome_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Execution Outcome Id",
      "type": "string"
    },
    "validation_execution_outcome_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Execution Outcome Digest",
      "type": "string"
    },
    "validation_checkpoint_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Checkpoint Id",
      "type": "string"
    },
    "validation_checkpoint_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Checkpoint Digest",
      "type": "string"
    },
    "candidate_id": {
      "format": "uuid",
      "title": "Candidate Id",
      "type": "string"
    },
    "candidate_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Digest",
      "type": "string"
    },
    "target_id": {
      "format": "uuid",
      "title": "Target Id",
      "type": "string"
    },
    "target_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Target Version",
      "type": "string"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_version": {
      "minimum": 1,
      "title": "Scope Version",
      "type": "integer"
    },
    "validation_run_id": {
      "format": "uuid",
      "title": "Validation Run Id",
      "type": "string"
    },
    "validation_run_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Run Digest",
      "type": "string"
    },
    "evidence_bundle_id": {
      "format": "uuid",
      "title": "Evidence Bundle Id",
      "type": "string"
    },
    "evidence_bundle_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Bundle Digest",
      "type": "string"
    },
    "fresh_fact_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 5,
      "minItems": 5,
      "title": "Fresh Fact Ids",
      "type": "array"
    },
    "validation_context_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Context Digest",
      "type": "string"
    },
    "review_context_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Context Digest",
      "type": "string"
    },
    "validation_producer_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Producer Digest",
      "type": "string"
    },
    "review_producer_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Producer Digest",
      "type": "string"
    },
    "required_counterevidence_angles": {
      "default": [
        "environment_parity",
        "reachability",
        "security_control",
        "version_binding"
      ],
      "items": {
        "$ref": "#/$defs/CounterevidenceAngle"
      },
      "title": "Required Counterevidence Angles",
      "type": "array"
    },
    "ruleset_digest": {
      "const": "89818c9526464c4df3152e49bc33d8166245ebcb3ce589302b09fbf157f09c11",
      "default": "89818c9526464c4df3152e49bc33d8166245ebcb3ce589302b09fbf157f09c11",
      "title": "Ruleset Digest",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/CampaignCandidateCriticIntakeLimits"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "human_approval_required": {
      "const": true,
      "default": true,
      "title": "Human Approval Required",
      "type": "boolean"
    },
    "validation_evidence_accepted_as_counterevidence": {
      "const": false,
      "default": false,
      "title": "Validation Evidence Accepted As Counterevidence",
      "type": "boolean"
    },
    "critic_execution_requested": {
      "const": false,
      "default": false,
      "title": "Critic Execution Requested",
      "type": "boolean"
    },
    "finding_creation_requested": {
      "const": false,
      "default": false,
      "title": "Finding Creation Requested",
      "type": "boolean"
    },
    "submission_requested": {
      "const": false,
      "default": false,
      "title": "Submission Requested",
      "type": "boolean"
    }
  },
  "required": [
    "critic_intake_plan_id",
    "validation_execution_plan_id",
    "validation_execution_plan_digest",
    "validation_execution_outcome_id",
    "validation_execution_outcome_digest",
    "validation_checkpoint_id",
    "validation_checkpoint_digest",
    "candidate_id",
    "candidate_digest",
    "target_id",
    "target_version",
    "scope_id",
    "scope_version",
    "validation_run_id",
    "validation_run_digest",
    "evidence_bundle_id",
    "evidence_bundle_digest",
    "fresh_fact_ids",
    "validation_context_digest",
    "review_context_digest",
    "validation_producer_digest",
    "review_producer_digest",
    "limits",
    "created_at",
    "deadline",
    "idempotency_key"
  ],
  "title": "CampaignCandidateCriticIntakePlan",
  "type": "object"
}
