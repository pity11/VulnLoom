{
  "$defs": {
    "ValidationResult": {
      "enum": [
        "reproduced",
        "not_reproduced",
        "inconclusive",
        "policy_stopped",
        "timed_out"
      ],
      "title": "ValidationResult",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A precommitted exact assertion over one Broker-owned HTTP response.",
  "properties": {
    "assertion_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Assertion Id",
      "type": "string"
    },
    "call_id": {
      "format": "uuid",
      "title": "Call Id",
      "type": "string"
    },
    "expected_status_code": {
      "maximum": 599,
      "minimum": 100,
      "title": "Expected Status Code",
      "type": "integer"
    },
    "expected_body_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Body Sha256",
      "type": "string"
    },
    "match_result": {
      "$ref": "#/$defs/ValidationResult"
    }
  },
  "required": [
    "assertion_id",
    "call_id",
    "expected_status_code",
    "expected_body_sha256",
    "match_result"
  ],
  "title": "HttpResponseAssertion",
  "type": "object"
}
