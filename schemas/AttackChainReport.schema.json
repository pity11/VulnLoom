{
  "$defs": {
    "AttackActionKind": {
      "enum": [
        "initial_access_attempt",
        "verify_test_session",
        "verify_objective",
        "cleanup_test_session"
      ],
      "title": "AttackActionKind",
      "type": "string"
    },
    "AttackActionOutcome": {
      "enum": [
        "succeeded",
        "rejected",
        "failed",
        "timed_out"
      ],
      "title": "AttackActionOutcome",
      "type": "string"
    },
    "AttackChainStatus": {
      "enum": [
        "planned",
        "running",
        "cleanup_required",
        "goal_reached",
        "failed",
        "timed_out",
        "killed"
      ],
      "title": "AttackChainStatus",
      "type": "string"
    },
    "AttackDefensiveControl": {
      "enum": [
        "session_issuance_policy",
        "session_activity_monitoring",
        "object_level_authorization",
        "session_revocation_assurance"
      ],
      "title": "AttackDefensiveControl",
      "type": "string"
    },
    "AttackDefensiveImprovement": {
      "additionalProperties": false,
      "properties": {
        "improvement_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Improvement Id",
          "type": "string"
        },
        "control": {
          "$ref": "#/$defs/AttackDefensiveControl"
        },
        "opportunity_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Opportunity Ids",
          "type": "array"
        }
      },
      "required": [
        "improvement_id",
        "control",
        "opportunity_ids"
      ],
      "title": "AttackDefensiveImprovement",
      "type": "object"
    },
    "AttackDetectionKind": {
      "enum": [
        "session_creation",
        "session_use",
        "protected_resource_access",
        "session_revocation"
      ],
      "title": "AttackDetectionKind",
      "type": "string"
    },
    "AttackDetectionOpportunity": {
      "additionalProperties": false,
      "properties": {
        "opportunity_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Opportunity Id",
          "type": "string"
        },
        "action_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Action Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AttackDetectionKind"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "opportunity_id",
        "action_id",
        "kind",
        "evidence_refs"
      ],
      "title": "AttackDetectionOpportunity",
      "type": "object"
    },
    "AttackImpact": {
      "enum": [
        "read_only",
        "state_change"
      ],
      "title": "AttackImpact",
      "type": "string"
    },
    "AttackPathStep": {
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Step Id",
          "type": "string"
        },
        "ordinal": {
          "maximum": 32,
          "minimum": 1,
          "title": "Ordinal",
          "type": "integer"
        },
        "action_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Action Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AttackActionKind"
        },
        "phase": {
          "$ref": "#/$defs/RedTeamPhase"
        },
        "impact": {
          "$ref": "#/$defs/AttackImpact"
        },
        "outcome": {
          "$ref": "#/$defs/AttackActionOutcome"
        },
        "observation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "step_id",
        "ordinal",
        "action_id",
        "kind",
        "phase",
        "impact",
        "outcome",
        "observation_id",
        "evidence_refs"
      ],
      "title": "AttackPathStep",
      "type": "object"
    },
    "RedTeamPhase": {
      "enum": [
        "recon",
        "initial_access",
        "validation",
        "post_exploitation"
      ],
      "title": "RedTeamPhase",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "report_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Id",
      "type": "string"
    },
    "report_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Plan Id",
      "type": "string"
    },
    "chain_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Chain Plan Id",
      "type": "string"
    },
    "graph_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Graph Id",
      "type": "string"
    },
    "source_checkpoint_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Checkpoint Id",
      "type": "string"
    },
    "target_id": {
      "format": "uuid",
      "title": "Target Id",
      "type": "string"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_version": {
      "minimum": 1,
      "title": "Scope Version",
      "type": "integer"
    },
    "chain_status": {
      "$ref": "#/$defs/AttackChainStatus"
    },
    "objective_observation_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Objective Observation Id",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/AttackPathStep"
      },
      "maxItems": 32,
      "minItems": 3,
      "title": "Steps",
      "type": "array"
    },
    "detection_opportunities": {
      "items": {
        "$ref": "#/$defs/AttackDetectionOpportunity"
      },
      "maxItems": 32,
      "minItems": 3,
      "title": "Detection Opportunities",
      "type": "array"
    },
    "defensive_improvements": {
      "items": {
        "$ref": "#/$defs/AttackDefensiveImprovement"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Defensive Improvements",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "report_plan_id",
    "chain_plan_id",
    "graph_id",
    "source_checkpoint_id",
    "target_id",
    "scope_id",
    "scope_version",
    "chain_status",
    "objective_observation_id",
    "steps",
    "detection_opportunities",
    "defensive_improvements",
    "evidence_refs",
    "generated_at"
  ],
  "title": "AttackChainReport",
  "type": "object"
}
