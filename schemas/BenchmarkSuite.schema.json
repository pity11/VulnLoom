{
  "$defs": {
    "BenchmarkCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Case Id",
          "type": "string"
        },
        "target_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        },
        "ground_truth": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GroundTruthFinding"
          },
          "title": "Ground Truth",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "target_version"
      ],
      "title": "BenchmarkCase",
      "type": "object"
    },
    "BenchmarkSource": {
      "enum": [
        "local_fixture"
      ],
      "title": "BenchmarkSource",
      "type": "string"
    },
    "GroundTruthFinding": {
      "additionalProperties": false,
      "properties": {
        "truth_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Truth Id",
          "type": "string"
        },
        "cwe": {
          "pattern": "^CWE-[1-9][0-9]*$",
          "title": "Cwe",
          "type": "string"
        },
        "duplicate_family": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Duplicate Family",
          "type": "string"
        }
      },
      "required": [
        "truth_id",
        "cwe",
        "duplicate_family"
      ],
      "title": "GroundTruthFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "suite_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Suite Id",
      "type": "string"
    },
    "name": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/BenchmarkSource",
      "default": "local_fixture"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/BenchmarkCase"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "suite_id",
    "name",
    "version",
    "cases"
  ],
  "title": "BenchmarkSuite",
  "type": "object"
}
