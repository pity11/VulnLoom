{
  "$defs": {
    "RuntimeAssuranceLevel": {
      "enum": [
        "local_docker",
        "rootless_production"
      ],
      "title": "RuntimeAssuranceLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "outcome_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Outcome Id",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "adaptive_outcome_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Adaptive Outcome Id",
      "type": "string"
    },
    "flow_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Flow Plan Id",
      "type": "string"
    },
    "coverage_ledger_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Coverage Ledger Id",
      "type": "string"
    },
    "probe_observation_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Probe Observation Ids",
      "type": "array"
    },
    "assurance_level": {
      "$ref": "#/$defs/RuntimeAssuranceLevel"
    },
    "attempt": {
      "maximum": 3,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "qualified_autonomy": {
      "const": "a3_adaptive_flow",
      "default": "a3_adaptive_flow",
      "title": "Qualified Autonomy",
      "type": "string"
    },
    "isolated_lab_qualified": {
      "const": true,
      "default": true,
      "title": "Isolated Lab Qualified",
      "type": "boolean"
    },
    "production_runner_admitted": {
      "title": "Production Runner Admitted",
      "type": "boolean"
    },
    "execution_authority_granted": {
      "const": false,
      "default": false,
      "title": "Execution Authority Granted",
      "type": "boolean"
    },
    "campaign_qualified": {
      "const": false,
      "default": false,
      "title": "Campaign Qualified",
      "type": "boolean"
    },
    "candidate_created": {
      "const": false,
      "default": false,
      "title": "Candidate Created",
      "type": "boolean"
    },
    "finding_created": {
      "const": false,
      "default": false,
      "title": "Finding Created",
      "type": "boolean"
    }
  },
  "required": [
    "outcome_id",
    "plan_id",
    "adaptive_outcome_id",
    "flow_plan_id",
    "coverage_ledger_id",
    "probe_observation_ids",
    "assurance_level",
    "attempt",
    "completed_at",
    "production_runner_admitted"
  ],
  "title": "AdaptiveRuntimeQualificationOutcome",
  "type": "object"
}
