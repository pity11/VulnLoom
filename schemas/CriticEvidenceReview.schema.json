{
  "$defs": {
    "CriticEvidenceConclusion": {
      "additionalProperties": false,
      "properties": {
        "fact": {
          "$ref": "#/$defs/EvidenceFactKind"
        },
        "verdict": {
          "$ref": "#/$defs/EvidenceFactVerdict"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "fact",
        "verdict",
        "evidence_refs"
      ],
      "title": "CriticEvidenceConclusion",
      "type": "object"
    },
    "EvidenceFactKind": {
      "enum": [
        "sealed_get_succeeded",
        "unauthenticated_request_proven",
        "sensitive_data_class_present",
        "independent_replay_matched",
        "redaction_boundary_proven",
        "access_control_enforced",
        "public_by_design",
        "synthetic_or_placeholder_data",
        "environment_or_version_mismatch",
        "no_state_change_proven",
        "no_test_artifacts_remain"
      ],
      "title": "EvidenceFactKind",
      "type": "string"
    },
    "EvidenceFactVerdict": {
      "enum": [
        "supported",
        "refuted",
        "inconclusive"
      ],
      "title": "EvidenceFactVerdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "review_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Id",
      "type": "string"
    },
    "requirement_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Requirement Id",
      "type": "string"
    },
    "target_id": {
      "format": "uuid",
      "title": "Target Id",
      "type": "string"
    },
    "target_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Target Version",
      "type": "string"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_version": {
      "minimum": 1,
      "title": "Scope Version",
      "type": "integer"
    },
    "review_context_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Context Id",
      "type": "string"
    },
    "producer_ref": {
      "const": "critic:counterevidence-review-v1",
      "default": "critic:counterevidence-review-v1",
      "title": "Producer Ref",
      "type": "string"
    },
    "conclusions": {
      "items": {
        "$ref": "#/$defs/CriticEvidenceConclusion"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Conclusions",
      "type": "array"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    }
  },
  "required": [
    "review_id",
    "requirement_id",
    "target_id",
    "target_version",
    "scope_id",
    "scope_version",
    "review_context_id",
    "conclusions",
    "reviewed_at"
  ],
  "title": "CriticEvidenceReview",
  "type": "object"
}
