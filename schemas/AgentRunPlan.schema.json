{
  "$defs": {
    "AgentRunLimits": {
      "additionalProperties": false,
      "properties": {
        "max_steps": {
          "default": 2,
          "maximum": 8,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "max_output_tokens_per_step": {
          "default": 4096,
          "exclusiveMinimum": 0,
          "maximum": 65536,
          "title": "Max Output Tokens Per Step",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "title": "AgentRunLimits",
      "type": "object"
    },
    "TaskBudget": {
      "additionalProperties": false,
      "properties": {
        "wall_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Wall Seconds",
          "type": "integer"
        },
        "model_tokens": {
          "minimum": 0,
          "title": "Model Tokens",
          "type": "integer"
        },
        "tool_calls": {
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        }
      },
      "required": [
        "wall_seconds",
        "model_tokens",
        "tool_calls"
      ],
      "title": "TaskBudget",
      "type": "object"
    },
    "TaskEnvelope": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "engagement_id": {
          "format": "uuid",
          "title": "Engagement Id",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "target_version": {
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "worker_role": {
          "$ref": "#/$defs/WorkerRole"
        },
        "scope_version": {
          "minimum": 1,
          "title": "Scope Version",
          "type": "integer"
        },
        "policy_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "sandbox_profile_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sandbox Profile Digest",
          "type": "string"
        },
        "tool_registry_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tool Registry Digest",
          "type": "string"
        },
        "input_refs": {
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "allowed_tools": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Allowed Tools",
          "type": "array",
          "uniqueItems": true
        },
        "budget": {
          "$ref": "#/$defs/TaskBudget"
        },
        "deadline": {
          "format": "date-time",
          "title": "Deadline",
          "type": "string"
        },
        "idempotency_key": {
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        }
      },
      "required": [
        "engagement_id",
        "target_id",
        "target_version",
        "scope_id",
        "worker_role",
        "scope_version",
        "policy_digest",
        "sandbox_profile_digest",
        "tool_registry_digest",
        "input_refs",
        "allowed_tools",
        "budget",
        "deadline",
        "idempotency_key"
      ],
      "title": "TaskEnvelope",
      "type": "object"
    },
    "WorkerRole": {
      "enum": [
        "scope_interpreter",
        "source_mapper",
        "hypothesis",
        "analyzer",
        "validator",
        "critic",
        "reporter"
      ],
      "title": "WorkerRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "task": {
      "$ref": "#/$defs/TaskEnvelope"
    },
    "task_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Task Digest",
      "type": "string"
    },
    "model_registration_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Registration Id",
      "type": "string"
    },
    "model_registration_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Registration Digest",
      "type": "string"
    },
    "context_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Context Digest",
      "type": "string"
    },
    "decision_schema_digest": {
      "default": "db51ba096197cc62b97b626bb6ae910b5dd223986514f5d2b29d5c3bc7ba008b",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Decision Schema Digest",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/AgentRunLimits"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "task",
    "task_digest",
    "model_registration_id",
    "model_registration_digest",
    "context_digest",
    "limits",
    "created_at",
    "deadline",
    "idempotency_key"
  ],
  "title": "AgentRunPlan",
  "type": "object"
}
