{
  "$defs": {
    "CampaignOrchestrationLimits": {
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "default": 10.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "title": "CampaignOrchestrationLimits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "orchestration_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Orchestration Plan Id",
      "type": "string"
    },
    "campaign_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Campaign Plan Id",
      "type": "string"
    },
    "campaign_plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Campaign Plan Digest",
      "type": "string"
    },
    "campaign_outcome_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Campaign Outcome Id",
      "type": "string"
    },
    "campaign_outcome_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Campaign Outcome Digest",
      "type": "string"
    },
    "runtime_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Plan Id",
      "type": "string"
    },
    "runtime_plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Plan Digest",
      "type": "string"
    },
    "runtime_outcome_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Outcome Id",
      "type": "string"
    },
    "runtime_outcome_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Outcome Digest",
      "type": "string"
    },
    "goal_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Goal Id",
      "type": "string"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_version": {
      "minimum": 1,
      "title": "Scope Version",
      "type": "integer"
    },
    "target_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Target Ids",
      "type": "array"
    },
    "target_set_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Set Digest",
      "type": "string"
    },
    "phase_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Phase Ids",
      "type": "array"
    },
    "phase_graph_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Phase Graph Digest",
      "type": "string"
    },
    "evidence_assessment_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Assessment Plan Id",
      "type": "string"
    },
    "evidence_assessment_plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Assessment Plan Digest",
      "type": "string"
    },
    "evidence_assessment_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Assessment Id",
      "type": "string"
    },
    "evidence_assessment_outcome_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Assessment Outcome Digest",
      "type": "string"
    },
    "evidence_requirement_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Requirement Id",
      "type": "string"
    },
    "evidence_target_id": {
      "format": "uuid",
      "title": "Evidence Target Id",
      "type": "string"
    },
    "evidence_target_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Evidence Target Version",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/CampaignOrchestrationLimits"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "requested_autonomy": {
      "const": "a4_goal_driven_campaign",
      "default": "a4_goal_driven_campaign",
      "title": "Requested Autonomy",
      "type": "string"
    },
    "action_execution_requested": {
      "const": false,
      "default": false,
      "title": "Action Execution Requested",
      "type": "boolean"
    },
    "dynamic_target_expansion_requested": {
      "const": false,
      "default": false,
      "title": "Dynamic Target Expansion Requested",
      "type": "boolean"
    },
    "credential_access_requested": {
      "const": false,
      "default": false,
      "title": "Credential Access Requested",
      "type": "boolean"
    },
    "submission_requested": {
      "const": false,
      "default": false,
      "title": "Submission Requested",
      "type": "boolean"
    },
    "candidate_creation_requested": {
      "const": false,
      "default": false,
      "title": "Candidate Creation Requested",
      "type": "boolean"
    },
    "finding_creation_requested": {
      "const": false,
      "default": false,
      "title": "Finding Creation Requested",
      "type": "boolean"
    }
  },
  "required": [
    "orchestration_plan_id",
    "campaign_plan_id",
    "campaign_plan_digest",
    "campaign_outcome_id",
    "campaign_outcome_digest",
    "runtime_plan_id",
    "runtime_plan_digest",
    "runtime_outcome_id",
    "runtime_outcome_digest",
    "goal_id",
    "scope_id",
    "scope_version",
    "target_ids",
    "target_set_digest",
    "phase_ids",
    "phase_graph_digest",
    "evidence_assessment_plan_id",
    "evidence_assessment_plan_digest",
    "evidence_assessment_id",
    "evidence_assessment_outcome_digest",
    "evidence_requirement_id",
    "evidence_target_id",
    "evidence_target_version",
    "limits",
    "created_at",
    "deadline",
    "idempotency_key"
  ],
  "title": "CampaignOrchestrationPlan",
  "type": "object"
}
