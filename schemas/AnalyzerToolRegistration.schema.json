{
  "$defs": {
    "AnalyzerExecutionMode": {
      "enum": [
        "source_only",
        "prebuilt_database_query_only"
      ],
      "title": "AnalyzerExecutionMode",
      "type": "string"
    },
    "AnalyzerKind": {
      "enum": [
        "codeql",
        "trivy",
        "checkov",
        "kubesec"
      ],
      "title": "AnalyzerKind",
      "type": "string"
    },
    "AnalyzerOutputMode": {
      "enum": [
        "file",
        "stdout"
      ],
      "title": "AnalyzerOutputMode",
      "type": "string"
    },
    "AnalyzerResultFile": {
      "additionalProperties": false,
      "properties": {
        "logical_name": {
          "pattern": "^(output|cwe-map)\\.json$",
          "title": "Logical Name",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "logical_name",
        "size",
        "sha256"
      ],
      "title": "AnalyzerResultFile",
      "type": "object"
    },
    "CodeQLSnapshot": {
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "target_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "tool_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Tool Version",
          "type": "string"
        },
        "database_language": {
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "title": "Database Language",
          "type": "string"
        },
        "query_pack_name": {
          "pattern": "^[a-z0-9][a-z0-9_.-]*/[a-z0-9][a-z0-9_.-]*$",
          "title": "Query Pack Name",
          "type": "string"
        },
        "query_suite_path": {
          "title": "Query Suite Path",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/CodeQLSnapshotFile"
          },
          "maxItems": 500000,
          "minItems": 3,
          "title": "Files",
          "type": "array"
        },
        "total_size": {
          "exclusiveMinimum": 0,
          "title": "Total Size",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_id",
        "target_id",
        "target_version",
        "manifest_id",
        "tool_version",
        "database_language",
        "query_pack_name",
        "query_suite_path",
        "files",
        "total_size"
      ],
      "title": "CodeQLSnapshot",
      "type": "object"
    },
    "CodeQLSnapshotFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "title": "CodeQLSnapshotFile",
      "type": "object"
    },
    "TrivyDatabaseFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "size": {
          "exclusiveMinimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "title": "TrivyDatabaseFile",
      "type": "object"
    },
    "TrivyDatabaseSnapshot": {
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "tool_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Tool Version",
          "type": "string"
        },
        "schema_version": {
          "maximum": 2,
          "minimum": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/TrivyDatabaseFile"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Files",
          "type": "array"
        },
        "total_size": {
          "exclusiveMinimum": 0,
          "title": "Total Size",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_id",
        "tool_version",
        "schema_version",
        "files",
        "total_size"
      ],
      "title": "TrivyDatabaseSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "registration_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Registration Id",
      "type": "string"
    },
    "tool_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Tool Id",
      "type": "string"
    },
    "analyzer": {
      "$ref": "#/$defs/AnalyzerKind"
    },
    "tool_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
      "title": "Tool Version",
      "type": "string"
    },
    "image_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Image Digest",
      "type": "string"
    },
    "rules_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rules Digest",
      "type": "string"
    },
    "adapter_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Adapter Id",
      "type": "string"
    },
    "adapter_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Adapter Digest",
      "type": "string"
    },
    "argv": {
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 2,
      "title": "Argv",
      "type": "array"
    },
    "input_paths": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 4096,
      "title": "Input Paths",
      "type": "array"
    },
    "environment": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Environment",
      "type": "object"
    },
    "output_mode": {
      "$ref": "#/$defs/AnalyzerOutputMode",
      "default": "file"
    },
    "output_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "/workspace/output/output.json",
      "title": "Output Path"
    },
    "cwe_map": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalyzerResultFile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "trivy_database": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrivyDatabaseSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "codeql_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodeQLSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mode": {
      "$ref": "#/$defs/AnalyzerExecutionMode",
      "default": "source_only"
    }
  },
  "required": [
    "registration_id",
    "tool_id",
    "analyzer",
    "tool_version",
    "image_digest",
    "rules_digest",
    "adapter_id",
    "adapter_digest",
    "argv"
  ],
  "title": "AnalyzerToolRegistration",
  "type": "object"
}
