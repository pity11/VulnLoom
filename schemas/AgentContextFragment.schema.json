    "ordinal": {
      "maximum": 1023,
      "minimum": 0,
      "title": "Ordinal",
      "type": "integer"
    },
    "source_ref_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Ref Digest",
      "type": "string"
    },
    "kind": {
