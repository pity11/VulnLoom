{
  "$defs": {
    "RedTeamActionKind": {
      "enum": [
        "dns_lookup",
        "tls_inspect",
        "http_head",
        "http_get"
      ],
      "title": "RedTeamActionKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "coverage_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Coverage Id",
      "type": "string"
    },
    "ordinal": {
      "maximum": 32,
      "minimum": 1,
      "title": "Ordinal",
      "type": "integer"
    },
    "execution_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Receipt Id",
      "type": "string"
    },
    "admission_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Admission Id",
      "type": "string"
    },
    "source_checkpoint_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Checkpoint Id",
      "type": "string"
    },
    "result_checkpoint_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Checkpoint Id",
      "type": "string"
    },
    "source_observation_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Observation Ids",
      "type": "array"
    },
    "produced_observation_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Produced Observation Id",
      "type": "string"
    },
    "action_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Action Id",
      "type": "string"
    },
    "action_kind": {
      "$ref": "#/$defs/RedTeamActionKind"
    },
    "test_class": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Test Class",
      "type": "string"
    },
    "outcome": {
      "const": "succeeded",
      "default": "succeeded",
      "title": "Outcome",
      "type": "string"
    },
    "exact_approval_proven": {
      "const": true,
      "default": true,
      "title": "Exact Approval Proven",
      "type": "boolean"
    },
    "cleanup_proven": {
      "const": true,
      "default": true,
      "title": "Cleanup Proven",
      "type": "boolean"
    }
  },
  "required": [
    "coverage_id",
    "ordinal",
    "execution_receipt_id",
    "admission_id",
    "source_checkpoint_id",
    "result_checkpoint_id",
    "source_observation_ids",
    "produced_observation_id",
    "action_id",
    "action_kind",
    "test_class"
  ],
  "title": "AdaptiveRoundCoverage",
  "type": "object"
}
