{
  "$defs": {
    "RuntimeAssuranceLevel": {
      "enum": [
        "local_docker",
        "rootless_production"
      ],
      "title": "RuntimeAssuranceLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "outcome_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Outcome Id",
      "type": "string"
    },
    "runtime_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Plan Id",
      "type": "string"
    },
    "campaign_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Campaign Plan Id",
      "type": "string"
    },
    "campaign_outcome_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Campaign Outcome Id",
      "type": "string"
    },
    "phase_observation_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Phase Observation Ids",
      "type": "array"
    },
    "stop_observation_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Stop Observation Ids",
      "type": "array"
    },
    "assurance_level": {
      "$ref": "#/$defs/RuntimeAssuranceLevel"
    },
    "attempt": {
      "maximum": 3,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "qualified_autonomy": {
      "const": "a4_goal_driven_campaign",
      "default": "a4_goal_driven_campaign",
      "title": "Qualified Autonomy",
      "type": "string"
    },
    "isolated_runtime_qualified": {
      "const": true,
      "default": true,
      "title": "Isolated Runtime Qualified",
      "type": "boolean"
    },
    "production_campaign_runtime_admitted": {
      "title": "Production Campaign Runtime Admitted",
      "type": "boolean"
    },
    "campaign_started": {
      "const": false,
      "default": false,
      "title": "Campaign Started",
      "type": "boolean"
    },
    "action_execution_authority_granted": {
      "const": false,
      "default": false,
      "title": "Action Execution Authority Granted",
      "type": "boolean"
    },
    "dynamic_target_expansion_granted": {
      "const": false,
      "default": false,
      "title": "Dynamic Target Expansion Granted",
      "type": "boolean"
    },
    "credential_access_granted": {
      "const": false,
      "default": false,
      "title": "Credential Access Granted",
      "type": "boolean"
    },
    "submission_granted": {
      "const": false,
      "default": false,
      "title": "Submission Granted",
      "type": "boolean"
    },
    "candidate_created": {
      "const": false,
      "default": false,
      "title": "Candidate Created",
      "type": "boolean"
    },
    "finding_created": {
      "const": false,
      "default": false,
      "title": "Finding Created",
      "type": "boolean"
    }
  },
  "required": [
    "outcome_id",
    "runtime_plan_id",
    "campaign_plan_id",
    "campaign_outcome_id",
    "phase_observation_ids",
    "stop_observation_ids",
    "assurance_level",
    "attempt",
    "completed_at",
    "production_campaign_runtime_admitted"
  ],
  "title": "CampaignRuntimeQualificationOutcome",
  "type": "object"
}
