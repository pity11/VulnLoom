{
  "$defs": {
    "HttpHeader": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "maxLength": 4096,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "HttpHeader",
      "type": "object"
    },
    "HttpLimits": {
      "additionalProperties": false,
      "properties": {
        "connect_seconds": {
          "default": 3.0,
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Connect Seconds",
          "type": "number"
        },
        "read_seconds": {
          "default": 10.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Read Seconds",
          "type": "number"
        },
        "total_seconds": {
          "default": 15.0,
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Total Seconds",
          "type": "number"
        },
        "max_response_bytes": {
          "default": 2097152,
          "exclusiveMinimum": 0,
          "maximum": 20971520,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "max_redirects": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Max Redirects",
          "type": "integer"
        },
        "max_requests": {
          "default": 1,
          "maximum": 6,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        }
      },
      "title": "HttpLimits",
      "type": "object"
    },
    "HttpMethod": {
      "enum": [
        "GET",
        "HEAD",
        "OPTIONS",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "title": "HttpMethod",
      "type": "string"
    },
    "HttpRequestPlan": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "$ref": "#/$defs/HttpMethod"
        },
        "url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "test_class": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Test Class",
          "type": "string"
        },
        "headers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HttpHeader"
          },
          "maxItems": 64,
          "title": "Headers",
          "type": "array"
        },
        "credential_ref": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Ref"
        },
        "body_ref": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body Ref"
        },
        "body_bytes": {
          "default": 0,
          "maximum": 20971520,
          "minimum": 0,
          "title": "Body Bytes",
          "type": "integer"
        },
        "follow_redirects": {
          "default": false,
          "title": "Follow Redirects",
          "type": "boolean"
        },
        "limits": {
          "$ref": "#/$defs/HttpLimits"
        }
      },
      "required": [
        "method",
        "url",
        "test_class"
      ],
      "title": "HttpRequestPlan",
      "type": "object"
    },
    "MountKind": {
      "enum": [
        "snapshot",
        "analyzer_data",
        "evidence",
        "output",
        "temp"
      ],
      "title": "MountKind",
      "type": "string"
    },
    "NetworkGrant": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "maxLength": 253,
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "ports": {
          "items": {
            "maximum": 65535,
            "minimum": 1,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Ports",
          "type": "array",
          "uniqueItems": true
        },
        "schemes": {
          "items": {
            "type": "string"
          },
          "title": "Schemes",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "host",
        "ports",
        "schemes"
      ],
      "title": "NetworkGrant",
      "type": "object"
    },
    "NetworkMode": {
      "enum": [
        "none",
        "target_only"
      ],
      "title": "NetworkMode",
      "type": "string"
    },
    "SandboxLimits": {
      "additionalProperties": false,
      "properties": {
        "wall_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Wall Seconds",
          "type": "integer"
        },
        "cpu_millis": {
          "exclusiveMinimum": 0,
          "maximum": 57600000,
          "title": "Cpu Millis",
          "type": "integer"
        },
        "memory_bytes": {
          "maximum": 17179869184,
          "minimum": 16777216,
          "title": "Memory Bytes",
          "type": "integer"
        },
        "pids": {
          "exclusiveMinimum": 0,
          "maximum": 4096,
          "title": "Pids",
          "type": "integer"
        },
        "open_files": {
          "exclusiveMinimum": 0,
          "maximum": 65536,
          "title": "Open Files",
          "type": "integer"
        },
        "file_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 10737418240,
          "title": "File Bytes",
          "type": "integer"
        },
        "tmp_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 10737418240,
          "title": "Tmp Bytes",
          "type": "integer"
        }
      },
      "required": [
        "wall_seconds",
        "cpu_millis",
        "memory_bytes",
        "pids",
        "open_files",
        "file_bytes",
        "tmp_bytes"
      ],
      "title": "SandboxLimits",
      "type": "object"
    },
    "SandboxMount": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/MountKind"
        },
        "destination": {
          "title": "Destination",
          "type": "string"
        },
        "object_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Id"
        },
        "read_only": {
          "title": "Read Only",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "destination",
        "read_only"
      ],
      "title": "SandboxMount",
      "type": "object"
    },
    "SandboxProfile": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/SandboxProfileKind"
        },
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "run_as_uid": {
          "exclusiveMinimum": 0,
          "maximum": 2147483647,
          "title": "Run As Uid",
          "type": "integer"
        },
        "run_as_gid": {
          "exclusiveMinimum": 0,
          "maximum": 2147483647,
          "title": "Run As Gid",
          "type": "integer"
        },
        "read_only_root": {
          "default": true,
          "title": "Read Only Root",
          "type": "boolean"
        },
        "no_new_privileges": {
          "default": true,
          "title": "No New Privileges",
          "type": "boolean"
        },
        "capabilities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "network_mode": {
          "$ref": "#/$defs/NetworkMode",
          "default": "none"
        },
        "network_grants": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NetworkGrant"
          },
          "title": "Network Grants",
          "type": "array"
        },
        "mounts": {
          "items": {
            "$ref": "#/$defs/SandboxMount"
          },
          "title": "Mounts",
          "type": "array"
        },
        "writable_paths": {
          "default": [
            "/tmp",
            "/workspace/output"
          ],
          "items": {
            "type": "string"
          },
          "title": "Writable Paths",
          "type": "array",
          "uniqueItems": true
        },
        "allowed_tools": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Allowed Tools",
          "type": "array",
          "uniqueItems": true
        },
        "execute_target_code": {
          "default": false,
          "title": "Execute Target Code",
          "type": "boolean"
        },
        "max_attempts": {
          "default": 2,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "limits": {
          "$ref": "#/$defs/SandboxLimits"
        }
      },
      "required": [
        "kind",
        "image_digest",
        "run_as_uid",
        "run_as_gid",
        "mounts",
        "allowed_tools",
        "limits"
      ],
      "title": "SandboxProfile",
      "type": "object"
    },
    "SandboxProfileKind": {
      "enum": [
        "static",
        "validation",
        "report"
      ],
      "title": "SandboxProfileKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "template_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Template Id",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/SandboxProfile"
    },
    "tool_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Tool Id",
      "type": "string"
    },
    "http": {
      "$ref": "#/$defs/HttpRequestPlan"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "template_id",
    "profile",
    "tool_id",
    "http",
    "idempotency_key"
  ],
  "title": "AgentSessionCallTemplate",
  "type": "object"
}
