{
  "$defs": {
    "HybridCheckKind": {
      "enum": [
        "initial",
        "remediation_retest"
      ],
      "title": "HybridCheckKind",
      "type": "string"
    },
    "HybridValidationLimits": {
      "additionalProperties": false,
      "properties": {
        "max_source_evidence_refs": {
          "default": 64,
          "maximum": 256,
          "minimum": 1,
          "title": "Max Source Evidence Refs",
          "type": "integer"
        },
        "max_http_evidence_refs": {
          "default": 64,
          "maximum": 256,
          "minimum": 1,
          "title": "Max Http Evidence Refs",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 30.0,
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "title": "HybridValidationLimits",
      "type": "object"
    },
    "ValidationResult": {
      "enum": [
        "reproduced",
        "not_reproduced",
        "inconclusive",
        "policy_stopped",
        "timed_out"
      ],
      "title": "ValidationResult",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "check_kind": {
      "$ref": "#/$defs/HybridCheckKind"
    },
    "candidate_id": {
      "format": "uuid",
      "title": "Candidate Id",
      "type": "string"
    },
    "candidate_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Digest",
      "type": "string"
    },
    "source_target_id": {
      "format": "uuid",
      "title": "Source Target Id",
      "type": "string"
    },
    "source_target_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Source Target Version",
      "type": "string"
    },
    "source_manifest_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Manifest Digest",
      "type": "string"
    },
    "live_target_id": {
      "format": "uuid",
      "title": "Live Target Id",
      "type": "string"
    },
    "endpoint_url_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Endpoint Url Digest",
      "type": "string"
    },
    "deployment_proof_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Deployment Proof Id",
      "type": "string"
    },
    "deployment_proof_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Deployment Proof Digest",
      "type": "string"
    },
    "source_validation_plan_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Validation Plan Id"
    },
    "validation_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Plan Id",
      "type": "string"
    },
    "source_evidence_refs": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Source Evidence Refs",
      "type": "array"
    },
    "expected_result": {
      "$ref": "#/$defs/ValidationResult"
    },
    "prior_chain_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prior Chain Id"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_version": {
      "minimum": 1,
      "title": "Scope Version",
      "type": "integer"
    },
    "limits": {
      "$ref": "#/$defs/HybridValidationLimits"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "check_kind",
    "candidate_id",
    "candidate_digest",
    "source_target_id",
    "source_target_version",
    "source_manifest_digest",
    "live_target_id",
    "endpoint_url_digest",
    "deployment_proof_id",
    "deployment_proof_digest",
    "validation_plan_id",
    "source_evidence_refs",
    "expected_result",
    "scope_id",
    "scope_version",
    "limits",
    "created_at",
    "deadline",
    "idempotency_key"
  ],
  "title": "HybridValidationPlan",
  "type": "object"
}
