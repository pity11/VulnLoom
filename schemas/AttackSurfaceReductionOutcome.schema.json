{
  "$defs": {
    "AttackSurfaceEndpoint": {
      "additionalProperties": false,
      "properties": {
        "endpoint_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Endpoint Id",
          "type": "string"
        },
        "requested_url_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Requested Url Digest",
          "type": "string"
        },
        "final_url_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Final Url Digest",
          "type": "string"
        },
        "peer_ip": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Peer Ip",
          "type": "string"
        },
        "status_codes": {
          "items": {
            "type": "integer"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Status Codes",
          "type": "array"
        },
        "redirect_counts": {
          "items": {
            "type": "integer"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Redirect Counts",
          "type": "array"
        },
        "observation_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Observation Ids",
          "type": "array"
        },
        "snapshot_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Snapshot Ids",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 60000,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "service_identity_ids": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Service Identity Ids",
          "type": "array"
        },
        "first_observed_at": {
          "format": "date-time",
          "title": "First Observed At",
          "type": "string"
        },
        "last_observed_at": {
          "format": "date-time",
          "title": "Last Observed At",
          "type": "string"
        }
      },
      "required": [
        "endpoint_id",
        "requested_url_digest",
        "final_url_digest",
        "peer_ip",
        "status_codes",
        "redirect_counts",
        "observation_ids",
        "snapshot_ids",
        "evidence_refs",
        "first_observed_at",
        "last_observed_at"
      ],
      "title": "AttackSurfaceEndpoint",
      "type": "object"
    },
    "AttackSurfaceInventory": {
      "additionalProperties": false,
      "properties": {
        "inventory_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Inventory Id",
          "type": "string"
        },
        "reduction_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reduction Id",
          "type": "string"
        },
        "flow_plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Flow Plan Id",
          "type": "string"
        },
        "source_checkpoint_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Checkpoint Id",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "scope_version": {
          "minimum": 1,
          "title": "Scope Version",
          "type": "integer"
        },
        "observation_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Observation Ids",
          "type": "array"
        },
        "snapshot_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Snapshot Ids",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 60000,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "endpoints": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AttackSurfaceEndpoint"
          },
          "maxItems": 10000,
          "title": "Endpoints",
          "type": "array"
        },
        "service_identities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AttackSurfaceServiceIdentity"
          },
          "maxItems": 10000,
          "title": "Service Identities",
          "type": "array"
        },
        "reduced_at": {
          "format": "date-time",
          "title": "Reduced At",
          "type": "string"
        }
      },
      "required": [
        "inventory_id",
        "reduction_id",
        "flow_plan_id",
        "source_checkpoint_id",
        "target_id",
        "scope_id",
        "scope_version",
        "observation_ids",
        "snapshot_ids",
        "evidence_refs",
        "reduced_at"
      ],
      "title": "AttackSurfaceInventory",
      "type": "object"
    },
    "AttackSurfaceServiceIdentity": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Id",
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/ServiceIdentitySnapshot"
        }
      },
      "required": [
        "observation_id",
        "identity"
      ],
      "title": "AttackSurfaceServiceIdentity",
      "type": "object"
    },
    "ServiceIdentitySnapshot": {
      "additionalProperties": false,
      "description": "Redacted identity facts from one CA- and hostname-verified TLS session.",
      "properties": {
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Id",
          "type": "string"
        },
        "action_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Action Id",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "scope_version": {
          "minimum": 1,
          "title": "Scope Version",
          "type": "integer"
        },
        "endpoint_url_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Endpoint Url Digest",
          "type": "string"
        },
        "peer_ip": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Peer Ip",
          "type": "string"
        },
        "tls_version": {
          "$ref": "#/$defs/ServiceTlsVersion"
        },
        "cipher_suite": {
          "pattern": "^[A-Z0-9_-]{1,128}$",
          "title": "Cipher Suite",
          "type": "string"
        },
        "cipher_bits": {
          "maximum": 1024,
          "minimum": 112,
          "title": "Cipher Bits",
          "type": "integer"
        },
        "leaf_certificate_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Leaf Certificate Sha256",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "policy_record_digests": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Policy Record Digests",
          "type": "array"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "plan_id",
        "action_id",
        "target_id",
        "scope_id",
        "scope_version",
        "endpoint_url_digest",
        "peer_ip",
        "tls_version",
        "cipher_suite",
        "cipher_bits",
        "leaf_certificate_sha256",
        "evidence_refs",
        "policy_record_digests",
        "captured_at"
      ],
      "title": "ServiceIdentitySnapshot",
      "type": "object"
    },
    "ServiceTlsVersion": {
      "enum": [
        "TLSv1.2",
        "TLSv1.3"
      ],
      "title": "ServiceTlsVersion",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "reduction_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reduction Id",
      "type": "string"
    },
    "inventory": {
      "$ref": "#/$defs/AttackSurfaceInventory"
    },
    "attempt": {
      "maximum": 3,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "cleanup_complete": {
      "default": true,
      "title": "Cleanup Complete",
      "type": "boolean"
    }
  },
  "required": [
    "reduction_id",
    "inventory",
    "attempt"
  ],
  "title": "AttackSurfaceReductionOutcome",
  "type": "object"
}
