{
  "$defs": {
    "AgentWorkflowRegressionPolicy": {
      "additionalProperties": false,
      "properties": {
        "required_stages": {
          "default": [
            "session_audit",
            "validation_intake",
            "validation_outcome",
            "critic_intake",
            "critic_outcome",
            "finding_intake",
            "finding_promotion",
            "report_intake",
            "report_draft",
            "report_review_intake",
            "report_review",
            "report_export_intake",
            "report_export"
          ],
          "items": {
            "$ref": "#/$defs/AgentWorkflowStage"
          },
          "title": "Required Stages",
          "type": "array"
        },
        "required_human_decisions": {
          "default": 6,
          "maximum": 32,
          "minimum": 0,
          "title": "Required Human Decisions",
          "type": "integer"
        },
        "required_approvals": {
          "default": 3,
          "maximum": 32,
          "minimum": 0,
          "title": "Required Approvals",
          "type": "integer"
        },
        "min_evidence_refs": {
          "default": 1,
          "maximum": 256,
          "minimum": 0,
          "title": "Min Evidence Refs",
          "type": "integer"
        },
        "max_control_plane_provider_delta": {
          "default": 0,
          "minimum": 0,
          "title": "Max Control Plane Provider Delta",
          "type": "integer"
        },
        "max_control_plane_broker_delta": {
          "default": 0,
          "minimum": 0,
          "title": "Max Control Plane Broker Delta",
          "type": "integer"
        },
        "max_control_plane_runner_delta": {
          "default": 0,
          "minimum": 0,
          "title": "Max Control Plane Runner Delta",
          "type": "integer"
        },
        "max_control_plane_target_delta": {
          "default": 0,
          "minimum": 0,
          "title": "Max Control Plane Target Delta",
          "type": "integer"
        },
        "max_public_network_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Max Public Network Calls",
          "type": "integer"
        },
        "max_target_builds": {
          "default": 0,
          "minimum": 0,
          "title": "Max Target Builds",
          "type": "integer"
        },
        "max_automatic_approvals": {
          "default": 0,
          "minimum": 0,
          "title": "Max Automatic Approvals",
          "type": "integer"
        },
        "max_submission_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Max Submission Calls",
          "type": "integer"
        }
      },
      "title": "AgentWorkflowRegressionPolicy",
      "type": "object"
    },
    "AgentWorkflowStage": {
      "enum": [
        "session_audit",
        "validation_intake",
        "validation_outcome",
        "critic_intake",
        "critic_outcome",
        "finding_intake",
        "finding_promotion",
        "report_intake",
        "report_draft",
        "report_review_intake",
        "report_review",
        "report_export_intake",
        "report_export"
      ],
      "title": "AgentWorkflowStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "observation_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Observation Id",
      "type": "string"
    },
    "observation_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Observation Digest",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/AgentWorkflowRegressionPolicy"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "observation_id",
    "observation_digest",
    "policy",
    "created_at",
    "deadline",
    "idempotency_key"
  ],
  "title": "AgentWorkflowRegressionPlan",
  "type": "object"
}
