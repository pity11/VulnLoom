{
  "$defs": {
    "AdaptiveQualificationLimits": {
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "default": 10.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "minimum_replan_rounds": {
          "const": 2,
          "default": 2,
          "title": "Minimum Replan Rounds",
          "type": "integer"
        },
        "maximum_replan_rounds": {
          "default": 16,
          "maximum": 32,
          "minimum": 2,
          "title": "Maximum Replan Rounds",
          "type": "integer"
        }
      },
      "title": "AdaptiveQualificationLimits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "flow_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Flow Plan Id",
      "type": "string"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_version": {
      "minimum": 1,
      "title": "Scope Version",
      "type": "integer"
    },
    "target_id": {
      "format": "uuid",
      "title": "Target Id",
      "type": "string"
    },
    "target_url_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Url Digest",
      "type": "string"
    },
    "final_checkpoint_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Final Checkpoint Id",
      "type": "string"
    },
    "replan_execution_receipt_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 2,
      "title": "Replan Execution Receipt Ids",
      "type": "array"
    },
    "limits": {
      "$ref": "#/$defs/AdaptiveQualificationLimits"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "requested_autonomy": {
      "const": "a3_adaptive_flow",
      "default": "a3_adaptive_flow",
      "title": "Requested Autonomy",
      "type": "string"
    },
    "campaign_qualification_requested": {
      "const": false,
      "default": false,
      "title": "Campaign Qualification Requested",
      "type": "boolean"
    },
    "execution_authority_requested": {
      "const": false,
      "default": false,
      "title": "Execution Authority Requested",
      "type": "boolean"
    }
  },
  "required": [
    "plan_id",
    "flow_plan_id",
    "scope_id",
    "scope_version",
    "target_id",
    "target_url_digest",
    "final_checkpoint_id",
    "replan_execution_receipt_ids",
    "limits",
    "created_at",
    "deadline",
    "idempotency_key"
  ],
  "title": "AdaptiveFlowQualificationPlan",
  "type": "object"
}
