{
  "$defs": {
    "HybridReleaseDecision": {
      "enum": [
        "passed",
        "blocked"
      ],
      "title": "HybridReleaseDecision",
      "type": "string"
    },
    "HybridReleaseGateResult": {
      "additionalProperties": false,
      "properties": {
        "result_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Id",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Id",
          "type": "string"
        },
        "hybrid_chain_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hybrid Chain Id",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/HybridReleaseDecision"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "source_remediation_proof_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Remediation Proof Id"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        }
      },
      "required": [
        "result_id",
        "plan_id",
        "hybrid_chain_id",
        "decision",
        "reason_codes",
        "evaluated_at"
      ],
      "title": "HybridReleaseGateResult",
      "type": "object"
    },
    "HybridReleaseGateState": {
      "enum": [
        "started",
        "completed",
        "timed_out",
        "failed"
      ],
      "title": "HybridReleaseGateState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/HybridReleaseGateState"
    },
    "attempt": {
      "maximum": 3,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/HybridReleaseGateResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason_code": {
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Reason Code",
      "type": "string"
    },
    "cleanup_complete": {
      "title": "Cleanup Complete",
      "type": "boolean"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "state",
    "attempt",
    "reason_code",
    "cleanup_complete",
    "completed_at"
  ],
  "title": "HybridReleaseGateOutcome",
  "type": "object"
}
