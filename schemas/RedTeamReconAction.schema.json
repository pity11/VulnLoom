{
  "$defs": {
    "ImpactClass": {
      "enum": [
        "read_only",
        "state_change",
        "real_credential",
        "external_callback",
        "lateral_movement",
        "persistence"
      ],
      "title": "ImpactClass",
      "type": "string"
    },
    "RedTeamActionKind": {
      "enum": [
        "dns_lookup",
        "tls_inspect",
        "http_head"
      ],
      "title": "RedTeamActionKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Action Id",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "expected_checkpoint_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Checkpoint Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/RedTeamActionKind"
    },
    "target_url": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Target Url",
      "type": "string"
    },
    "test_class": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Test Class",
      "type": "string"
    },
    "impact": {
      "$ref": "#/$defs/ImpactClass",
      "default": "read_only"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "action_id",
    "plan_id",
    "expected_checkpoint_id",
    "kind",
    "target_url",
    "test_class",
    "created_at",
    "deadline",
    "idempotency_key"
  ],
  "title": "RedTeamReconAction",
  "type": "object"
}
