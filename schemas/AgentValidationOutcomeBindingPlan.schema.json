{
  "$defs": {
    "ValidationResult": {
      "enum": [
        "reproduced",
        "not_reproduced",
        "inconclusive",
        "policy_stopped",
        "timed_out"
      ],
      "title": "ValidationResult",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "binding_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Binding Plan Id",
      "type": "string"
    },
    "intake_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Intake Plan Id",
      "type": "string"
    },
    "intake_record_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Intake Record Id",
      "type": "string"
    },
    "intake_record_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Intake Record Digest",
      "type": "string"
    },
    "audit_bundle_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Audit Bundle Id",
      "type": "string"
    },
    "candidate_set_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Set Id",
      "type": "string"
    },
    "candidate_set_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Set Digest",
      "type": "string"
    },
    "candidate_id": {
      "format": "uuid",
      "title": "Candidate Id",
      "type": "string"
    },
    "candidate_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Digest",
      "type": "string"
    },
    "target_id": {
      "format": "uuid",
      "title": "Target Id",
      "type": "string"
    },
    "target_version_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Version Digest",
      "type": "string"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_version": {
      "minimum": 1,
      "title": "Scope Version",
      "type": "integer"
    },
    "validation_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Plan Id",
      "type": "string"
    },
    "validation_plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Plan Digest",
      "type": "string"
    },
    "validation_outcome_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Outcome Digest",
      "type": "string"
    },
    "validation_run_id": {
      "format": "uuid",
      "title": "Validation Run Id",
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/ValidationResult"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Evidence Refs",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "binding_plan_id",
    "intake_plan_id",
    "intake_record_id",
    "intake_record_digest",
    "audit_bundle_id",
    "candidate_set_id",
    "candidate_set_digest",
    "candidate_id",
    "candidate_digest",
    "target_id",
    "target_version_digest",
    "scope_id",
    "scope_version",
    "validation_plan_id",
    "validation_plan_digest",
    "validation_outcome_digest",
    "validation_run_id",
    "result",
    "created_at",
    "deadline",
    "idempotency_key"
  ],
  "title": "AgentValidationOutcomeBindingPlan",
  "type": "object"
}
