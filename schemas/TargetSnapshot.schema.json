{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "engagement_id": {
          "format": "uuid",
          "title": "Engagement Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "source_name": {
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "original_size": {
          "minimum": 0,
          "title": "Original Size",
          "type": "integer"
        },
        "detected_format": {
          "minLength": 1,
          "title": "Detected Format",
          "type": "string"
        },
        "quarantine_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quarantine Ref"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "engagement_id",
        "kind",
        "source_name",
        "source_ref",
        "original_size",
        "detected_format"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "ArtifactKind": {
      "enum": [
        "source_archive",
        "iac_bundle",
        "git_repository",
        "oci_image"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "SnapshotFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/StaticFileCategory"
        }
      },
      "required": [
        "path",
        "size",
        "sha256",
        "category"
      ],
      "title": "SnapshotFile",
      "type": "object"
    },
    "StaticFileCategory": {
      "enum": [
        "source",
        "kubernetes",
        "helm",
        "terraform",
        "dockerfile",
        "compose",
        "config",
        "documentation",
        "other"
      ],
      "title": "StaticFileCategory",
      "type": "string"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "engagement_id": {
          "format": "uuid",
          "title": "Engagement Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TargetKind"
        },
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "ingested_at": {
          "format": "date-time",
          "title": "Ingested At",
          "type": "string"
        }
      },
      "required": [
        "engagement_id",
        "kind",
        "source_ref",
        "version"
      ],
      "title": "Target",
      "type": "object"
    },
    "TargetKind": {
      "enum": [
        "repository",
        "container_image",
        "test_service",
        "iac_bundle"
      ],
      "title": "TargetKind",
      "type": "string"
    },
    "TargetManifest": {
      "additionalProperties": false,
      "properties": {
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "target_version": {
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/SnapshotFile"
          },
          "title": "Files",
          "type": "array"
        },
        "total_size": {
          "minimum": 0,
          "title": "Total Size",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "manifest_id",
        "artifact_id",
        "target_id",
        "target_version",
        "files",
        "total_size"
      ],
      "title": "TargetManifest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "target": {
      "$ref": "#/$defs/Target"
    },
    "artifact": {
      "$ref": "#/$defs/Artifact"
    },
    "manifest": {
      "$ref": "#/$defs/TargetManifest"
    },
    "root_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Root Ref"
    }
  },
  "required": [
    "target",
    "artifact",
    "manifest"
  ],
  "title": "TargetSnapshot",
  "type": "object"
}
