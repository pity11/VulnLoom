{
  "$defs": {
    "AgentCleanupReport": {
      "additionalProperties": false,
      "properties": {
        "model_request_released": {
          "title": "Model Request Released",
          "type": "boolean"
        },
        "raw_response_discarded": {
          "title": "Raw Response Discarded",
          "type": "boolean"
        },
        "no_tool_executed": {
          "title": "No Tool Executed",
          "type": "boolean"
        }
      },
      "required": [
        "model_request_released",
        "raw_response_discarded",
        "no_tool_executed"
      ],
      "title": "AgentCleanupReport",
      "type": "object"
    },
    "AgentContinuationCleanup": {
      "additionalProperties": false,
      "properties": {
        "evidence_buffers_released": {
          "title": "Evidence Buffers Released",
          "type": "boolean"
        },
        "context_reverified": {
          "title": "Context Reverified",
          "type": "boolean"
        },
        "raw_provider_response_absent": {
          "title": "Raw Provider Response Absent",
          "type": "boolean"
        },
        "no_tool_executed": {
          "title": "No Tool Executed",
          "type": "boolean"
        },
        "no_vulnloom_domain_state_changed": {
          "title": "No Vulnloom Domain State Changed",
          "type": "boolean"
        }
      },
      "required": [
        "evidence_buffers_released",
        "context_reverified",
        "raw_provider_response_absent",
        "no_tool_executed",
        "no_vulnloom_domain_state_changed"
      ],
      "title": "AgentContinuationCleanup",
      "type": "object"
    },
    "AgentContinuationOutcome": {
      "additionalProperties": false,
      "properties": {
        "outcome_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Outcome Id",
          "type": "string"
        },
        "continuation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Continuation Id",
          "type": "string"
        },
        "root_plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Root Plan Id",
          "type": "string"
        },
        "observation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Id",
          "type": "string"
        },
        "continuation_plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Continuation Plan Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AgentContinuationStatus"
        },
        "agent_outcome": {
          "$ref": "#/$defs/AgentRunOutcome"
        },
        "cleanup": {
          "$ref": "#/$defs/AgentContinuationCleanup"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        }
      },
      "required": [
        "outcome_id",
        "continuation_id",
        "root_plan_id",
        "observation_id",
        "continuation_plan_id",
        "status",
        "agent_outcome",
        "cleanup",
        "completed_at"
      ],
      "title": "AgentContinuationOutcome",
      "type": "object"
    },
    "AgentContinuationStatus": {
      "enum": [
        "completed",
        "blocked",
        "failed",
        "timed_out"
      ],
      "title": "AgentContinuationStatus",
      "type": "string"
    },
    "AgentRunOutcome": {
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Id",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "model_registration_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Registration Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AgentRunStatus"
        },
        "steps": {
          "maximum": 8,
          "minimum": 1,
          "title": "Steps",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "tool_intent": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentToolIntent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "summary_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary Digest"
        },
        "supporting_ref_digests": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Supporting Ref Digests",
          "type": "array"
        },
        "error_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Error Codes",
          "type": "array"
        },
        "cleanup": {
          "$ref": "#/$defs/AgentCleanupReport"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "task_id",
        "model_registration_id",
        "status",
        "steps",
        "input_tokens",
        "output_tokens",
        "cleanup",
        "completed_at"
      ],
      "title": "AgentRunOutcome",
      "type": "object"
    },
    "AgentRunStatus": {
      "enum": [
        "tool_proposed",
        "completed",
        "blocked",
        "failed",
        "timed_out"
      ],
      "title": "AgentRunStatus",
      "type": "string"
    },
    "AgentSessionBudgetLedger": {
      "additionalProperties": false,
      "properties": {
        "original_model_tokens": {
          "exclusiveMinimum": 0,
          "title": "Original Model Tokens",
          "type": "integer"
        },
        "original_tool_calls": {
          "maximum": 2,
          "minimum": 2,
          "title": "Original Tool Calls",
          "type": "integer"
        },
        "consumed_model_tokens": {
          "minimum": 0,
          "title": "Consumed Model Tokens",
          "type": "integer"
        },
        "remaining_model_tokens": {
          "minimum": 0,
          "title": "Remaining Model Tokens",
          "type": "integer"
        },
        "consumed_agent_steps": {
          "maximum": 24,
          "minimum": 1,
          "title": "Consumed Agent Steps",
          "type": "integer"
        },
        "consumed_tool_calls": {
          "maximum": 2,
          "minimum": 1,
          "title": "Consumed Tool Calls",
          "type": "integer"
        },
        "remaining_tool_calls": {
          "minimum": 0,
          "title": "Remaining Tool Calls",
          "type": "integer"
        },
        "provider_attempts": {
          "maximum": 3,
          "minimum": 1,
          "title": "Provider Attempts",
          "type": "integer"
        },
        "broker_attempts": {
          "maximum": 3,
          "minimum": 1,
          "title": "Broker Attempts",
          "type": "integer"
        },
        "remaining_wall_seconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Remaining Wall Seconds",
          "type": "integer"
        }
      },
      "required": [
        "original_model_tokens",
        "original_tool_calls",
        "consumed_model_tokens",
        "remaining_model_tokens",
        "consumed_agent_steps",
        "consumed_tool_calls",
        "remaining_tool_calls",
        "provider_attempts",
        "broker_attempts",
        "remaining_wall_seconds"
      ],
      "title": "AgentSessionBudgetLedger",
      "type": "object"
    },
    "AgentSessionCleanup": {
      "additionalProperties": false,
      "properties": {
        "evidence_buffers_released": {
          "title": "Evidence Buffers Released",
          "type": "boolean"
        },
        "context_reverified": {
          "title": "Context Reverified",
          "type": "boolean"
        },
        "raw_provider_responses_absent": {
          "title": "Raw Provider Responses Absent",
          "type": "boolean"
        },
        "broker_authorization_enforced": {
          "title": "Broker Authorization Enforced",
          "type": "boolean"
        },
        "no_vulnloom_domain_state_changed": {
          "title": "No Vulnloom Domain State Changed",
          "type": "boolean"
        }
      },
      "required": [
        "evidence_buffers_released",
        "context_reverified",
        "raw_provider_responses_absent",
        "broker_authorization_enforced",
        "no_vulnloom_domain_state_changed"
      ],
      "title": "AgentSessionCleanup",
      "type": "object"
    },
    "AgentSessionStatus": {
      "enum": [
        "completed",
        "blocked",
        "denied",
        "approval_required",
        "failed",
        "timed_out"
      ],
      "title": "AgentSessionStatus",
      "type": "string"
    },
    "AgentToolHandoffCleanup": {
      "additionalProperties": false,
      "properties": {
        "raw_agent_arguments_absent": {
          "title": "Raw Agent Arguments Absent",
          "type": "boolean"
        },
        "raw_tool_response_absent": {
          "title": "Raw Tool Response Absent",
          "type": "boolean"
        },
        "authorization_enforced": {
          "title": "Authorization Enforced",
          "type": "boolean"
        },
        "no_vulnloom_domain_state_changed": {
          "title": "No Vulnloom Domain State Changed",
          "type": "boolean"
        }
      },
      "required": [
        "raw_agent_arguments_absent",
        "raw_tool_response_absent",
        "authorization_enforced",
        "no_vulnloom_domain_state_changed"
      ],
      "title": "AgentToolHandoffCleanup",
      "type": "object"
    },
    "AgentToolHandoffOutcome": {
      "additionalProperties": false,
      "properties": {
        "outcome_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Outcome Id",
          "type": "string"
        },
        "handoff_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Handoff Id",
          "type": "string"
        },
        "agent_plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Agent Plan Id",
          "type": "string"
        },
        "agent_outcome_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Agent Outcome Digest",
          "type": "string"
        },
        "broker_call_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Broker Call Digest",
          "type": "string"
        },
        "attempt": {
          "maximum": 2,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/AgentToolHandoffStatus"
        },
        "broker_result": {
          "$ref": "#/$defs/BrokerResult"
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentToolObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cleanup": {
          "$ref": "#/$defs/AgentToolHandoffCleanup"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        }
      },
      "required": [
        "outcome_id",
        "handoff_id",
        "agent_plan_id",
        "agent_outcome_digest",
        "broker_call_digest",
        "attempt",
        "status",
        "broker_result",
        "cleanup",
        "completed_at"
      ],
      "title": "AgentToolHandoffOutcome",
      "type": "object"
    },
    "AgentToolHandoffStatus": {
      "enum": [
        "completed",
        "denied",
        "approval_required",
        "timed_out",
        "failed"
      ],
      "title": "AgentToolHandoffStatus",
      "type": "string"
    },
    "AgentToolIntent": {
      "additionalProperties": false,
      "properties": {
        "tool_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Tool Id",
          "type": "string"
        },
        "invocation_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Invocation Digest",
          "type": "string"
        },
        "argument_digests": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Argument Digests",
          "type": "array"
        },
        "working_directory": {
          "$ref": "#/$defs/WorkingDirectory"
        }
      },
      "required": [
        "tool_id",
        "invocation_digest",
        "argument_digests",
        "working_directory"
      ],
      "title": "AgentToolIntent",
      "type": "object"
    },
    "AgentToolObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Id",
          "type": "string"
        },
        "handoff_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Handoff Id",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "target_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "scope_version": {
          "minimum": 1,
          "title": "Scope Version",
          "type": "integer"
        },
        "tool_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Tool Id",
          "type": "string"
        },
        "broker_result_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Broker Result Digest",
          "type": "string"
        },
        "status_code": {
          "maximum": 599,
          "minimum": 100,
          "title": "Status Code",
          "type": "integer"
        },
        "final_url_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Final Url Digest",
          "type": "string"
        },
        "response_bytes": {
          "maximum": 20971520,
          "minimum": 0,
          "title": "Response Bytes",
          "type": "integer"
        },
        "response_body_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Body Sha256",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "handoff_id",
        "task_id",
        "target_id",
        "target_version",
        "scope_id",
        "scope_version",
        "tool_id",
        "broker_result_digest",
        "status_code",
        "final_url_digest",
        "response_bytes",
        "response_body_sha256",
        "evidence_refs",
        "observed_at"
      ],
      "title": "AgentToolObservation",
      "type": "object"
    },
    "BrokerResult": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "format": "uuid",
          "title": "Call Id",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "tool_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Tool Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/BrokerStatus"
        },
        "registry_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Registry Digest",
          "type": "string"
        },
        "call_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Call Digest",
          "type": "string"
        },
        "tool_calls_used": {
          "minimum": 0,
          "title": "Tool Calls Used",
          "type": "integer"
        },
        "policy_records": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PolicyRecord"
          },
          "title": "Policy Records",
          "type": "array"
        },
        "http": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpToolResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Error Codes",
          "type": "array"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "task_id",
        "tool_id",
        "status",
        "registry_digest",
        "call_digest",
        "tool_calls_used",
        "completed_at"
      ],
      "title": "BrokerResult",
      "type": "object"
    },
    "BrokerStatus": {
      "enum": [
        "completed",
        "denied",
        "approval_required",
        "timed_out",
        "failed"
      ],
      "title": "BrokerStatus",
      "type": "string"
    },
    "DecisionEffect": {
      "enum": [
        "allow",
        "deny",
        "approval_required"
      ],
      "title": "DecisionEffect",
      "type": "string"
    },
    "HttpToolResult": {
      "additionalProperties": false,
      "properties": {
        "status_code": {
          "maximum": 599,
          "minimum": 100,
          "title": "Status Code",
          "type": "integer"
        },
        "final_url_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Final Url Digest",
          "type": "string"
        },
        "peer_ip": {
          "minLength": 1,
          "title": "Peer Ip",
          "type": "string"
        },
        "response_bytes": {
          "minimum": 0,
          "title": "Response Bytes",
          "type": "integer"
        },
        "response_body_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Body Sha256",
          "type": "string"
        },
        "redirects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RedirectRecord"
          },
          "title": "Redirects",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "status_code",
        "final_url_digest",
        "peer_ip",
        "response_bytes",
        "response_body_sha256",
        "evidence_refs"
      ],
      "title": "HttpToolResult",
      "type": "object"
    },
    "PolicyRecord": {
      "additionalProperties": false,
      "properties": {
        "action_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Action Digest",
          "type": "string"
        },
        "effect": {
          "$ref": "#/$defs/DecisionEffect"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "obligations": {
          "items": {
            "type": "string"
          },
          "title": "Obligations",
          "type": "array"
        },
        "policy_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        }
      },
      "required": [
        "action_digest",
        "effect",
        "reasons",
        "obligations",
        "policy_digest"
      ],
      "title": "PolicyRecord",
      "type": "object"
    },
    "RedirectRecord": {
      "additionalProperties": false,
      "properties": {
        "status_code": {
          "maximum": 399,
          "minimum": 300,
          "title": "Status Code",
          "type": "integer"
        },
        "from_url_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "From Url Digest",
          "type": "string"
        },
        "to_url_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "To Url Digest",
          "type": "string"
        },
        "peer_ip": {
          "minLength": 1,
          "title": "Peer Ip",
          "type": "string"
        }
      },
      "required": [
        "status_code",
        "from_url_digest",
        "to_url_digest",
        "peer_ip"
      ],
      "title": "RedirectRecord",
      "type": "object"
    },
    "WorkingDirectory": {
      "enum": [
        "source",
        "output",
        "temp"
      ],
      "title": "WorkingDirectory",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "outcome_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Outcome Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Session Id",
      "type": "string"
    },
    "root_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Root Plan Id",
      "type": "string"
    },
    "first_observation_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "First Observation Id",
      "type": "string"
    },
    "round_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Round Plan Id",
      "type": "string"
    },
    "authorized_call_set_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Authorized Call Set Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AgentSessionStatus"
    },
    "round_agent_outcome": {
      "$ref": "#/$defs/AgentRunOutcome"
    },
    "selected_call_commitment": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Call Commitment"
    },
    "selected_broker_call_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Broker Call Digest"
    },
    "approval_handoff_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentToolHandoffOutcome"
        },
        {
          "type": "null"
