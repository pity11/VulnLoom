{
  "$defs": {
    "CredentialLeaseReceipt": {
      "additionalProperties": false,
      "properties": {
        "lease_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Lease Id",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Id",
          "type": "string"
        },
        "credential_ref": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Credential Ref",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "released": {
          "const": true,
          "default": true,
          "title": "Released",
          "type": "boolean"
        },
        "zeroed": {
          "const": true,
          "default": true,
          "title": "Zeroed",
          "type": "boolean"
        },
        "secret_material_persisted": {
          "const": false,
          "default": false,
          "title": "Secret Material Persisted",
          "type": "boolean"
        }
      },
      "required": [
        "lease_id",
        "plan_id",
        "credential_ref",
        "issued_at",
        "expires_at"
      ],
      "title": "CredentialLeaseReceipt",
      "type": "object"
    },
    "IsolatedSessionReceipt": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Session Id",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Id",
          "type": "string"
        },
        "lease_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Lease Id",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "identity_ref": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Identity Ref",
          "type": "string"
        },
        "role_ref": {
          "pattern": "^role:[a-zA-Z0-9._-]{1,200}$",
          "title": "Role Ref",
          "type": "string"
        },
        "opened_at": {
          "format": "date-time",
          "title": "Opened At",
          "type": "string"
        },
        "closed_at": {
          "format": "date-time",
          "title": "Closed At",
          "type": "string"
        },
        "max_uses": {
          "const": 1,
          "default": 1,
          "title": "Max Uses",
          "type": "integer"
        },
        "uses": {
          "const": 1,
          "default": 1,
          "title": "Uses",
          "type": "integer"
        },
        "isolated": {
          "const": true,
          "default": true,
          "title": "Isolated",
          "type": "boolean"
        },
        "released": {
          "const": true,
          "default": true,
          "title": "Released",
          "type": "boolean"
        },
        "zeroed": {
          "const": true,
          "default": true,
          "title": "Zeroed",
          "type": "boolean"
        },
        "network_performed": {
          "const": false,
          "default": false,
          "title": "Network Performed",
          "type": "boolean"
        },
        "authentication_performed": {
          "default": false,
          "title": "Authentication Performed",
          "type": "boolean"
        },
        "state_changed": {
          "default": false,
          "title": "State Changed",
          "type": "boolean"
        },
        "state_restored": {
          "const": true,
          "default": true,
          "title": "State Restored",
          "type": "boolean"
        }
      },
      "required": [
        "session_id",
        "plan_id",
        "lease_id",
        "target_id",
        "identity_ref",
        "role_ref",
        "opened_at",
        "closed_at"
      ],
      "title": "IsolatedSessionReceipt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "outcome_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Outcome Id",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "attempt": {
      "maximum": 3,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "approval_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Approval Ids",
      "type": "array"
    },
    "lease": {
      "$ref": "#/$defs/CredentialLeaseReceipt"
    },
    "session": {
      "$ref": "#/$defs/IsolatedSessionReceipt"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "cleanup_complete": {
      "const": true,
      "default": true,
      "title": "Cleanup Complete",
      "type": "boolean"
    },
    "secret_material_persisted": {
      "const": false,
      "default": false,
      "title": "Secret Material Persisted",
      "type": "boolean"
    }
  },
  "required": [
    "outcome_id",
    "plan_id",
    "attempt",
    "approval_ids",
    "lease",
    "session",
    "completed_at"
  ],
  "title": "CredentialSessionOutcome",
  "type": "object"
}
