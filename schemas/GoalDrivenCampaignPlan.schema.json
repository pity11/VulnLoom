{
  "$defs": {
    "CampaignBudget": {
      "additionalProperties": false,
      "properties": {
        "max_flow_materializations": {
          "maximum": 64,
          "minimum": 6,
          "title": "Max Flow Materializations",
          "type": "integer"
        },
        "max_actions": {
          "maximum": 512,
          "minimum": 6,
          "title": "Max Actions",
          "type": "integer"
        },
        "wall_seconds": {
          "maximum": 86400,
          "minimum": 60,
          "title": "Wall Seconds",
          "type": "integer"
        },
        "max_consecutive_failures": {
          "maximum": 5,
          "minimum": 1,
          "title": "Max Consecutive Failures",
          "type": "integer"
        }
      },
      "required": [
        "max_flow_materializations",
        "max_actions",
        "wall_seconds",
        "max_consecutive_failures"
      ],
      "title": "CampaignBudget",
      "type": "object"
    },
    "CampaignFlowQualificationBinding": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Id",
          "type": "string"
        },
        "flow_plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Flow Plan Id",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "scope_version": {
          "minimum": 1,
          "title": "Scope Version",
          "type": "integer"
        },
        "adaptive_plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Adaptive Plan Id",
          "type": "string"
        },
        "adaptive_outcome_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Adaptive Outcome Id",
          "type": "string"
        },
        "coverage_ledger_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Coverage Ledger Id",
          "type": "string"
        },
        "runtime_plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Runtime Plan Id",
          "type": "string"
        },
        "runtime_outcome_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Runtime Outcome Id",
          "type": "string"
        },
        "runtime_outcome_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Runtime Outcome Digest",
          "type": "string"
        },
        "assurance_level": {
          "$ref": "#/$defs/RuntimeAssuranceLevel"
        },
        "isolated_lab_qualified": {
          "const": true,
          "default": true,
          "title": "Isolated Lab Qualified",
          "type": "boolean"
        },
        "cleanup_complete": {
          "const": true,
          "default": true,
          "title": "Cleanup Complete",
          "type": "boolean"
        },
        "execution_authority_granted": {
          "const": false,
          "default": false,
          "title": "Execution Authority Granted",
          "type": "boolean"
        }
      },
      "required": [
        "binding_id",
        "flow_plan_id",
        "target_id",
        "scope_id",
        "scope_version",
        "adaptive_plan_id",
        "adaptive_outcome_id",
        "coverage_ledger_id",
        "runtime_plan_id",
        "runtime_outcome_id",
        "runtime_outcome_digest",
        "assurance_level"
      ],
      "title": "CampaignFlowQualificationBinding",
      "type": "object"
    },
    "CampaignGoal": {
      "additionalProperties": false,
      "properties": {
        "goal_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Goal Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CampaignGoalKind"
        },
        "statement_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Statement Digest",
          "type": "string"
        },
        "required_evidence_classes": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Required Evidence Classes",
          "type": "array"
        }
      },
      "required": [
        "goal_id",
        "kind",
        "statement_digest",
        "required_evidence_classes"
      ],
      "title": "CampaignGoal",
      "type": "object"
    },
    "CampaignGoalKind": {
      "enum": [
        "coverage_completion",
        "evidence_requirement_satisfaction"
      ],
      "title": "CampaignGoalKind",
      "type": "string"
    },
    "CampaignPhase": {
      "additionalProperties": false,
      "properties": {
        "phase_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Phase Id",
          "type": "string"
        },
        "ordinal": {
          "maximum": 16,
          "minimum": 1,
          "title": "Ordinal",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/CampaignPhaseKind"
        },
        "prerequisite_phase_ids": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Prerequisite Phase Ids",
          "type": "array"
        },
        "max_flow_materializations": {
          "maximum": 16,
          "minimum": 1,
          "title": "Max Flow Materializations",
          "type": "integer"
        },
        "max_actions": {
          "maximum": 128,
          "minimum": 1,
          "title": "Max Actions",
          "type": "integer"
        },
        "wall_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Wall Seconds",
          "type": "integer"
        },
        "transition_requires_operator_approval": {
          "const": true,
          "default": true,
          "title": "Transition Requires Operator Approval",
          "type": "boolean"
        },
        "execution_authority_granted": {
          "const": false,
          "default": false,
          "title": "Execution Authority Granted",
          "type": "boolean"
        }
      },
      "required": [
        "phase_id",
        "ordinal",
        "kind",
        "max_flow_materializations",
        "max_actions",
        "wall_seconds"
      ],
      "title": "CampaignPhase",
      "type": "object"
    },
    "CampaignPhaseKind": {
      "enum": [
        "scope_confirmation",
        "observation",
        "hypothesis",
        "validation",
        "critic_review",
        "cleanup_confirmation"
      ],
      "title": "CampaignPhaseKind",
      "type": "string"
    },
    "CampaignQualificationLimits": {
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "default": 10.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "title": "CampaignQualificationLimits",
      "type": "object"
    },
    "CampaignStopConditions": {
      "additionalProperties": false,
      "properties": {
        "stop_on_scope_revocation": {
          "const": true,
          "default": true,
          "title": "Stop On Scope Revocation",
          "type": "boolean"
        },
        "stop_on_budget_exhaustion": {
          "const": true,
          "default": true,
          "title": "Stop On Budget Exhaustion",
          "type": "boolean"
        },
        "stop_on_deadline": {
          "const": true,
          "default": true,
          "title": "Stop On Deadline",
          "type": "boolean"
        },
        "stop_on_cleanup_failure": {
          "const": true,
          "default": true,
          "title": "Stop On Cleanup Failure",
          "type": "boolean"
        },
        "stop_on_consecutive_failures": {
          "const": true,
          "default": true,
          "title": "Stop On Consecutive Failures",
          "type": "boolean"
        },
        "stop_on_goal_reached": {
          "const": true,
          "default": true,
          "title": "Stop On Goal Reached",
          "type": "boolean"
        }
      },
      "title": "CampaignStopConditions",
      "type": "object"
    },
    "RuntimeAssuranceLevel": {
      "enum": [
        "local_docker",
        "rootless_production"
      ],
      "title": "RuntimeAssuranceLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "campaign_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Campaign Plan Id",
      "type": "string"
    },
    "goal": {
      "$ref": "#/$defs/CampaignGoal"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_version": {
      "minimum": 1,
      "title": "Scope Version",
      "type": "integer"
    },
    "target_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Target Ids",
      "type": "array"
    },
    "flow_bindings": {
      "items": {
        "$ref": "#/$defs/CampaignFlowQualificationBinding"
      },
      "maxItems": 16,
      "minItems": 2,
      "title": "Flow Bindings",
      "type": "array"
    },
    "phases": {
      "items": {
        "$ref": "#/$defs/CampaignPhase"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Phases",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/CampaignBudget"
    },
    "stop_conditions": {
      "$ref": "#/$defs/CampaignStopConditions"
    },
    "limits": {
      "$ref": "#/$defs/CampaignQualificationLimits"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "requested_autonomy": {
      "const": "a4_goal_driven_campaign",
      "default": "a4_goal_driven_campaign",
      "title": "Requested Autonomy",
      "type": "string"
    },
    "execution_authority_requested": {
      "const": false,
      "default": false,
      "title": "Execution Authority Requested",
      "type": "boolean"
    },
    "dynamic_target_expansion_requested": {
      "const": false,
      "default": false,
      "title": "Dynamic Target Expansion Requested",
      "type": "boolean"
    },
    "credential_access_requested": {
      "const": false,
      "default": false,
      "title": "Credential Access Requested",
      "type": "boolean"
    },
    "submission_requested": {
      "const": false,
      "default": false,
      "title": "Submission Requested",
      "type": "boolean"
    }
  },
  "required": [
    "campaign_plan_id",
    "goal",
    "scope_id",
    "scope_version",
    "target_ids",
    "flow_bindings",
    "phases",
    "budget",
    "stop_conditions",
    "limits",
    "created_at",
    "deadline",
    "idempotency_key"
  ],
  "title": "GoalDrivenCampaignPlan",
  "type": "object"
}
