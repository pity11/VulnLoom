{
  "$defs": {
    "BenchmarkGateStatus": {
      "enum": [
        "passed",
        "failed"
      ],
      "title": "BenchmarkGateStatus",
      "type": "string"
    },
    "SourcePovArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "candidate_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Digest",
          "type": "string"
        },
        "crash_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Crash Fingerprint",
          "type": "string"
        },
        "input_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Digest",
          "type": "string"
        },
        "source_execution_plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Execution Plan Id",
          "type": "string"
        },
        "sanitizer": {
          "$ref": "#/$defs/SourceSanitizer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "candidate_digest",
        "crash_fingerprint",
        "input_digest",
        "source_execution_plan_id",
        "sanitizer",
        "created_at"
      ],
      "title": "SourcePovArtifact",
      "type": "object"
    },
    "SourceSanitizer": {
      "enum": [
        "address",
        "undefined",
        "memory"
      ],
      "title": "SourceSanitizer",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "result_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Id",
      "type": "string"
    },
    "case_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Case Id",
      "type": "string"
    },
    "execution_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Plan Id",
      "type": "string"
    },
    "execution_outcome_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Outcome Digest",
      "type": "string"
    },
    "crash_record_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Crash Record Fingerprint",
      "type": "string"
    },
    "pov_artifact": {
      "$ref": "#/$defs/SourcePovArtifact"
    },
    "gate_status": {
      "$ref": "#/$defs/BenchmarkGateStatus"
    },
    "violation_codes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Violation Codes",
      "type": "array"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    }
  },
  "required": [
    "result_id",
    "case_id",
    "execution_plan_id",
    "execution_outcome_digest",
    "crash_record_fingerprint",
    "pov_artifact",
    "gate_status",
    "completed_at"
  ],
  "title": "SourcePovBenchmarkResult",
  "type": "object"
}
