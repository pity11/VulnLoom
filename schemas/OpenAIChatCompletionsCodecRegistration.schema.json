{
  "$defs": {
    "AgentProviderCodecLimits": {
      "additionalProperties": false,
      "properties": {
        "max_structured_output_bytes": {
          "default": 262144,
          "exclusiveMinimum": 0,
          "maximum": 1048576,
          "title": "Max Structured Output Bytes",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "title": "AgentProviderCodecLimits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "codec_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Codec Id",
      "type": "string"
    },
    "provider_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "title": "Provider Id",
      "type": "string"
    },
    "protocol": {
      "const": "openai-chat-completions-v1",
      "default": "openai-chat-completions-v1",
      "title": "Protocol",
      "type": "string"
    },
    "request_path": {
      "const": "/v1/chat/completions",
      "default": "/v1/chat/completions",
      "title": "Request Path",
      "type": "string"
    },
    "request_model": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$",
      "title": "Request Model",
      "type": "string"
    },
    "accepted_response_models": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Accepted Response Models",
      "type": "array"
    },
    "implementation_digest": {
      "default": "5c88edc5b884fc8e152f37f6bff127ba95ea95b1c9b22c32d57133de8154e949",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Implementation Digest",
      "type": "string"
    },
    "decision_schema_digest": {
      "default": "db51ba096197cc62b97b626bb6ae910b5dd223986514f5d2b29d5c3bc7ba008b",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Decision Schema Digest",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/AgentProviderCodecLimits"
    },
    "allowed_empty_root_fields": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Allowed Empty Root Fields",
      "type": "array"
    },
    "allowed_empty_choice_fields": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Allowed Empty Choice Fields",
      "type": "array"
    },
    "allowed_empty_message_fields": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Allowed Empty Message Fields",
      "type": "array"
    },
    "reviewed_usage_extensions_allowed": {
      "default": false,
      "title": "Reviewed Usage Extensions Allowed",
      "type": "boolean"
    },
    "streaming_allowed": {
      "default": false,
      "title": "Streaming Allowed",
      "type": "boolean"
    },
    "native_tools_allowed": {
      "default": false,
      "title": "Native Tools Allowed",
      "type": "boolean"
    },
    "arbitrary_parameters_allowed": {
      "default": false,
      "title": "Arbitrary Parameters Allowed",
      "type": "boolean"
    }
  },
  "required": [
    "codec_id",
    "provider_id",
    "request_model",
    "accepted_response_models",
    "limits"
  ],
  "title": "OpenAIChatCompletionsCodecRegistration",
  "type": "object"
}
