{
  "$defs": {
    "CandidateState": {
      "enum": [
        "proposed",
        "rejected",
        "duplicate",
        "validation_pending",
        "validation_running",
        "validated",
        "inconclusive",
        "critic_reviewed",
        "promoted"
      ],
      "title": "CandidateState",
      "type": "string"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        }
      },
      "required": [
        "path",
        "line"
      ],
      "title": "SourceLocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "format": "uuid",
      "title": "Candidate Id",
      "type": "string"
    },
    "target_id": {
      "format": "uuid",
      "title": "Target Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "cwe": {
      "pattern": "^CWE-[1-9][0-9]*$",
      "title": "Cwe",
      "type": "string"
    },
    "entry_point": {
      "$ref": "#/$defs/SourceLocation"
    },
    "sink": {
      "$ref": "#/$defs/SourceLocation"
    },
    "code_path": {
      "items": {
        "$ref": "#/$defs/SourceLocation"
      },
      "title": "Code Path",
      "type": "array"
    },
    "preconditions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Preconditions",
      "type": "array"
    },
    "security_invariant": {
      "minLength": 1,
      "title": "Security Invariant",
      "type": "string"
    },
    "hypothesis": {
      "minLength": 1,
      "title": "Hypothesis",
      "type": "string"
    },
    "signal_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Signal Ids",
      "type": "array"
    },
    "cheapest_disproof": {
      "minLength": 1,
      "title": "Cheapest Disproof",
      "type": "string"
    },
    "duplicate_fingerprint": {
      "minLength": 1,
      "title": "Duplicate Fingerprint",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/CandidateState",
      "default": "proposed"
    }
  },
  "required": [
    "target_id",
    "title",
    "cwe",
    "entry_point",
    "sink",
    "code_path",
    "security_invariant",
    "hypothesis",
    "signal_ids",
    "cheapest_disproof",
    "duplicate_fingerprint"
  ],
  "title": "Candidate",
  "type": "object"
}
