{
  "$defs": {
    "AnalyzerEvaluationArtifact": {
      "additionalProperties": false,
      "properties": {
        "result_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "json_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Json Sha256",
          "type": "string"
        },
        "markdown_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Markdown Sha256",
          "type": "string"
        },
        "json_ref": {
          "pattern": "^objects/[0-9a-f]{64}/result\\.json$",
          "title": "Json Ref",
          "type": "string"
        },
        "markdown_ref": {
          "pattern": "^objects/[0-9a-f]{64}/result\\.md$",
          "title": "Markdown Ref",
          "type": "string"
        }
      },
      "required": [
        "result_digest",
        "json_sha256",
        "markdown_sha256",
        "json_ref",
        "markdown_ref"
      ],
      "title": "AnalyzerEvaluationArtifact",
      "type": "object"
    },
    "AnalyzerEvaluationMetrics": {
      "additionalProperties": false,
      "properties": {
        "case_count": {
          "minimum": 0,
          "title": "Case Count",
          "type": "integer"
        },
        "analyzer_count": {
          "minimum": 0,
          "title": "Analyzer Count",
          "type": "integer"
        },
        "ground_truth_count": {
          "minimum": 0,
          "title": "Ground Truth Count",
          "type": "integer"
        },
        "observation_count": {
          "minimum": 0,
          "title": "Observation Count",
          "type": "integer"
        },
        "matched_truth_count": {
          "minimum": 0,
          "title": "Matched Truth Count",
          "type": "integer"
        },
        "matched_observation_count": {
          "minimum": 0,
          "title": "Matched Observation Count",
          "type": "integer"
        },
        "false_positive_count": {
          "minimum": 0,
          "title": "False Positive Count",
          "type": "integer"
        },
        "duplicate_match_count": {
          "minimum": 0,
          "title": "Duplicate Match Count",
          "type": "integer"
        },
        "exclusion_count": {
          "minimum": 0,
          "title": "Exclusion Count",
          "type": "integer"
        },
        "truth_recall": {
          "maximum": 1,
          "minimum": 0,
          "title": "Truth Recall",
          "type": "number"
        },
        "observation_precision": {
          "maximum": 1,
          "minimum": 0,
          "title": "Observation Precision",
          "type": "number"
        },
        "duplicate_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Duplicate Rate",
          "type": "number"
        },
        "exclusion_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Exclusion Rate",
          "type": "number"
        },
        "by_analyzer": {
          "items": {
            "$ref": "#/$defs/AnalyzerMetricSlice"
          },
          "title": "By Analyzer",
          "type": "array"
        }
      },
      "required": [
        "case_count",
        "analyzer_count",
        "ground_truth_count",
        "observation_count",
        "matched_truth_count",
        "matched_observation_count",
        "false_positive_count",
        "duplicate_match_count",
        "exclusion_count",
        "truth_recall",
        "observation_precision",
        "duplicate_rate",
        "exclusion_rate",
        "by_analyzer"
      ],
      "title": "AnalyzerEvaluationMetrics",
      "type": "object"
    },
    "AnalyzerEvaluationResult": {
      "additionalProperties": false,
      "properties": {
        "result_id": {
          "format": "uuid",
          "title": "Result Id",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Id",
          "type": "string"
        },
        "suite_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Suite Id",
          "type": "string"
        },
        "alignment_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Alignment Id",
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/AnalyzerEvaluationMetrics"
        },
        "gate_status": {
          "$ref": "#/$defs/BenchmarkGateStatus"
        },
        "violations": {
          "items": {
            "$ref": "#/$defs/RegressionViolation"
          },
          "title": "Violations",
          "type": "array"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        }
      },
      "required": [
        "result_id",
        "plan_id",
        "suite_id",
        "alignment_id",
        "metrics",
        "gate_status",
        "violations",
        "completed_at"
      ],
      "title": "AnalyzerEvaluationResult",
      "type": "object"
    },
    "AnalyzerKind": {
      "enum": [
        "codeql",
        "trivy",
        "checkov",
        "kubesec"
      ],
      "title": "AnalyzerKind",
      "type": "string"
    },
    "AnalyzerMetricSlice": {
      "additionalProperties": false,
      "properties": {
        "analyzer": {
          "$ref": "#/$defs/AnalyzerKind"
        },
        "case_count": {
          "minimum": 0,
          "title": "Case Count",
          "type": "integer"
        },
        "ground_truth_count": {
          "minimum": 0,
          "title": "Ground Truth Count",
          "type": "integer"
        },
        "observation_count": {
          "minimum": 0,
          "title": "Observation Count",
          "type": "integer"
        },
        "matched_truth_count": {
          "minimum": 0,
          "title": "Matched Truth Count",
          "type": "integer"
        },
        "matched_observation_count": {
          "minimum": 0,
          "title": "Matched Observation Count",
          "type": "integer"
        },
        "false_positive_count": {
          "minimum": 0,
          "title": "False Positive Count",
          "type": "integer"
        },
        "duplicate_match_count": {
          "minimum": 0,
          "title": "Duplicate Match Count",
          "type": "integer"
        },
        "exclusion_count": {
          "minimum": 0,
          "title": "Exclusion Count",
          "type": "integer"
        },
        "truth_recall": {
          "maximum": 1,
          "minimum": 0,
          "title": "Truth Recall",
          "type": "number"
        },
        "observation_precision": {
          "maximum": 1,
          "minimum": 0,
          "title": "Observation Precision",
          "type": "number"
        },
        "duplicate_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Duplicate Rate",
          "type": "number"
        },
        "exclusion_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Exclusion Rate",
          "type": "number"
        }
      },
      "required": [
        "analyzer",
        "case_count",
        "ground_truth_count",
        "observation_count",
        "matched_truth_count",
        "matched_observation_count",
        "false_positive_count",
        "duplicate_match_count",
        "exclusion_count",
        "truth_recall",
        "observation_precision",
        "duplicate_rate",
        "exclusion_rate"
      ],
      "title": "AnalyzerMetricSlice",
      "type": "object"
    },
    "BenchmarkGateStatus": {
      "enum": [
        "passed",
        "failed"
      ],
      "title": "BenchmarkGateStatus",
      "type": "string"
    },
    "RegressionViolation": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "metric": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "actual": {
          "title": "Actual",
          "type": "number"
        },
        "limit": {
          "title": "Limit",
          "type": "number"
        }
      },
      "required": [
        "code",
        "metric",
        "actual",
        "limit"
      ],
      "title": "RegressionViolation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/AnalyzerEvaluationResult"
    },
    "artifact": {
      "$ref": "#/$defs/AnalyzerEvaluationArtifact"
    }
  },
  "required": [
    "plan_id",
    "result",
    "artifact"
  ],
  "title": "AnalyzerEvaluationOutcome",
  "type": "object"
}
