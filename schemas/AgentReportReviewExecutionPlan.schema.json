{
  "$defs": {
    "ReviewDecisionKind": {
      "enum": [
        "approve",
        "request_changes",
        "reject"
      ],
      "title": "ReviewDecisionKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "execution_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Plan Id",
      "type": "string"
    },
    "approval_action_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approval Action Id",
      "type": "string"
    },
    "approval_id": {
      "format": "uuid",
      "title": "Approval Id",
      "type": "string"
    },
    "approval_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approval Digest",
      "type": "string"
    },
    "review_intake_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Intake Plan Id",
      "type": "string"
    },
    "review_intake_record_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Intake Record Id",
      "type": "string"
    },
    "review_intake_record_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Intake Record Digest",
      "type": "string"
    },
    "draft_execution_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Draft Execution Plan Id",
      "type": "string"
    },
    "draft_outcome_binding_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Draft Outcome Binding Id",
      "type": "string"
    },
    "report_review_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Review Plan Id",
      "type": "string"
    },
    "report_review_plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Review Plan Digest",
      "type": "string"
    },
    "report_review_command_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Review Command Id",
      "type": "string"
    },
    "report_review_command_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Review Command Digest",
      "type": "string"
    },
    "report_id": {
      "format": "uuid",
      "title": "Report Id",
      "type": "string"
    },
    "report_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Digest",
      "type": "string"
    },
    "artifact_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Digest",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/ReviewDecisionKind"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_version": {
      "minimum": 1,
      "title": "Scope Version",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "execution_plan_id",
    "approval_action_id",
    "approval_id",
    "approval_digest",
    "review_intake_plan_id",
    "review_intake_record_id",
    "review_intake_record_digest",
    "draft_execution_plan_id",
    "draft_outcome_binding_id",
    "report_review_plan_id",
    "report_review_plan_digest",
    "report_review_command_id",
    "report_review_command_digest",
    "report_id",
    "report_digest",
    "artifact_digest",
    "decision",
    "scope_id",
    "scope_version",
    "created_at",
    "deadline",
    "idempotency_key"
  ],
  "title": "AgentReportReviewExecutionPlan",
  "type": "object"
}
