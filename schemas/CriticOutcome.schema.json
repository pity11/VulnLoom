{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "target_version": {
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        },
        "source_graph_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Graph Id",
          "type": "string"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "scope_version": {
          "minimum": 1,
          "title": "Scope Version",
          "type": "integer"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "cwe": {
          "pattern": "^CWE-[1-9][0-9]*$",
          "title": "Cwe",
          "type": "string"
        },
        "entry_point": {
          "$ref": "#/$defs/SourceLocation"
        },
        "sink": {
          "$ref": "#/$defs/SourceLocation"
        },
        "code_path": {
          "items": {
            "$ref": "#/$defs/SourceLocation"
          },
          "minItems": 1,
          "title": "Code Path",
          "type": "array"
        },
        "preconditions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "security_invariant": {
          "minLength": 1,
          "title": "Security Invariant",
          "type": "string"
        },
        "hypothesis": {
          "minLength": 1,
          "title": "Hypothesis",
          "type": "string"
        },
        "signal_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Signal Ids",
          "type": "array"
        },
        "cheapest_disproof": {
          "minLength": 1,
          "title": "Cheapest Disproof",
          "type": "string"
        },
        "duplicate_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Duplicate Fingerprint",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "state": {
          "$ref": "#/$defs/CandidateState",
          "default": "proposed"
        }
      },
      "required": [
        "target_id",
        "target_version",
        "source_graph_id",
        "scope_id",
        "scope_version",
        "title",
        "cwe",
        "entry_point",
        "sink",
        "code_path",
        "security_invariant",
        "hypothesis",
        "signal_ids",
        "cheapest_disproof",
        "duplicate_fingerprint",
        "confidence"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "CandidateState": {
      "enum": [
        "proposed",
        "rejected",
        "duplicate",
        "validation_pending",
        "validation_running",
        "validated",
        "inconclusive",
        "critic_reviewed",
        "promoted"
      ],
      "title": "CandidateState",
      "type": "string"
    },
    "CriticReview": {
      "additionalProperties": false,
      "properties": {
        "review_id": {
          "format": "uuid",
          "title": "Review Id",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Id",
          "type": "string"
        },
        "candidate_id": {
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "validation_run_id": {
          "format": "uuid",
          "title": "Validation Run Id",
          "type": "string"
        },
        "evidence_bundle_id": {
          "format": "uuid",
          "title": "Evidence Bundle Id",
          "type": "string"
        },
        "validation_context_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Validation Context Id",
          "type": "string"
        },
        "review_context_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Review Context Id",
          "type": "string"
        },
        "ruleset_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Ruleset Digest",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/CriticVerdict"
        },
        "counterevidence_refs": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Counterevidence Refs",
          "type": "array"
        },
        "rationale_code": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Rationale Code",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        }
      },
      "required": [
        "review_id",
        "plan_id",
        "candidate_id",
        "validation_run_id",
        "evidence_bundle_id",
        "validation_context_id",
        "review_context_id",
        "ruleset_digest",
        "verdict",
        "rationale_code"
      ],
      "title": "CriticReview",
      "type": "object"
    },
    "CriticVerdict": {
      "enum": [
        "accepted",
        "rejected",
        "inconclusive"
      ],
      "title": "CriticVerdict",
      "type": "string"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        }
      },
      "required": [
        "path",
        "line"
      ],
      "title": "SourceLocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "candidate": {
      "$ref": "#/$defs/Candidate"
    },
    "review": {
      "$ref": "#/$defs/CriticReview"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "candidate",
    "review",
    "completed_at"
  ],
  "title": "CriticOutcome",
  "type": "object"
}
