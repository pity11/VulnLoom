{
  "$defs": {
    "AuditOutcome": {
      "enum": [
        "committed",
        "rejected",
        "timed_out",
        "cleanup_failed"
      ],
      "title": "AuditOutcome",
      "type": "string"
    },
    "AuditStateBindings": {
      "additionalProperties": false,
      "description": "Exact authority and input identities for one state transition.",
      "properties": {
        "engagement_id": {
          "format": "uuid",
          "title": "Engagement Id",
          "type": "string"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "scope_version": {
          "minimum": 1,
          "title": "Scope Version",
          "type": "integer"
        },
        "policy_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "sandbox_profile_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sandbox Profile Digest",
          "type": "string"
        },
        "context_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Context Digest",
          "type": "string"
        },
        "tool_registry_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tool Registry Digest",
          "type": "string"
        },
        "provider_revision_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Provider Revision Digest",
          "type": "string"
        },
        "input_digests": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Input Digests",
          "type": "array"
        }
      },
      "required": [
        "engagement_id",
        "scope_id",
        "scope_version",
        "policy_digest",
        "sandbox_profile_digest",
        "context_digest",
        "tool_registry_digest",
        "provider_revision_digest",
        "input_digests"
      ],
      "title": "AuditStateBindings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "record_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Digest",
      "type": "string"
    },
    "contract_digest": {
      "default": "343d7af3ff2b05983272ecd1a8a3d73a1ba89435e9ecec9b1ecfd296b3863e91",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Contract Digest",
      "type": "string"
    },
    "stream_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Stream Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "previous_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Previous Digest",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "event_type": {
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Event Type",
      "type": "string"
    },
    "aggregate_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Aggregate Id",
      "type": "string"
    },
    "transition_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Transition Digest",
      "type": "string"
    },
    "bindings": {
      "$ref": "#/$defs/AuditStateBindings"
    },
    "outcome": {
      "$ref": "#/$defs/AuditOutcome"
    },
    "cleanup_verified": {
      "title": "Cleanup Verified",
      "type": "boolean"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "sealed_at": {
      "format": "date-time",
      "title": "Sealed At",
      "type": "string"
    }
  },
  "required": [
    "record_digest",
    "stream_id",
    "sequence",
    "previous_digest",
    "plan_id",
    "event_type",
    "aggregate_id",
    "transition_digest",
    "bindings",
    "outcome",
    "cleanup_verified",
    "occurred_at",
    "sealed_at"
  ],
  "title": "AuditRecord",
  "type": "object"
}
