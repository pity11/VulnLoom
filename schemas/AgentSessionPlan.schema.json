{
  "$defs": {
    "AgentAuthorizedCallOption": {
      "additionalProperties": false,
      "properties": {
        "call_commitment": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Call Commitment",
          "type": "string"
        },
        "broker_call_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Broker Call Digest",
          "type": "string"
        },
        "broker_call": {
          "$ref": "#/$defs/BrokerCall"
        }
      },
      "required": [
        "call_commitment",
        "broker_call_digest",
        "broker_call"
      ],
      "title": "AgentAuthorizedCallOption",
      "type": "object"
    },
    "AgentAuthorizedCallSet": {
      "additionalProperties": false,
      "properties": {
        "call_set_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Call Set Id",
          "type": "string"
        },
        "round_index": {
          "default": 2,
          "maximum": 2,
          "minimum": 2,
          "title": "Round Index",
          "type": "integer"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "task_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Task Digest",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/AgentAuthorizedCallOption"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "call_set_id",
        "task_id",
        "task_digest",
        "options"
      ],
      "title": "AgentAuthorizedCallSet",
      "type": "object"
    },
    "AgentCleanupReport": {
      "additionalProperties": false,
      "properties": {
        "model_request_released": {
          "title": "Model Request Released",
          "type": "boolean"
        },
        "raw_response_discarded": {
          "title": "Raw Response Discarded",
          "type": "boolean"
        },
        "no_tool_executed": {
          "title": "No Tool Executed",
          "type": "boolean"
        }
      },
      "required": [
        "model_request_released",
        "raw_response_discarded",
        "no_tool_executed"
      ],
      "title": "AgentCleanupReport",
      "type": "object"
    },
    "AgentContextFragment": {
      "additionalProperties": false,
      "properties": {
        "ordinal": {
          "maximum": 1023,
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "source_ref_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Ref Digest",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AgentContextSourceKind"
        },
        "redacted_text": {
          "title": "Redacted Text",
          "type": "string"
        },
        "text_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Text Digest",
          "type": "string"
        },
        "byte_size": {
          "maximum": 1048576,
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "untrusted": {
          "default": true,
          "title": "Untrusted",
          "type": "boolean"
        }
      },
      "required": [
        "ordinal",
        "source_ref_digest",
        "kind",
        "redacted_text",
        "text_digest",
        "byte_size"
      ],
      "title": "AgentContextFragment",
      "type": "object"
    },
    "AgentContextSnapshot": {
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "task_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Task Digest",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "target_version": {
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "scope_version": {
          "minimum": 1,
          "title": "Scope Version",
          "type": "integer"
        },
        "input_refs_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Refs Digest",
          "type": "string"
        },
        "input_ref_digests": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Input Ref Digests",
          "type": "array"
        },
        "redaction_policy": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Redaction Policy",
          "type": "string"
        },
        "redaction_policy_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Redaction Policy Digest",
          "type": "string"
        },
        "fragments": {
          "items": {
            "$ref": "#/$defs/AgentContextFragment"
          },
          "maxItems": 1024,
          "title": "Fragments",
          "type": "array"
        },
        "total_bytes": {
          "maximum": 4194304,
          "minimum": 0,
          "title": "Total Bytes",
          "type": "integer"
        },
        "assembled_at": {
          "format": "date-time",
          "title": "Assembled At",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "task_id",
        "task_digest",
        "target_id",
        "target_version",
        "scope_id",
        "scope_version",
        "input_refs_digest",
        "input_ref_digests",
        "redaction_policy",
        "redaction_policy_digest",
        "fragments",
        "total_bytes",
        "assembled_at"
      ],
      "title": "AgentContextSnapshot",
      "type": "object"
    },
    "AgentContextSourceKind": {
      "enum": [
        "task_summary",
        "evidence_summary",
        "observation_summary"
      ],
      "title": "AgentContextSourceKind",
      "type": "string"
    },
    "AgentRunLimits": {
      "additionalProperties": false,
      "properties": {
        "max_steps": {
          "default": 2,
          "maximum": 8,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "max_output_tokens_per_step": {
          "default": 4096,
          "exclusiveMinimum": 0,
          "maximum": 65536,
          "title": "Max Output Tokens Per Step",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "title": "AgentRunLimits",
      "type": "object"
    },
    "AgentRunOutcome": {
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Id",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "model_registration_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Registration Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AgentRunStatus"
        },
        "steps": {
          "maximum": 8,
          "minimum": 1,
          "title": "Steps",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "tool_intent": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentToolIntent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "summary_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary Digest"
        },
        "supporting_ref_digests": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Supporting Ref Digests",
          "type": "array"
        },
        "error_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Error Codes",
          "type": "array"
        },
        "cleanup": {
          "$ref": "#/$defs/AgentCleanupReport"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "task_id",
        "model_registration_id",
        "status",
        "steps",
        "input_tokens",
        "output_tokens",
        "cleanup",
        "completed_at"
      ],
      "title": "AgentRunOutcome",
      "type": "object"
    },
    "AgentRunPlan": {
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Id",
          "type": "string"
        },
        "task": {
          "$ref": "#/$defs/TaskEnvelope"
        },
        "task_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Task Digest",
          "type": "string"
        },
        "model_registration_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Registration Id",
          "type": "string"
        },
        "model_registration_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Registration Digest",
          "type": "string"
        },
        "context_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Context Digest",
          "type": "string"
        },
        "context_snapshot_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Snapshot Id"
        },
        "authorized_call_set_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authorized Call Set Id"
        },
        "authorized_call_commitments": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Authorized Call Commitments",
          "type": "array"
        },
        "decision_schema_digest": {
          "default": "db51ba096197cc62b97b626bb6ae910b5dd223986514f5d2b29d5c3bc7ba008b",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Decision Schema Digest",
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/AgentRunLimits"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "deadline": {
          "format": "date-time",
          "title": "Deadline",
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "task",
        "task_digest",
        "model_registration_id",
        "model_registration_digest",
        "context_digest",
        "limits",
        "created_at",
        "deadline",
        "idempotency_key"
      ],
      "title": "AgentRunPlan",
      "type": "object"
    },
    "AgentRunStatus": {
      "enum": [
        "tool_proposed",
        "completed",
        "blocked",
        "failed",
        "timed_out"
      ],
      "title": "AgentRunStatus",
      "type": "string"
    },
    "AgentSessionBudgetLedger": {
      "additionalProperties": false,
      "properties": {
        "original_model_tokens": {
          "exclusiveMinimum": 0,
          "title": "Original Model Tokens",
          "type": "integer"
        },
        "original_tool_calls": {
          "maximum": 2,
          "minimum": 2,
          "title": "Original Tool Calls",
          "type": "integer"
        },
        "consumed_model_tokens": {
          "minimum": 0,
          "title": "Consumed Model Tokens",
          "type": "integer"
        },
        "remaining_model_tokens": {
          "minimum": 0,
          "title": "Remaining Model Tokens",
          "type": "integer"
        },
        "consumed_agent_steps": {
          "maximum": 24,
          "minimum": 1,
          "title": "Consumed Agent Steps",
          "type": "integer"
        },
        "consumed_tool_calls": {
          "maximum": 2,
          "minimum": 1,
          "title": "Consumed Tool Calls",
          "type": "integer"
        },
        "remaining_tool_calls": {
          "minimum": 0,
          "title": "Remaining Tool Calls",
          "type": "integer"
        },
        "provider_attempts": {
          "maximum": 3,
          "minimum": 1,
          "title": "Provider Attempts",
          "type": "integer"
        },
        "broker_attempts": {
          "maximum": 3,
          "minimum": 1,
          "title": "Broker Attempts",
          "type": "integer"
        },
        "remaining_wall_seconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Remaining Wall Seconds",
          "type": "integer"
        }
      },
      "required": [
        "original_model_tokens",
        "original_tool_calls",
        "consumed_model_tokens",
        "remaining_model_tokens",
        "consumed_agent_steps",
        "consumed_tool_calls",
        "remaining_tool_calls",
        "provider_attempts",
        "broker_attempts",
        "remaining_wall_seconds"
      ],
      "title": "AgentSessionBudgetLedger",
      "type": "object"
    },
    "AgentSessionLimits": {
      "additionalProperties": false,
      "properties": {
        "max_tool_rounds": {
          "default": 2,
          "maximum": 2,
          "minimum": 2,
          "title": "Max Tool Rounds",
          "type": "integer"
        },
        "max_provider_turns": {
          "default": 3,
          "maximum": 3,
          "minimum": 3,
          "title": "Max Provider Turns",
          "type": "integer"
        },
        "max_authorized_calls_per_round": {
          "default": 8,
          "maximum": 8,
          "minimum": 1,
          "title": "Max Authorized Calls Per Round",
          "type": "integer"
        }
      },
      "title": "AgentSessionLimits",
      "type": "object"
    },
    "AgentToolHandoffCleanup": {
      "additionalProperties": false,
      "properties": {
        "raw_agent_arguments_absent": {
          "title": "Raw Agent Arguments Absent",
          "type": "boolean"
        },
        "raw_tool_response_absent": {
          "title": "Raw Tool Response Absent",
          "type": "boolean"
        },
        "authorization_enforced": {
          "title": "Authorization Enforced",
          "type": "boolean"
        },
        "no_vulnloom_domain_state_changed": {
          "title": "No Vulnloom Domain State Changed",
          "type": "boolean"
        }
      },
      "required": [
        "raw_agent_arguments_absent",
        "raw_tool_response_absent",
        "authorization_enforced",
        "no_vulnloom_domain_state_changed"
      ],
      "title": "AgentToolHandoffCleanup",
      "type": "object"
    },
    "AgentToolHandoffOutcome": {
      "additionalProperties": false,
      "properties": {
        "outcome_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Outcome Id",
          "type": "string"
        },
        "handoff_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Handoff Id",
          "type": "string"
        },
        "agent_plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Agent Plan Id",
          "type": "string"
        },
        "agent_outcome_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Agent Outcome Digest",
          "type": "string"
        },
        "broker_call_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Broker Call Digest",
          "type": "string"
        },
        "attempt": {
          "maximum": 2,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/AgentToolHandoffStatus"
        },
        "broker_result": {
          "$ref": "#/$defs/BrokerResult"
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentToolObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cleanup": {
          "$ref": "#/$defs/AgentToolHandoffCleanup"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        }
      },
      "required": [
        "outcome_id",
        "handoff_id",
        "agent_plan_id",
        "agent_outcome_digest",
        "broker_call_digest",
        "attempt",
        "status",
        "broker_result",
        "cleanup",
        "completed_at"
      ],
      "title": "AgentToolHandoffOutcome",
      "type": "object"
    },
    "AgentToolHandoffStatus": {
      "enum": [
        "completed",
        "denied",
        "approval_required",
        "timed_out",
        "failed"
      ],
      "title": "AgentToolHandoffStatus",
      "type": "string"
    },
    "AgentToolIntent": {
      "additionalProperties": false,
      "properties": {
        "tool_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Tool Id",
          "type": "string"
        },
        "invocation_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Invocation Digest",
          "type": "string"
        },
        "argument_digests": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Argument Digests",
          "type": "array"
        },
        "working_directory": {
          "$ref": "#/$defs/WorkingDirectory"
        }
      },
      "required": [
        "tool_id",
        "invocation_digest",
        "argument_digests",
        "working_directory"
      ],
      "title": "AgentToolIntent",
      "type": "object"
    },
    "AgentToolObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Id",
          "type": "string"
        },
        "handoff_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Handoff Id",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "target_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "scope_version": {
          "minimum": 1,
          "title": "Scope Version",
          "type": "integer"
        },
        "tool_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Tool Id",
          "type": "string"
        },
        "broker_result_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Broker Result Digest",
          "type": "string"
        },
        "status_code": {
          "maximum": 599,
          "minimum": 100,
          "title": "Status Code",
          "type": "integer"
        },
        "final_url_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Final Url Digest",
          "type": "string"
        },
        "response_bytes": {
          "maximum": 20971520,
          "minimum": 0,
          "title": "Response Bytes",
          "type": "integer"
        },
        "response_body_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Body Sha256",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "handoff_id",
        "task_id",
        "target_id",
        "target_version",
        "scope_id",
        "scope_version",
        "tool_id",
        "broker_result_digest",
        "status_code",
        "final_url_digest",
        "response_bytes",
        "response_body_sha256",
        "evidence_refs",
        "observed_at"
      ],
      "title": "AgentToolObservation",
      "type": "object"
    },
    "BrokerCall": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "format": "uuid",
          "title": "Call Id",
          "type": "string"
        },
        "task": {
          "$ref": "#/$defs/TaskEnvelope"
        },
        "profile": {
          "$ref": "#/$defs/SandboxProfile"
        },
        "tool_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Tool Id",
          "type": "string"
        },
        "http": {
          "$ref": "#/$defs/HttpRequestPlan"
        },
        "idempotency_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        }
      },
      "required": [
        "task",
        "profile",
        "tool_id",
        "http",
        "idempotency_key"
      ],
      "title": "BrokerCall",
      "type": "object"
    },
    "BrokerResult": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "format": "uuid",
          "title": "Call Id",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "tool_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Tool Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/BrokerStatus"
        },
        "registry_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Registry Digest",
          "type": "string"
