{
  "$defs": {
    "AgentFindingIntakeDecision": {
      "enum": [
        "accept",
        "reject",
        "defer"
      ],
      "title": "AgentFindingIntakeDecision",
      "type": "string"
    },
    "AgentFindingIntakeReason": {
      "enum": [
        "human_accepted_exact_promotion",
        "human_rejected",
        "human_deferred"
      ],
      "title": "AgentFindingIntakeReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "command_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Command Id",
      "type": "string"
    },
    "intake_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Intake Plan Id",
      "type": "string"
    },
    "intake_plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Intake Plan Digest",
      "type": "string"
    },
    "critic_outcome_binding_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Critic Outcome Binding Id",
      "type": "string"
    },
    "promotion_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Promotion Plan Id",
      "type": "string"
    },
    "promotion_plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Promotion Plan Digest",
      "type": "string"
    },
    "candidate_id": {
      "format": "uuid",
      "title": "Candidate Id",
      "type": "string"
    },
    "finding_id": {
      "format": "uuid",
      "title": "Finding Id",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/AgentFindingIntakeDecision"
    },
    "reason_code": {
      "$ref": "#/$defs/AgentFindingIntakeReason"
    },
    "reviewer": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Reviewer",
      "type": "string"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    }
  },
  "required": [
    "command_id",
    "intake_plan_id",
    "intake_plan_digest",
    "critic_outcome_binding_id",
    "promotion_plan_id",
    "promotion_plan_digest",
    "candidate_id",
    "finding_id",
    "decision",
    "reason_code",
    "reviewer",
    "decided_at"
  ],
  "title": "AgentFindingIntakeCommand",
  "type": "object"
}
