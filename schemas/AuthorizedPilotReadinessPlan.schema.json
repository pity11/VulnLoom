{
  "$defs": {
    "AuthorizedPilotReadinessPolicy": {
      "additionalProperties": false,
      "properties": {
        "required_human_gates": {
          "default": [
            "candidate_selection",
            "validation_intake",
            "critic_intake",
            "finding_promotion_intake",
            "finding_promotion_approval",
            "report_intake",
            "report_review_intake",
            "report_review_approval",
            "report_export_intake",
            "report_export_approval"
          ],
          "items": {
            "$ref": "#/$defs/PilotHumanGate"
          },
          "title": "Required Human Gates",
          "type": "array"
        },
        "forbidden_capabilities": {
          "default": [
            "agent_runner_parameters",
            "agent_broker_parameters",
            "automatic_validation",
            "automatic_candidate_mutation",
            "automatic_approval",
            "target_build",
            "public_network",
            "submission"
          ],
          "items": {
            "$ref": "#/$defs/PilotForbiddenCapability"
          },
          "title": "Forbidden Capabilities",
          "type": "array"
        },
        "max_source_files": {
          "default": 10000,
          "maximum": 10000,
          "minimum": 10000,
          "title": "Max Source Files",
          "type": "integer"
        },
        "max_source_bytes": {
          "default": 209715200,
          "maximum": 209715200,
          "minimum": 209715200,
          "title": "Max Source Bytes",
          "type": "integer"
        },
        "max_candidates": {
          "default": 2000,
          "maximum": 2000,
          "minimum": 2000,
          "title": "Max Candidates",
          "type": "integer"
        },
        "require_quality_pass": {
          "default": true,
          "title": "Require Quality Pass",
          "type": "boolean"
        },
        "require_proposed_candidates": {
          "default": true,
          "title": "Require Proposed Candidates",
          "type": "boolean"
        },
        "max_forbidden_effects": {
          "default": 0,
          "maximum": 0,
          "minimum": 0,
          "title": "Max Forbidden Effects",
          "type": "integer"
        }
      },
      "title": "AuthorizedPilotReadinessPolicy",
      "type": "object"
    },
    "LocalSourceEffectCounters": {
      "additionalProperties": false,
      "properties": {
        "runner_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Runner Calls",
          "type": "integer"
        },
        "broker_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Broker Calls",
          "type": "integer"
        },
        "provider_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Provider Calls",
          "type": "integer"
        },
        "target_processes": {
          "default": 0,
          "minimum": 0,
          "title": "Target Processes",
          "type": "integer"
        },
        "public_network_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Public Network Calls",
          "type": "integer"
        },
        "target_builds": {
          "default": 0,
          "minimum": 0,
          "title": "Target Builds",
          "type": "integer"
        },
        "automatic_approvals": {
          "default": 0,
          "minimum": 0,
          "title": "Automatic Approvals",
          "type": "integer"
        },
        "submissions": {
          "default": 0,
          "minimum": 0,
          "title": "Submissions",
          "type": "integer"
        }
      },
      "title": "LocalSourceEffectCounters",
      "type": "object"
    },
    "PilotForbiddenCapability": {
      "enum": [
        "agent_runner_parameters",
        "agent_broker_parameters",
        "automatic_validation",
        "automatic_candidate_mutation",
        "automatic_approval",
        "target_build",
        "public_network",
        "submission"
      ],
      "title": "PilotForbiddenCapability",
      "type": "string"
    },
    "PilotHumanGate": {
      "enum": [
        "candidate_selection",
        "validation_intake",
        "critic_intake",
        "finding_promotion_intake",
        "finding_promotion_approval",
        "report_intake",
        "report_review_intake",
        "report_review_approval",
        "report_export_intake",
        "report_export_approval"
      ],
      "title": "PilotHumanGate",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "pilot_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pilot Manifest Id",
      "type": "string"
    },
    "pilot_manifest_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pilot Manifest Digest",
      "type": "string"
    },
    "quality_profile_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Quality Profile Id",
      "type": "string"
    },
    "quality_profile_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Quality Profile Digest",
      "type": "string"
    },
    "quality_result_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Quality Result Id",
      "type": "string"
    },
    "quality_result_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Quality Result Digest",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/AuthorizedPilotReadinessPolicy"
    },
    "effects": {
      "$ref": "#/$defs/LocalSourceEffectCounters"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "pilot_manifest_id",
    "pilot_manifest_digest",
    "quality_profile_id",
    "quality_profile_digest",
    "quality_result_id",
    "quality_result_digest",
    "policy",
    "effects",
    "created_at",
    "deadline",
    "idempotency_key"
  ],
  "title": "AuthorizedPilotReadinessPlan",
  "type": "object"
}
