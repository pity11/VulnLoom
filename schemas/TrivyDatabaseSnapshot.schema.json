{
  "$defs": {
    "TrivyDatabaseFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "size": {
          "exclusiveMinimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "title": "TrivyDatabaseFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "tool_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Tool Version",
      "type": "string"
    },
    "schema_version": {
      "maximum": 2,
      "minimum": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/TrivyDatabaseFile"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Files",
      "type": "array"
    },
    "total_size": {
      "exclusiveMinimum": 0,
      "title": "Total Size",
      "type": "integer"
    }
  },
  "required": [
    "snapshot_id",
    "tool_version",
    "schema_version",
    "files",
    "total_size"
  ],
  "title": "TrivyDatabaseSnapshot",
  "type": "object"
}
