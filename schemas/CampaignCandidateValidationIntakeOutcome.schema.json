{
  "$defs": {
    "CampaignCandidateLifecycleCheckpoint": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checkpoint Id",
          "type": "string"
        },
        "validation_intake_plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Validation Intake Plan Id",
          "type": "string"
        },
        "candidate_id": {
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "candidate_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Digest",
          "type": "string"
        },
        "previous_state": {
          "const": "proposed",
          "default": "proposed",
          "title": "Previous State",
          "type": "string"
        },
        "state": {
          "const": "validation_pending",
          "default": "validation_pending",
          "title": "State",
          "type": "string"
        },
        "approval_id": {
          "format": "uuid",
          "title": "Approval Id",
          "type": "string"
        },
        "approval_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Approval Digest",
          "type": "string"
        },
        "validation_context_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Validation Context Digest",
          "type": "string"
        },
        "prior_campaign_evidence_refs": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Prior Campaign Evidence Refs",
          "type": "array"
        },
        "required_fresh_facts": {
          "items": {
            "$ref": "#/$defs/EvidenceFactKind"
          },
          "title": "Required Fresh Facts",
          "type": "array"
        },
        "prior_campaign_evidence_accepted_as_validation": {
          "const": false,
          "default": false,
          "title": "Prior Campaign Evidence Accepted As Validation",
          "type": "boolean"
        },
        "validation_started": {
          "const": false,
          "default": false,
          "title": "Validation Started",
          "type": "boolean"
        },
        "critic_completed": {
          "const": false,
          "default": false,
          "title": "Critic Completed",
          "type": "boolean"
        },
        "finding_created": {
          "const": false,
          "default": false,
          "title": "Finding Created",
          "type": "boolean"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        }
      },
      "required": [
        "checkpoint_id",
        "validation_intake_plan_id",
        "candidate_id",
        "candidate_digest",
        "approval_id",
        "approval_digest",
        "validation_context_digest",
        "prior_campaign_evidence_refs",
        "required_fresh_facts",
        "recorded_at"
      ],
      "title": "CampaignCandidateLifecycleCheckpoint",
      "type": "object"
    },
    "EvidenceFactKind": {
      "enum": [
        "sealed_get_succeeded",
        "unauthenticated_request_proven",
        "sensitive_data_class_present",
        "independent_replay_matched",
        "redaction_boundary_proven",
        "access_control_enforced",
        "public_by_design",
        "synthetic_or_placeholder_data",
        "environment_or_version_mismatch",
        "no_state_change_proven",
        "no_test_artifacts_remain"
      ],
      "title": "EvidenceFactKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "outcome_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Outcome Id",
      "type": "string"
    },
    "validation_intake_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Intake Plan Id",
      "type": "string"
    },
    "checkpoint": {
      "$ref": "#/$defs/CampaignCandidateLifecycleCheckpoint"
    },
    "attempt": {
      "maximum": 3,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "validation_admitted": {
      "const": true,
      "default": true,
      "title": "Validation Admitted",
      "type": "boolean"
    },
    "validation_started": {
      "const": false,
      "default": false,
      "title": "Validation Started",
      "type": "boolean"
    },
    "validation_run_created": {
      "const": false,
      "default": false,
      "title": "Validation Run Created",
      "type": "boolean"
    },
    "critic_completed": {
      "const": false,
      "default": false,
      "title": "Critic Completed",
      "type": "boolean"
    },
    "finding_created": {
      "const": false,
      "default": false,
      "title": "Finding Created",
      "type": "boolean"
    },
    "cleanup_complete": {
      "const": true,
      "default": true,
      "title": "Cleanup Complete",
      "type": "boolean"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    }
  },
  "required": [
    "outcome_id",
    "validation_intake_plan_id",
    "checkpoint",
    "attempt",
    "completed_at"
  ],
  "title": "CampaignCandidateValidationIntakeOutcome",
  "type": "object"
}
