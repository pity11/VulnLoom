{
  "$defs": {
    "AgentAdapterKind": {
      "enum": [
        "offline_replay",
        "local_fake_provider",
        "admission_fake_transport",
        "subprocess_https_provider"
      ],
      "title": "AgentAdapterKind",
      "type": "string"
    },
    "AgentModelRegistration": {
      "additionalProperties": false,
      "properties": {
        "registration_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Registration Id",
          "type": "string"
        },
        "provider_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Provider Id",
          "type": "string"
        },
        "model": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$",
          "title": "Model",
          "type": "string"
        },
        "adapter_kind": {
          "$ref": "#/$defs/AgentAdapterKind",
          "default": "offline_replay"
        },
        "adapter_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Adapter Digest",
          "type": "string"
        },
        "credential_reference_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Reference Id"
        },
        "transport_admission_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport Admission Id"
        },
        "egress_grant_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Egress Grant Id"
        },
        "provider_codec_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Codec Id"
        },
        "supported_roles": {
          "items": {
            "$ref": "#/$defs/WorkerRole"
          },
          "minItems": 1,
          "title": "Supported Roles",
          "type": "array"
        },
        "max_output_tokens": {
          "exclusiveMinimum": 0,
          "maximum": 65536,
          "title": "Max Output Tokens",
          "type": "integer"
        }
      },
      "required": [
        "registration_id",
        "provider_id",
        "model",
        "adapter_digest",
        "supported_roles",
        "max_output_tokens"
      ],
      "title": "AgentModelRegistration",
      "type": "object"
    },
    "AgentProviderCodecLimits": {
      "additionalProperties": false,
      "properties": {
        "max_structured_output_bytes": {
          "default": 262144,
          "exclusiveMinimum": 0,
          "maximum": 1048576,
          "title": "Max Structured Output Bytes",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "title": "AgentProviderCodecLimits",
      "type": "object"
    },
    "AgentProviderIpPolicy": {
      "enum": [
        "none",
        "loopback_only",
        "global_only"
      ],
      "title": "AgentProviderIpPolicy",
      "type": "string"
    },
    "AgentProviderTransportAdmission": {
      "additionalProperties": false,
      "properties": {
        "admission_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Admission Id",
          "type": "string"
        },
        "provider_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Provider Id",
          "type": "string"
        },
        "hostname": {
          "maxLength": 253,
          "minLength": 3,
          "title": "Hostname",
          "type": "string"
        },
        "port": {
          "default": 443,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "request_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Request Path",
          "type": "string"
        },
        "credential_reference_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Credential Reference Id",
          "type": "string"
        },
        "adapter_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Adapter Digest",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/AgentProviderTransportMode",
          "default": "admission_fake"
        },
        "limits": {
          "$ref": "#/$defs/AgentProviderTransportLimits"
        },
        "tls_required": {
          "default": true,
          "title": "Tls Required",
          "type": "boolean"
        },
        "redirects_allowed": {
          "default": false,
          "title": "Redirects Allowed",
          "type": "boolean"
        },
        "proxy_allowed": {
          "default": false,
          "title": "Proxy Allowed",
          "type": "boolean"
        },
        "dns_revalidation_required": {
          "default": true,
          "title": "Dns Revalidation Required",
          "type": "boolean"
        },
        "raw_response_persisted": {
          "default": false,
          "title": "Raw Response Persisted",
          "type": "boolean"
        },
        "network_enabled": {
          "default": false,
          "title": "Network Enabled",
          "type": "boolean"
        },
        "process_isolation_required": {
          "default": false,
          "title": "Process Isolation Required",
          "type": "boolean"
        },
        "ip_policy": {
          "$ref": "#/$defs/AgentProviderIpPolicy",
          "default": "none"
        },
        "ca_bundle_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ca Bundle Digest"
        },
        "minimum_tls_version": {
          "default": "TLSv1.2",
          "title": "Minimum Tls Version",
          "type": "string"
        }
      },
      "required": [
        "admission_id",
        "provider_id",
        "hostname",
        "request_path",
        "credential_reference_id",
        "adapter_digest",
        "limits"
      ],
      "title": "AgentProviderTransportAdmission",
      "type": "object"
    },
    "AgentProviderTransportLimits": {
      "additionalProperties": false,
      "properties": {
        "max_request_bytes": {
          "default": 1048576,
          "exclusiveMinimum": 0,
          "maximum": 2162688,
          "title": "Max Request Bytes",
          "type": "integer"
        },
        "max_response_bytes": {
          "default": 1048576,
          "exclusiveMinimum": 0,
          "maximum": 2097152,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_attempts": {
          "default": 1,
          "maximum": 1,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "max_requests_per_minute": {
          "default": 30,
          "maximum": 120,
          "minimum": 1,
          "title": "Max Requests Per Minute",
          "type": "integer"
        }
      },
      "title": "AgentProviderTransportLimits",
      "type": "object"
    },
    "AgentProviderTransportMode": {
      "enum": [
        "admission_fake",
        "loopback_https_probe",
        "live_https"
      ],
      "title": "AgentProviderTransportMode",
      "type": "string"
    },
    "ModelCredentialReference": {
      "additionalProperties": false,
      "properties": {
        "reference_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reference Id",
          "type": "string"
        },
        "environment_variable": {
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
          "title": "Environment Variable",
          "type": "string"
        }
      },
      "required": [
        "reference_id",
        "environment_variable"
      ],
      "title": "ModelCredentialReference",
      "type": "object"
    },
    "ProfileCandidateRecommendationCodecRegistration": {
      "additionalProperties": false,
      "properties": {
        "codec_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Codec Id",
          "type": "string"
        },
        "provider_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Provider Id",
          "type": "string"
        },
        "protocol": {
          "const": "openai-compatible-candidate-recommendation-v1",
          "default": "openai-compatible-candidate-recommendation-v1",
          "title": "Protocol",
          "type": "string"
        },
        "request_path": {
          "const": "/v1/chat/completions",
          "default": "/v1/chat/completions",
          "title": "Request Path",
          "type": "string"
        },
        "request_model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Request Model",
          "type": "string"
        },
        "accepted_response_models": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Accepted Response Models",
          "type": "array"
        },
        "implementation_digest": {
          "default": "9669fdd792b50dedeba699124f2ca9c1022e0b6608b0e89040f657e71e4ea2cc",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Implementation Digest",
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/AgentProviderCodecLimits"
        }
      },
      "required": [
        "codec_id",
        "provider_id",
        "request_model",
        "accepted_response_models"
      ],
      "title": "ProfileCandidateRecommendationCodecRegistration",
      "type": "object"
    },
    "WorkerRole": {
      "enum": [
        "scope_interpreter",
        "source_mapper",
        "hypothesis",
        "analyzer",
        "validator",
        "critic",
        "reporter"
      ],
      "title": "WorkerRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile_preparation_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Preparation Id",
      "type": "string"
    },
    "flow_snapshot_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Flow Snapshot Digest",
      "type": "string"
    },
    "provider_profile_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Provider Profile Digest",
      "type": "string"
    },
    "registration": {
      "$ref": "#/$defs/AgentModelRegistration"
    },
    "admission": {
      "$ref": "#/$defs/AgentProviderTransportAdmission"
    },
    "credential_reference": {
      "$ref": "#/$defs/ModelCredentialReference"
    },
    "codec": {
      "$ref": "#/$defs/ProfileCandidateRecommendationCodecRegistration"
    }
  },
  "required": [
    "profile_preparation_id",
    "flow_snapshot_digest",
    "provider_profile_digest",
    "registration",
    "admission",
    "credential_reference",
    "codec"
  ],
  "title": "RoutedCandidateRecommendationProviderConfig",
  "type": "object"
}
