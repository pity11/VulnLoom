{
  "$defs": {
    "EvidenceReplayValidationLimits": {
      "additionalProperties": false,
      "properties": {
        "max_evidence_refs": {
          "default": 2,
          "maximum": 2,
          "minimum": 2,
          "title": "Max Evidence Refs",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 10.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "title": "EvidenceReplayValidationLimits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "requirement_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Requirement Id",
      "type": "string"
    },
    "baseline_materialization_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Baseline Materialization Plan Id",
      "type": "string"
    },
    "baseline_materialization_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Baseline Materialization Id",
      "type": "string"
    },
    "baseline_flow_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Baseline Flow Plan Id",
      "type": "string"
    },
    "baseline_observation_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Baseline Observation Id",
      "type": "string"
    },
    "baseline_snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Baseline Snapshot Id",
      "type": "string"
    },
    "current_materialization_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Current Materialization Plan Id",
      "type": "string"
    },
    "current_materialization_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Current Materialization Id",
      "type": "string"
    },
    "current_flow_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Current Flow Plan Id",
      "type": "string"
    },
    "current_observation_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Current Observation Id",
      "type": "string"
    },
    "current_snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Current Snapshot Id",
      "type": "string"
    },
    "requested_url_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Requested Url Digest",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Evidence Refs",
      "type": "array"
    },
    "target_id": {
      "format": "uuid",
      "title": "Target Id",
      "type": "string"
    },
    "target_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Target Version",
      "type": "string"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_version": {
      "minimum": 1,
      "title": "Scope Version",
      "type": "integer"
    },
    "ruleset_digest": {
      "const": "3acc89b52fdc774b83cd49f48e872a7abd70a3acf3774dd6db4ec9f665173d89",
      "default": "3acc89b52fdc774b83cd49f48e872a7abd70a3acf3774dd6db4ec9f665173d89",
      "title": "Ruleset Digest",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/EvidenceReplayValidationLimits"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "requirement_id",
    "baseline_materialization_plan_id",
    "baseline_materialization_id",
    "baseline_flow_plan_id",
    "baseline_observation_id",
    "baseline_snapshot_id",
    "current_materialization_plan_id",
    "current_materialization_id",
    "current_flow_plan_id",
    "current_observation_id",
    "current_snapshot_id",
    "requested_url_digest",
    "evidence_refs",
    "target_id",
    "target_version",
    "scope_id",
    "scope_version",
    "limits",
    "created_at",
    "deadline",
    "idempotency_key"
  ],
  "title": "EvidenceReplayValidationPlan",
  "type": "object"
}
