{
  "$defs": {
    "ApprovalAction": {
      "enum": [
        "run_validation",
        "run_critic",
        "run_untrusted_build",
        "mutate_target_state",
        "use_real_credentials",
        "external_callback",
        "submit_report",
        "review_report",
        "export_report",
        "execute_red_team_action"
      ],
      "title": "ApprovalAction",
      "type": "string"
    },
    "ImpactClass": {
      "enum": [
        "read_only",
        "state_change",
        "real_credential",
        "external_callback",
        "lateral_movement",
        "persistence"
      ],
      "title": "ImpactClass",
      "type": "string"
    },
    "RedTeamActionKind": {
      "enum": [
        "dns_lookup",
        "tls_inspect",
        "http_head"
      ],
      "title": "RedTeamActionKind",
      "type": "string"
    },
    "RedTeamReconAction": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Action Id",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Id",
          "type": "string"
        },
        "expected_checkpoint_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Checkpoint Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RedTeamActionKind"
        },
        "target_url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Target Url",
          "type": "string"
        },
        "test_class": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Test Class",
          "type": "string"
        },
        "impact": {
          "$ref": "#/$defs/ImpactClass",
          "default": "read_only"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "deadline": {
          "format": "date-time",
          "title": "Deadline",
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "plan_id",
        "expected_checkpoint_id",
        "kind",
        "target_url",
        "test_class",
        "created_at",
        "deadline",
        "idempotency_key"
      ],
      "title": "RedTeamReconAction",
      "type": "object"
    },
    "RedTeamReconCommand": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Command Id",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/RedTeamReconAction"
        },
        "attempt": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        }
      },
      "required": [
        "command_id",
        "action"
      ],
      "title": "RedTeamReconCommand",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Control-plane admission for exactly one re-sealed next action.",
  "properties": {
    "admission_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Admission Id",
      "type": "string"
    },
    "proposal_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proposal Id",
      "type": "string"
    },
    "tool_view_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Tool View Id",
      "type": "string"
    },
    "flow_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Flow Plan Id",
      "type": "string"
    },
    "source_checkpoint_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Checkpoint Id",
      "type": "string"
    },
    "source_observation_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Source Observation Ids",
      "type": "array"
    },
    "command": {
      "$ref": "#/$defs/RedTeamReconCommand"
    },
    "policy_request_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Request Digest",
      "type": "string"
    },
    "required_approval_action": {
      "$ref": "#/$defs/ApprovalAction",
      "default": "execute_red_team_action"
    },
    "required_approval_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Required Approval Digest",
      "type": "string"
    },
    "admitted_at": {
      "format": "date-time",
      "title": "Admitted At",
      "type": "string"
    }
  },
  "required": [
    "admission_id",
    "proposal_id",
    "tool_view_id",
    "flow_plan_id",
    "source_checkpoint_id",
    "source_observation_ids",
    "command",
    "policy_request_digest",
    "required_approval_digest",
    "admitted_at"
  ],
  "title": "RedTeamReplanAdmission",
  "type": "object"
}
