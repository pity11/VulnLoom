{
  "$defs": {
    "AnalyzerExclusion": {
      "additionalProperties": false,
      "properties": {
        "source_ref_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Ref Digest",
          "type": "string"
        },
        "reason_code": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "source_ref_digest",
        "reason_code"
      ],
      "title": "AnalyzerExclusion",
      "type": "object"
    },
    "AnalyzerImportOutcome": {
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "observation_set": {
          "$ref": "#/$defs/AnalyzerObservationSet"
        },
        "artifact": {
          "$ref": "#/$defs/AnalyzerObservationArtifact"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "snapshot_id",
        "observation_set",
        "artifact",
        "completed_at"
      ],
      "title": "AnalyzerImportOutcome",
      "type": "object"
    },
    "AnalyzerKind": {
      "enum": [
        "codeql",
        "trivy",
        "checkov",
        "kubesec"
      ],
      "title": "AnalyzerKind",
      "type": "string"
    },
    "AnalyzerLocation": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "start_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Line"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "start_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Column"
        },
        "end_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Column"
        }
      },
      "required": [
        "path"
      ],
      "title": "AnalyzerLocation",
      "type": "object"
    },
    "AnalyzerObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Id",
          "type": "string"
        },
        "analyzer": {
          "$ref": "#/$defs/AnalyzerKind"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "target_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        },
        "rule_id_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rule Id Digest",
          "type": "string"
        },
        "rule_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rule Fingerprint",
          "type": "string"
        },
        "cwes": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Cwes",
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/AnalyzerSeverity"
        },
        "message_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Message Digest",
          "type": "string"
        },
        "locations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AnalyzerLocation"
          },
          "title": "Locations",
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "analyzer",
        "target_id",
        "target_version",
        "rule_id_digest",
        "rule_fingerprint",
        "cwes",
        "severity",
        "message_digest"
      ],
      "title": "AnalyzerObservation",
      "type": "object"
    },
    "AnalyzerObservationArtifact": {
      "additionalProperties": false,
      "properties": {
        "observation_set_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Set Id",
          "type": "string"
        },
        "json_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Json Sha256",
          "type": "string"
        },
        "json_ref": {
          "pattern": "^objects/[0-9a-f]{64}/observations\\.json$",
          "title": "Json Ref",
          "type": "string"
        }
      },
      "required": [
        "observation_set_id",
        "json_sha256",
        "json_ref"
      ],
      "title": "AnalyzerObservationArtifact",
      "type": "object"
    },
    "AnalyzerObservationSet": {
      "additionalProperties": false,
      "properties": {
        "observation_set_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Set Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "snapshot_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Digest",
          "type": "string"
        },
        "adapter_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Adapter Digest",
          "type": "string"
        },
        "analyzer": {
          "$ref": "#/$defs/AnalyzerKind"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "target_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        },
        "observations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AnalyzerObservation"
          },
          "title": "Observations",
          "type": "array"
        },
        "exclusions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AnalyzerExclusion"
          },
          "title": "Exclusions",
          "type": "array"
        }
      },
      "required": [
        "observation_set_id",
        "snapshot_id",
        "snapshot_digest",
        "adapter_id",
        "adapter_digest",
        "analyzer",
        "target_id",
        "target_version"
      ],
      "title": "AnalyzerObservationSet",
      "type": "object"
    },
    "AnalyzerResultFile": {
      "additionalProperties": false,
      "properties": {
        "logical_name": {
          "pattern": "^(output|cwe-map)\\.json$",
          "title": "Logical Name",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "logical_name",
        "size",
        "sha256"
      ],
      "title": "AnalyzerResultFile",
      "type": "object"
    },
    "AnalyzerResultSnapshot": {
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "analyzer": {
          "$ref": "#/$defs/AnalyzerKind"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "target_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        },
        "tool_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
          "title": "Tool Version",
          "type": "string"
        },
        "rules_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rules Digest",
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/AnalyzerResultFile"
        },
        "cwe_map": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalyzerResultFile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "snapshot_id",
        "analyzer",
        "target_id",
        "target_version",
        "tool_version",
        "rules_digest",
        "output"
      ],
      "title": "AnalyzerResultSnapshot",
      "type": "object"
    },
    "AnalyzerSeverity": {
      "enum": [
        "unknown",
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "AnalyzerSeverity",
      "type": "string"
    },
    "CleanupReport": {
      "additionalProperties": false,
      "properties": {
        "processes_terminated": {
          "title": "Processes Terminated",
          "type": "boolean"
        },
        "network_released": {
          "title": "Network Released",
          "type": "boolean"
        },
        "writable_layer_removed": {
          "title": "Writable Layer Removed",
          "type": "boolean"
        },
        "temporary_mounts_removed": {
          "title": "Temporary Mounts Removed",
          "type": "boolean"
        }
      },
      "required": [
        "processes_terminated",
        "network_released",
        "writable_layer_removed",
        "temporary_mounts_removed"
      ],
      "title": "CleanupReport",
      "type": "object"
    },
    "DockerAnalyzerExecutionStatus": {
      "enum": [
        "completed",
        "failed",
        "timed_out",
        "cancelled"
      ],
      "title": "DockerAnalyzerExecutionStatus",
      "type": "string"
    },
    "RunnerCheckpoint": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checkpoint Id",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "target_version": {
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "scope_version": {
          "minimum": 1,
          "title": "Scope Version",
          "type": "integer"
        },
        "policy_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "sandbox_profile_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sandbox Profile Digest",
          "type": "string"
        },
        "invocation_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Invocation Digest",
          "type": "string"
        },
        "attempt": {
          "maximum": 3,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        }
      },
      "required": [
        "checkpoint_id",
        "task_id",
        "target_id",
        "target_version",
        "scope_id",
        "scope_version",
        "policy_digest",
        "sandbox_profile_digest",
        "invocation_digest",
        "attempt"
      ],
      "title": "RunnerCheckpoint",
      "type": "object"
    },
    "SandboxOutput": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Id",
          "type": "string"
        },
        "logical_name": {
          "pattern": "^output\\.json$",
          "title": "Logical Name",
          "type": "string"
        },
        "size": {
          "exclusiveMinimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "content_ref": {
          "pattern": "^objects/[0-9a-f]{64}/output\\.json$",
          "title": "Content Ref",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "logical_name",
        "size",
        "sha256",
        "content_ref"
      ],
      "title": "SandboxOutput",
      "type": "object"
    },
    "SandboxRunResult": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SandboxRunStatus"
        },
        "sandbox_profile_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sandbox Profile Digest",
          "type": "string"
        },
        "invocation_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Invocation Digest",
          "type": "string"
        },
        "budget_used": {
          "$ref": "#/$defs/TaskBudget"
        },
        "usage": {
          "$ref": "#/$defs/SandboxUsage"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "outputs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SandboxOutput"
          },
          "title": "Outputs",
          "type": "array"
        },
        "checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunnerCheckpoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Error Codes",
          "type": "array"
        },
        "cleanup": {
          "$ref": "#/$defs/CleanupReport"
        }
      },
      "required": [
        "run_id",
        "task_id",
        "status",
        "sandbox_profile_digest",
        "invocation_digest",
        "budget_used",
        "usage",
        "cleanup"
      ],
      "title": "SandboxRunResult",
      "type": "object"
    },
    "SandboxRunStatus": {
      "enum": [
        "completed",
        "checkpointed",
        "failed",
        "timed_out",
        "cancelled"
      ],
      "title": "SandboxRunStatus",
      "type": "string"
    },
    "SandboxUsage": {
      "additionalProperties": false,
      "properties": {
        "wall_seconds": {
          "minimum": 0,
          "title": "Wall Seconds",
          "type": "number"
        },
        "cpu_millis": {
          "minimum": 0,
          "title": "Cpu Millis",
          "type": "integer"
        },
        "peak_memory_bytes": {
          "minimum": 0,
          "title": "Peak Memory Bytes",
          "type": "integer"
        },
        "pids_peak": {
          "minimum": 0,
          "title": "Pids Peak",
          "type": "integer"
        },
        "open_files_peak": {
          "minimum": 0,
          "title": "Open Files Peak",
          "type": "integer"
        },
        "output_bytes": {
          "minimum": 0,
          "title": "Output Bytes",
          "type": "integer"
        },
        "temporary_bytes": {
          "minimum": 0,
          "title": "Temporary Bytes",
          "type": "integer"
        }
      },
      "required": [
        "wall_seconds",
        "cpu_millis",
        "peak_memory_bytes",
        "pids_peak",
        "open_files_peak",
        "output_bytes",
        "temporary_bytes"
      ],
      "title": "SandboxUsage",
      "type": "object"
    },
    "TaskBudget": {
      "additionalProperties": false,
      "properties": {
        "wall_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Wall Seconds",
          "type": "integer"
        },
        "model_tokens": {
          "minimum": 0,
          "title": "Model Tokens",
          "type": "integer"
        },
        "tool_calls": {
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        }
      },
      "required": [
        "wall_seconds",
        "model_tokens",
        "tool_calls"
      ],
      "title": "TaskBudget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "registration_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Registration Id",
      "type": "string"
    },
    "target_id": {
      "format": "uuid",
      "title": "Target Id",
      "type": "string"
    },
    "target_version": {
      "title": "Target Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/DockerAnalyzerExecutionStatus"
    },
    "runner_result": {
      "$ref": "#/$defs/SandboxRunResult"
    },
    "analyzer_result_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalyzerResultSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "import_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalyzerImportOutcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "registration_id",
    "target_id",
    "target_version",
    "status",
    "runner_result",
    "completed_at"
  ],
  "title": "DockerAnalyzerExecutionOutcome",
  "type": "object"
}
