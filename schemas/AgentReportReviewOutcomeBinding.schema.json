      "title": "Approval Id",
      "type": "string"
    },
    "approval_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approval Digest",
      "type": "string"
    },
    "review_intake_record_id": {
      "pattern": "^[0-9a-f]{64}$",
