        "changes_requested",
        "rejected",
        "human_approved",
        "exported",
        "submitted"
      ],
      "title": "ReportReviewStatus",
      "type": "string"
    },
    "ReviewDecisionKind": {
      "enum": [
        "approve",
        "request_changes",
        "reject"
