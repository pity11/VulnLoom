{
  "$defs": {
    "HybridConclusion": {
      "enum": [
        "confirmed",
        "remediated"
      ],
      "title": "HybridConclusion",
      "type": "string"
    },
    "HybridReleaseGatePolicy": {
      "additionalProperties": false,
      "properties": {
        "required_conclusion": {
          "$ref": "#/$defs/HybridConclusion",
          "default": "remediated"
        },
        "timeout_seconds": {
          "default": 10.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 3,
          "minimum": 3,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "title": "HybridReleaseGatePolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "hybrid_chain_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Hybrid Chain Id",
      "type": "string"
    },
    "hybrid_chain_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Hybrid Chain Digest",
      "type": "string"
    },
    "deployment_proof_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Deployment Proof Id",
      "type": "string"
    },
    "deployment_proof_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Deployment Proof Digest",
      "type": "string"
    },
    "source_target_id": {
      "format": "uuid",
      "title": "Source Target Id",
      "type": "string"
    },
    "source_target_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Source Target Version",
      "type": "string"
    },
    "source_manifest_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Manifest Digest",
      "type": "string"
    },
    "live_target_id": {
      "format": "uuid",
      "title": "Live Target Id",
      "type": "string"
    },
    "endpoint_url_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Endpoint Url Digest",
      "type": "string"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_version": {
      "minimum": 1,
      "title": "Scope Version",
      "type": "integer"
    },
    "scope_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scope Digest",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/HybridReleaseGatePolicy"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "hybrid_chain_id",
    "hybrid_chain_digest",
    "deployment_proof_id",
    "deployment_proof_digest",
    "source_target_id",
    "source_target_version",
    "source_manifest_digest",
    "live_target_id",
    "endpoint_url_digest",
    "scope_id",
    "scope_version",
    "scope_digest",
    "policy",
    "created_at",
    "deadline",
    "idempotency_key"
  ],
  "title": "HybridReleaseGatePlan",
  "type": "object"
}
