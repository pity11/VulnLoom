{
  "$defs": {
    "AttackSurfaceSnapshot": {
      "additionalProperties": false,
      "description": "Redacted, content-addressed facts produced by one trusted Recon action.",
      "properties": {
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Id",
          "type": "string"
        },
        "action_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Action Id",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "scope_version": {
          "minimum": 1,
          "title": "Scope Version",
          "type": "integer"
        },
        "requested_url_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Requested Url Digest",
          "type": "string"
        },
        "final_url_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Final Url Digest",
          "type": "string"
        },
        "status_code": {
          "maximum": 599,
          "minimum": 100,
          "title": "Status Code",
          "type": "integer"
        },
        "peer_ip": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Peer Ip",
          "type": "string"
        },
        "redirect_count": {
          "maximum": 5,
          "minimum": 0,
          "title": "Redirect Count",
          "type": "integer"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "policy_record_digests": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Policy Record Digests",
          "type": "array"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "plan_id",
        "action_id",
        "target_id",
        "scope_id",
        "scope_version",
        "requested_url_digest",
        "final_url_digest",
        "status_code",
        "peer_ip",
        "redirect_count",
        "evidence_refs",
        "policy_record_digests",
        "captured_at"
      ],
      "title": "AttackSurfaceSnapshot",
      "type": "object"
    },
    "ReconOutcome": {
      "enum": [
        "succeeded",
        "rejected",
        "timed_out",
        "failed"
      ],
      "title": "ReconOutcome",
      "type": "string"
    },
    "ServiceIdentitySnapshot": {
      "additionalProperties": false,
      "description": "Redacted identity facts from one CA- and hostname-verified TLS session.",
      "properties": {
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Id",
          "type": "string"
        },
        "action_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Action Id",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "scope_version": {
          "minimum": 1,
          "title": "Scope Version",
          "type": "integer"
        },
        "endpoint_url_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Endpoint Url Digest",
          "type": "string"
        },
        "peer_ip": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Peer Ip",
          "type": "string"
        },
        "tls_version": {
          "$ref": "#/$defs/ServiceTlsVersion"
        },
        "cipher_suite": {
          "pattern": "^[A-Z0-9_-]{1,128}$",
          "title": "Cipher Suite",
          "type": "string"
        },
        "cipher_bits": {
          "maximum": 1024,
          "minimum": 112,
          "title": "Cipher Bits",
          "type": "integer"
        },
        "leaf_certificate_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Leaf Certificate Sha256",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "policy_record_digests": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Policy Record Digests",
          "type": "array"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "plan_id",
        "action_id",
        "target_id",
        "scope_id",
        "scope_version",
        "endpoint_url_digest",
        "peer_ip",
        "tls_version",
        "cipher_suite",
        "cipher_bits",
        "leaf_certificate_sha256",
        "evidence_refs",
        "policy_record_digests",
        "captured_at"
      ],
      "title": "ServiceIdentitySnapshot",
      "type": "object"
    },
    "ServiceTlsVersion": {
      "enum": [
        "TLSv1.2",
        "TLSv1.3"
      ],
      "title": "ServiceTlsVersion",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "observation_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Observation Id",
      "type": "string"
    },
    "action_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Action Id",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/ReconOutcome"
    },
    "status_code": {
      "anyOf": [
        {
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status Code"
    },
    "reason_code": {
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Reason Code",
      "type": "string"
    },
    "cleanup_complete": {
      "title": "Cleanup Complete",
      "type": "boolean"
    },
    "sensitive_data_redacted": {
      "default": true,
      "title": "Sensitive Data Redacted",
      "type": "boolean"
    },
    "attack_surface": {
      "anyOf": [
        {
          "$ref": "#/$defs/AttackSurfaceSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "service_identity": {
      "anyOf": [
        {
          "$ref": "#/$defs/ServiceIdentitySnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    }
  },
  "required": [
    "observation_id",
    "action_id",
    "outcome",
    "reason_code",
    "cleanup_complete",
    "observed_at"
  ],
  "title": "RedTeamReconObservation",
  "type": "object"
}
