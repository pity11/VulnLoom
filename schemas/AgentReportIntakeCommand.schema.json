{
  "$defs": {
    "AgentReportIntakeDecision": {
      "enum": [
        "accept",
        "reject",
        "defer"
      ],
      "title": "AgentReportIntakeDecision",
      "type": "string"
    },
    "AgentReportIntakeReason": {
      "enum": [
        "human_accepted_exact_draft",
        "human_rejected",
        "human_deferred"
      ],
      "title": "AgentReportIntakeReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "command_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Command Id",
      "type": "string"
    },
    "intake_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Intake Plan Id",
      "type": "string"
    },
    "intake_plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Intake Plan Digest",
      "type": "string"
    },
    "finding_promotion_outcome_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Finding Promotion Outcome Id",
      "type": "string"
    },
    "report_draft_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Draft Plan Id",
      "type": "string"
    },
    "report_draft_plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Draft Plan Digest",
      "type": "string"
    },
    "report_family_id": {
      "format": "uuid",
      "title": "Report Family Id",
      "type": "string"
    },
    "report_version": {
      "minimum": 1,
      "title": "Report Version",
      "type": "integer"
    },
    "finding_id": {
      "format": "uuid",
      "title": "Finding Id",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/AgentReportIntakeDecision"
    },
    "reason_code": {
      "$ref": "#/$defs/AgentReportIntakeReason"
    },
    "reviewer": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Reviewer",
      "type": "string"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    }
  },
  "required": [
    "command_id",
    "intake_plan_id",
    "intake_plan_digest",
    "finding_promotion_outcome_id",
    "report_draft_plan_id",
    "report_draft_plan_digest",
    "report_family_id",
    "report_version",
    "finding_id",
    "decision",
    "reason_code",
    "reviewer",
    "decided_at"
  ],
  "title": "AgentReportIntakeCommand",
  "type": "object"
}
