{
  "$defs": {
    "AttackAction": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Action Id",
          "type": "string"
        },
        "flow_plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Flow Plan Id",
          "type": "string"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "scope_version": {
          "minimum": 1,
          "title": "Scope Version",
          "type": "integer"
        },
        "ordinal": {
          "maximum": 32,
          "minimum": 1,
          "title": "Ordinal",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/AttackActionKind"
        },
        "phase": {
          "$ref": "#/$defs/RedTeamPhase"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "target_path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Target Path",
          "type": "string"
        },
        "test_class": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Test Class",
          "type": "string"
        },
        "impact": {
          "$ref": "#/$defs/AttackImpact"
        },
        "prerequisite_action_ids": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Prerequisite Action Ids",
          "type": "array"
        },
        "objective_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Objective Id",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "flow_plan_id",
        "scope_id",
        "scope_version",
        "ordinal",
        "kind",
        "phase",
        "target_id",
        "target_path",
        "test_class",
        "impact",
        "objective_id"
      ],
      "title": "AttackAction",
      "type": "object"
    },
    "AttackActionKind": {
      "enum": [
        "initial_access_attempt",
        "verify_test_session",
        "verify_objective",
        "cleanup_test_session"
      ],
      "title": "AttackActionKind",
      "type": "string"
    },
    "AttackGraph": {
      "additionalProperties": false,
      "properties": {
        "graph_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Graph Id",
          "type": "string"
        },
        "flow_plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Flow Plan Id",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "scope_version": {
          "minimum": 1,
          "title": "Scope Version",
          "type": "integer"
        },
        "objective": {
          "$ref": "#/$defs/AttackObjective"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/AttackAction"
          },
          "maxItems": 32,
          "minItems": 3,
          "title": "Actions",
          "type": "array"
        }
      },
      "required": [
        "graph_id",
        "flow_plan_id",
        "target_id",
        "scope_id",
        "scope_version",
        "objective",
        "actions"
      ],
      "title": "AttackGraph",
      "type": "object"
    },
    "AttackImpact": {
      "enum": [
        "read_only",
        "state_change"
      ],
      "title": "AttackImpact",
      "type": "string"
    },
    "AttackObjective": {
      "additionalProperties": false,
      "properties": {
        "objective_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Objective Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AttackObjectiveKind"
        },
        "evidence_requirement": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Evidence Requirement",
          "type": "string"
        }
      },
      "required": [
        "objective_id",
        "kind",
        "evidence_requirement"
      ],
      "title": "AttackObjective",
      "type": "object"
    },
    "AttackObjectiveKind": {
      "enum": [
        "establish_test_session",
        "prove_protected_resource_access"
      ],
      "title": "AttackObjectiveKind",
      "type": "string"
    },
    "RedTeamPhase": {
      "enum": [
        "recon",
        "initial_access",
        "validation",
        "post_exploitation"
      ],
      "title": "RedTeamPhase",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chain_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Chain Plan Id",
      "type": "string"
    },
    "graph": {
      "$ref": "#/$defs/AttackGraph"
    },
    "expected_flow_checkpoint_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Flow Checkpoint Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "max_failures": {
      "default": 1,
      "maximum": 3,
      "minimum": 1,
      "title": "Max Failures",
      "type": "integer"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "chain_plan_id",
    "graph",
    "expected_flow_checkpoint_id",
    "created_at",
    "deadline",
    "idempotency_key"
  ],
  "title": "AttackChainPlan",
  "type": "object"
}
