{
  "$defs": {
    "BusinessInvariantLimits": {
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "default": 10.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "title": "BusinessInvariantLimits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_version": {
      "minimum": 1,
      "title": "Scope Version",
      "type": "integer"
    },
    "target_id": {
      "format": "uuid",
      "title": "Target Id",
      "type": "string"
    },
    "target_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Digest",
      "type": "string"
    },
    "session_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Session Plan Id",
      "type": "string"
    },
    "fixture_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fixture Id",
      "type": "string"
    },
    "resource_ref": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Resource Ref",
      "type": "string"
    },
    "actor_identity_ref": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Actor Identity Ref",
      "type": "string"
    },
    "actor_role_ref": {
      "pattern": "^role:[a-zA-Z0-9._-]{1,200}$",
      "title": "Actor Role Ref",
      "type": "string"
    },
    "action_intent_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Action Intent Digest",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/BusinessInvariantLimits"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "candidate_authorized": {
      "const": false,
      "default": false,
      "title": "Candidate Authorized",
      "type": "boolean"
    },
    "finding_authorized": {
      "const": false,
      "default": false,
      "title": "Finding Authorized",
      "type": "boolean"
    },
    "submission_authorized": {
      "const": false,
      "default": false,
      "title": "Submission Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "plan_id",
    "scope_id",
    "scope_version",
    "target_id",
    "target_digest",
    "session_plan_id",
    "fixture_id",
    "resource_ref",
    "actor_identity_ref",
    "actor_role_ref",
    "action_intent_digest",
    "limits",
    "created_at",
    "deadline",
    "idempotency_key"
  ],
  "title": "BusinessInvariantPlan",
  "type": "object"
}
