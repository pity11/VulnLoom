    "recommendation": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateRecommendation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "producer_content_binding_verified": {
      "title": "Producer Content Binding Verified",
      "type": "boolean"
    },
    "eligible_for_validation_intake": {
      "const": false,
      "default": false,
      "title": "Eligible For Validation Intake",
      "type": "boolean"
    }
  },
  "required": [
    "outcome_id",
    "plan_id",
    "status",
    "projection_id",
    "transport",
    "producer_content_binding_verified"
  ],
  "title": "CandidateRecommendationGenerationOutcome",
  "type": "object"
}
