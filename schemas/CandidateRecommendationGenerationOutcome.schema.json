{
  "$defs": {
    "CandidateRecommendation": {
      "additionalProperties": false,
      "properties": {
        "recommendation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Recommendation Id",
          "type": "string"
        },
        "candidate_set_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Set Id",
          "type": "string"
        },
        "candidate_id": {
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "candidate_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Digest",
          "type": "string"
        },
        "source_graph_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Graph Id",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "target_version_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Target Version Digest",
          "type": "string"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "scope_version": {
          "minimum": 1,
          "title": "Scope Version",
          "type": "integer"
        },
        "supporting_signal_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Supporting Signal Ids",
          "type": "array"
        },
        "cited_locations": {
          "items": {
            "$ref": "#/$defs/SourceLocation"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Cited Locations",
          "type": "array"
        },
        "priority": {
          "$ref": "#/$defs/RecommendationPriority"
        },
        "rationale": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "review_questions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Review Questions",
          "type": "array"
        },
        "producer_protocol": {
          "const": "candidate-recommendation-v1",
          "default": "candidate-recommendation-v1",
          "title": "Producer Protocol",
          "type": "string"
        },
        "producer_protocol_digest": {
          "default": "7da7544650770882a39b71d526f18f6c64b7a3a8c22f9d40a27349e745777a75",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Producer Protocol Digest",
          "type": "string"
        },
        "producer_result_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Producer Result Id",
          "type": "string"
        },
        "producer_plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Producer Plan Id",
          "type": "string"
        },
        "producer_receipt_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Producer Receipt Digest",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "requires_human_review": {
          "const": true,
          "default": true,
          "title": "Requires Human Review",
          "type": "boolean"
        }
      },
      "required": [
        "recommendation_id",
        "candidate_set_id",
        "candidate_id",
        "candidate_digest",
        "source_graph_id",
        "target_id",
        "target_version_digest",
        "scope_id",
        "scope_version",
        "supporting_signal_ids",
        "cited_locations",
        "priority",
        "rationale",
        "producer_result_id",
        "producer_plan_id",
        "producer_receipt_digest",
        "created_at"
      ],
      "title": "CandidateRecommendation",
      "type": "object"
    },
    "CandidateRecommendationResponse": {
      "additionalProperties": false,
      "properties": {
        "projection_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Projection Id",
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/RecommendationPriority"
        },
        "rationale": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "review_questions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Review Questions",
          "type": "array"
        },
        "cited_location_indexes": {
          "items": {
            "type": "integer"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Cited Location Indexes",
          "type": "array"
        }
      },
      "required": [
        "projection_id",
        "priority",
        "rationale",
        "cited_location_indexes"
      ],
      "title": "CandidateRecommendationResponse",
      "type": "object"
    },
    "MetricIssue": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "time_per_output_token_ms",
            "time_to_first_token_ms",
            "tokens_per_second"
          ],
          "title": "Field",
          "type": "string"
        },
        "reason": {
          "enum": [
            "type",
            "non_finite",
            "negative",
            "above_limit"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "field",
        "reason"
      ],
      "title": "MetricIssue",
      "type": "object"
    },
    "ModelInvocationResult": {
      "additionalProperties": false,
      "properties": {
        "result_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Id",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Id",
          "type": "string"
        },
        "provider_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Provider Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "rejected",
            "timed_out"
          ],
          "title": "Status",
          "type": "string"
        },
        "input_tokens": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "maximum": 65536,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "process_started": {
          "title": "Process Started",
          "type": "boolean"
        },
        "cleanup_verified": {
          "title": "Cleanup Verified",
          "type": "boolean"
        },
        "attempt_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attempt Digest"
        },
        "receipt_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Receipt Digest"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "diagnostic": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderDiagnostic"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "response_model": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/+-]{0,255}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Model"
        }
      },
      "required": [
        "result_id",
        "plan_id",
        "provider_id",
        "status",
        "input_tokens",
        "output_tokens",
        "process_started",
        "cleanup_verified",
        "attempt_digest",
        "receipt_digest",
        "completed_at"
      ],
      "title": "ModelInvocationResult",
      "type": "object"
    },
    "ProviderDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "metric_issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MetricIssue"
          },
          "maxItems": 3,
          "title": "Metric Issues",
          "type": "array"
        },
        "usage_key_observations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UsageKeyObservation"
          },
          "maxItems": 32,
          "title": "Usage Key Observations",
          "type": "array"
        },
        "usage_keys_truncated": {
          "default": false,
          "title": "Usage Keys Truncated",
          "type": "boolean"
        },
        "content_classification": {
          "anyOf": [
            {
              "enum": [
                "response_content_type",
                "response_content_exact",
                "response_content_trimmed_match",
                "response_content_casefold_match",
                "response_content_punctuation_match",
                "response_content_empty",
                "response_content_other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Classification"
        },
        "content_shape_observations": {
          "default": [],
          "items": {
            "enum": [
              "recommendation_json_invalid",
              "recommendation_root_type",
              "recommendation_missing_fields",
              "recommendation_extra_fields",
              "recommendation_projection_id_type",
              "recommendation_projection_id_mismatch",
              "recommendation_priority_type",
              "recommendation_priority_value",
              "recommendation_rationale_type",
              "recommendation_rationale_empty",
              "recommendation_rationale_over_budget",
              "recommendation_rationale_untrimmed",
              "recommendation_rationale_unsafe",
              "recommendation_questions_type",
              "recommendation_questions_count",
              "recommendation_question_item_type",
              "recommendation_question_unsafe",
              "recommendation_indexes_type",
              "recommendation_indexes_count",
              "recommendation_index_item_type",
              "recommendation_indexes_order_or_duplicate",
              "recommendation_index_out_of_range"
            ],
            "type": "string"
          },
          "maxItems": 32,
          "title": "Content Shape Observations",
          "type": "array"
        },
        "shape_observations": {
          "default": [],
          "items": {
            "enum": [
              "root_prompt_logprobs_null",
              "root_prompt_logprobs_non_null",
              "root_kv_transfer_params_null",
              "root_kv_transfer_params_non_null",
              "root_prompt_token_ids_null",
              "root_prompt_token_ids_non_null",
              "root_prompt_text_null",
              "root_prompt_text_non_null",
              "root_ec_transfer_params_null",
              "root_ec_transfer_params_non_null",
              "root_metrics_null",
              "root_metrics_non_null",
              "root_other_fields",
              "message_tool_calls_null",
              "message_tool_calls_non_null",
              "message_function_call_null",
              "message_function_call_non_null",
              "message_annotations_null",
              "message_annotations_non_null",
              "message_audio_null",
              "message_audio_non_null",
              "message_reasoning_null",
              "message_reasoning_non_null",
              "message_other_fields",
              "choice_stop_reason_null",
              "choice_stop_reason_non_null",
              "choice_token_ids_null",
              "choice_token_ids_non_null",
              "choice_routed_experts_null",
              "choice_routed_experts_non_null",
              "choice_other_fields",
              "usage_prompt_tokens_details_null",
              "usage_prompt_tokens_details_non_null",
              "usage_prompt_cache_hit_tokens_null",
              "usage_prompt_cache_hit_tokens_non_null",
              "usage_prompt_cache_miss_tokens_null",
              "usage_prompt_cache_miss_tokens_non_null",
              "usage_time_per_output_token_ms_null",
              "usage_time_per_output_token_ms_non_null",
              "usage_time_to_first_token_ms_null",
              "usage_time_to_first_token_ms_non_null",
              "usage_tokens_per_second_null",
              "usage_tokens_per_second_non_null",
              "usage_other_fields",
              "usage_completion_tokens_details_null",
              "usage_completion_tokens_details_non_null",
              "usage_reasoning_tokens_null",
              "usage_reasoning_tokens_non_null",
              "usage_cached_tokens_null",
              "usage_cached_tokens_non_null",
              "prompt_details_cached_tokens",
              "completion_details_reasoning_tokens",
              "prompt_details_other_fields",
              "completion_details_other_fields"
            ],
            "type": "string"
          },
          "maxItems": 32,
          "title": "Shape Observations",
          "type": "array"
        },
        "failure_stage": {
          "anyOf": [
            {
              "enum": [
                "transport_process",
                "http_status",
                "response_codec"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failure Stage"
        },
        "error_code": {
          "anyOf": [
            {
              "enum": [
                "transport_rejected",
                "tls_failed",
                "connect_failed",
                "http_non_200",
                "response_headers_rejected",
                "response_empty",
                "response_size_exceeded",
                "transport_timeout",
                "response_identity_mismatch",
                "response_shape_mismatch",
                "response_content_mismatch",
                "usage_mismatch",
                "codec_timeout"
              ],
              "type": "string"
            },
            {
              "enum": [
                "response_content_type",
                "response_content_exact",
                "response_content_trimmed_match",
                "response_content_casefold_match",
                "response_content_punctuation_match",
                "response_content_empty",
                "response_content_other"
              ],
              "type": "string"
            },
            {
              "enum": [
                "usage_total_mismatch",
                "usage_unknown_fields",
                "usage_details_mismatch",
                "usage_cache_mismatch",
                "usage_metrics_mismatch"
              ],
              "type": "string"
            },
            {
              "enum": [
                "response_root_extension_nonempty",
                "response_choice_extension_nonempty",
                "response_message_extension_nonempty",
                "response_json_invalid",
                "response_over_budget",
                "response_root_type",
                "response_root_missing_fields",
                "response_root_extra_fields",
                "response_root_metadata",
                "response_choices_type",
                "response_choices_count",
                "response_choice_type",
                "response_choice_missing_fields",
                "response_choice_extra_fields",
                "response_choice_index",
                "response_choice_finish_reason",
                "response_choice_logprobs",
                "response_message_type",
                "response_message_missing_fields",
                "response_message_extra_fields",
                "response_message_null_tool_calls",
                "response_message_null_function_call",
                "response_message_null_call_fields",
                "response_message_role",
                "response_message_refusal",
                "response_message_reasoning_type"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error Code"
        },
        "http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "network_opened": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Network Opened"
        },
        "captured_response_bytes": {
          "default": 0,
          "maximum": 2097153,
          "minimum": 0,
          "title": "Captured Response Bytes",
          "type": "integer"
        },
        "tls_version": {
          "anyOf": [
            {
              "enum": [
                "TLSv1.2",
                "TLSv1.3"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tls Version"
        }
      },
      "required": [
        "failure_stage",
        "error_code"
      ],
      "title": "ProviderDiagnostic",
      "type": "object"
    },
    "ProviderProbeResult": {
      "additionalProperties": false,
      "properties": {
        "result_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Id",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "rejected",
            "timed_out"
          ],
          "title": "Status",
          "type": "string"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "maximum": 512,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "process_started": {
          "title": "Process Started",
          "type": "boolean"
        },
        "cleanup_verified": {
          "title": "Cleanup Verified",
          "type": "boolean"
        },
        "attempt_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attempt Digest"
        },
        "receipt_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Receipt Digest"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "diagnostic": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderDiagnostic"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "response_model": {
          "anyOf": [
            {
              "enum": [
                "deepseek-v4-flash",
                "deepseek-v4-flash-0731"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Model"
        }
      },
      "required": [
        "result_id",
        "plan_id",
        "status",
        "input_tokens",
        "output_tokens",
        "process_started",
        "cleanup_verified",
        "attempt_digest",
        "receipt_digest",
        "completed_at"
      ],
      "title": "ProviderProbeResult",
      "type": "object"
    },
    "RecommendationPriority": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "RecommendationPriority",
      "type": "string"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        }
      },
      "required": [
        "path",
        "line"
      ],
      "title": "SourceLocation",
      "type": "object"
    },
    "UsageKeyObservation": {
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "anyOf": [
            {
              "enum": [
                "num_cached_tokens",
                "cached_prompt_tokens",
                "prompt_tokens_cached",
                "cache_read_input_tokens",
                "cache_creation_input_tokens",
                "input_tokens_details",
                "output_tokens_details",
                "total_tokens_details"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate"
        },
        "name_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Sha256"
        },
        "value_type": {
          "enum": [
            "null",
            "int",
            "dict",
            "other"
          ],
          "title": "Value Type",
          "type": "string"
        }
      },
      "required": [
        "value_type"
      ],
      "title": "UsageKeyObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "outcome_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Outcome Id",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "recommendation_ready",
        "rejected",
        "timed_out"
      ],
      "title": "Status",
      "type": "string"
    },
    "projection_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Projection Id",
      "type": "string"
    },
    "transport": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderProbeResult"
        },
        {
          "$ref": "#/$defs/ModelInvocationResult"
        }
      ],
