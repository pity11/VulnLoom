{
  "$defs": {
    "AttackActionKind": {
      "enum": [
        "initial_access_attempt",
        "verify_test_session",
        "verify_objective",
        "cleanup_test_session"
      ],
      "title": "AttackActionKind",
      "type": "string"
    },
    "AttackActionOutcome": {
      "enum": [
        "succeeded",
        "rejected",
        "failed",
        "timed_out"
      ],
      "title": "AttackActionOutcome",
      "type": "string"
    },
    "AttackImpact": {
      "enum": [
        "read_only",
        "state_change"
      ],
      "title": "AttackImpact",
      "type": "string"
    },
    "RedTeamPhase": {
      "enum": [
        "recon",
        "initial_access",
        "validation",
        "post_exploitation"
      ],
      "title": "RedTeamPhase",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "step_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Step Id",
      "type": "string"
    },
    "ordinal": {
      "maximum": 32,
      "minimum": 1,
      "title": "Ordinal",
      "type": "integer"
    },
    "action_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Action Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/AttackActionKind"
    },
    "phase": {
      "$ref": "#/$defs/RedTeamPhase"
    },
    "impact": {
      "$ref": "#/$defs/AttackImpact"
    },
    "outcome": {
      "$ref": "#/$defs/AttackActionOutcome"
    },
    "observation_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Observation Id",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    }
  },
  "required": [
    "step_id",
    "ordinal",
    "action_id",
    "kind",
    "phase",
    "impact",
    "outcome",
    "observation_id",
    "evidence_refs"
  ],
  "title": "AttackPathStep",
  "type": "object"
}
