{
  "$defs": {
    "CampaignCandidateCriticExecutionLimits": {
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "default": 30.0,
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "title": "CampaignCandidateCriticExecutionLimits",
      "type": "object"
    },
    "CounterevidenceAngle": {
      "enum": [
        "security_control",
        "reachability",
        "environment_parity",
        "version_binding"
      ],
      "title": "CounterevidenceAngle",
      "type": "string"
    },
    "MountKind": {
      "enum": [
        "snapshot",
        "analyzer_data",
        "evidence",
        "output",
        "temp"
      ],
      "title": "MountKind",
      "type": "string"
    },
    "NetworkGrant": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "maxLength": 253,
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "ports": {
          "items": {
            "maximum": 65535,
            "minimum": 1,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Ports",
          "type": "array",
          "uniqueItems": true
        },
        "schemes": {
          "items": {
            "type": "string"
          },
          "title": "Schemes",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "host",
        "ports",
        "schemes"
      ],
      "title": "NetworkGrant",
      "type": "object"
    },
    "NetworkMode": {
      "enum": [
        "none",
        "target_only"
      ],
      "title": "NetworkMode",
      "type": "string"
    },
    "RunnerCheckpoint": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checkpoint Id",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "target_version": {
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "scope_version": {
          "minimum": 1,
          "title": "Scope Version",
          "type": "integer"
        },
        "policy_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "sandbox_profile_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sandbox Profile Digest",
          "type": "string"
        },
        "invocation_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Invocation Digest",
          "type": "string"
        },
        "attempt": {
          "maximum": 3,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        }
      },
      "required": [
        "checkpoint_id",
        "task_id",
        "target_id",
        "target_version",
        "scope_id",
        "scope_version",
        "policy_digest",
        "sandbox_profile_digest",
        "invocation_digest",
        "attempt"
      ],
      "title": "RunnerCheckpoint",
      "type": "object"
    },
    "SandboxLimits": {
      "additionalProperties": false,
      "properties": {
        "wall_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Wall Seconds",
          "type": "integer"
        },
        "cpu_millis": {
          "exclusiveMinimum": 0,
          "maximum": 57600000,
          "title": "Cpu Millis",
          "type": "integer"
        },
        "memory_bytes": {
          "maximum": 17179869184,
          "minimum": 16777216,
          "title": "Memory Bytes",
          "type": "integer"
        },
        "pids": {
          "exclusiveMinimum": 0,
          "maximum": 4096,
          "title": "Pids",
          "type": "integer"
        },
        "open_files": {
          "exclusiveMinimum": 0,
          "maximum": 65536,
          "title": "Open Files",
          "type": "integer"
        },
        "file_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 10737418240,
          "title": "File Bytes",
          "type": "integer"
        },
        "tmp_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 10737418240,
          "title": "Tmp Bytes",
          "type": "integer"
        }
      },
      "required": [
        "wall_seconds",
        "cpu_millis",
        "memory_bytes",
        "pids",
        "open_files",
        "file_bytes",
        "tmp_bytes"
      ],
      "title": "SandboxLimits",
      "type": "object"
    },
    "SandboxMount": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/MountKind"
        },
        "destination": {
          "title": "Destination",
          "type": "string"
        },
        "object_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Id"
        },
        "read_only": {
          "title": "Read Only",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "destination",
        "read_only"
      ],
      "title": "SandboxMount",
      "type": "object"
    },
    "SandboxProfile": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/SandboxProfileKind"
        },
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "seccomp_contract_digest": {
          "default": "76f4a50d2de81ec675ea08d610db0ec72724590b96a28695f4bea6ec08f933dd",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Seccomp Contract Digest",
          "type": "string"
        },
        "run_as_uid": {
          "exclusiveMinimum": 0,
          "maximum": 2147483647,
          "title": "Run As Uid",
          "type": "integer"
        },
        "run_as_gid": {
          "exclusiveMinimum": 0,
          "maximum": 2147483647,
          "title": "Run As Gid",
          "type": "integer"
        },
        "read_only_root": {
          "default": true,
          "title": "Read Only Root",
          "type": "boolean"
        },
        "no_new_privileges": {
          "default": true,
          "title": "No New Privileges",
          "type": "boolean"
        },
        "capabilities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "network_mode": {
          "$ref": "#/$defs/NetworkMode",
          "default": "none"
        },
        "network_grants": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NetworkGrant"
          },
          "title": "Network Grants",
          "type": "array"
        },
        "mounts": {
          "items": {
            "$ref": "#/$defs/SandboxMount"
          },
          "title": "Mounts",
          "type": "array"
        },
        "writable_paths": {
          "default": [
            "/tmp",
            "/workspace/output"
          ],
          "items": {
            "type": "string"
          },
          "title": "Writable Paths",
          "type": "array",
          "uniqueItems": true
        },
        "allowed_tools": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Allowed Tools",
          "type": "array",
          "uniqueItems": true
        },
        "execute_target_code": {
          "default": false,
          "title": "Execute Target Code",
          "type": "boolean"
        },
        "max_attempts": {
          "default": 2,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "limits": {
          "$ref": "#/$defs/SandboxLimits"
        }
      },
      "required": [
        "kind",
        "image_digest",
        "run_as_uid",
        "run_as_gid",
        "mounts",
        "allowed_tools",
        "limits"
      ],
      "title": "SandboxProfile",
      "type": "object"
    },
    "SandboxProfileKind": {
      "enum": [
        "static",
        "validation",
        "report",
        "post_exploitation"
      ],
      "title": "SandboxProfileKind",
      "type": "string"
    },
    "SandboxRunRequest": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "task": {
          "$ref": "#/$defs/TaskEnvelope"
        },
        "profile": {
          "$ref": "#/$defs/SandboxProfile"
        },
        "invocation": {
          "$ref": "#/$defs/ToolInvocation"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "attempt": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "resume_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunnerCheckpoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "idempotency_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        }
      },
      "required": [
        "task",
        "profile",
        "invocation",
        "idempotency_key"
      ],
      "title": "SandboxRunRequest",
      "type": "object"
    },
    "TaskBudget": {
      "additionalProperties": false,
      "properties": {
        "wall_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Wall Seconds",
          "type": "integer"
        },
        "model_tokens": {
          "minimum": 0,
          "title": "Model Tokens",
          "type": "integer"
        },
        "tool_calls": {
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        }
      },
      "required": [
        "wall_seconds",
        "model_tokens",
        "tool_calls"
      ],
      "title": "TaskBudget",
      "type": "object"
    },
    "TaskEnvelope": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "engagement_id": {
          "format": "uuid",
          "title": "Engagement Id",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "target_version": {
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "worker_role": {
          "$ref": "#/$defs/WorkerRole"
        },
        "scope_version": {
          "minimum": 1,
          "title": "Scope Version",
          "type": "integer"
        },
        "policy_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "sandbox_profile_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sandbox Profile Digest",
          "type": "string"
        },
        "tool_registry_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tool Registry Digest",
          "type": "string"
        },
        "input_refs": {
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "allowed_tools": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Allowed Tools",
          "type": "array",
          "uniqueItems": true
        },
        "budget": {
          "$ref": "#/$defs/TaskBudget"
        },
        "deadline": {
          "format": "date-time",
          "title": "Deadline",
          "type": "string"
        },
        "idempotency_key": {
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        }
      },
      "required": [
        "engagement_id",
        "target_id",
        "target_version",
        "scope_id",
        "worker_role",
        "scope_version",
        "policy_digest",
        "sandbox_profile_digest",
        "tool_registry_digest",
        "input_refs",
        "allowed_tools",
        "budget",
        "deadline",
        "idempotency_key"
      ],
      "title": "TaskEnvelope",
      "type": "object"
    },
    "ToolInvocation": {
      "additionalProperties": false,
      "properties": {
        "tool_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Tool Id",
          "type": "string"
        },
        "arguments": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Arguments",
          "type": "array"
        },
        "working_directory": {
          "$ref": "#/$defs/WorkingDirectory"
        }
      },
      "required": [
        "tool_id",
        "working_directory"
      ],
      "title": "ToolInvocation",
      "type": "object"
    },
    "WorkerRole": {
      "enum": [
        "scope_interpreter",
        "source_mapper",
        "hypothesis",
        "analyzer",
        "validator",
        "critic",
        "reporter",
        "red_team_operator"
      ],
      "title": "WorkerRole",
      "type": "string"
    },
    "WorkingDirectory": {
      "enum": [
        "source",
        "output",
        "temp"
      ],
      "title": "WorkingDirectory",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "execution_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Plan Id",
      "type": "string"
    },
    "critic_intake_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Critic Intake Plan Id",
      "type": "string"
    },
    "critic_intake_plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Critic Intake Plan Digest",
      "type": "string"
    },
    "critic_intake_outcome_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Critic Intake Outcome Id",
      "type": "string"
    },
    "critic_intake_outcome_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Critic Intake Outcome Digest",
      "type": "string"
    },
    "intake_checkpoint_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Intake Checkpoint Id",
      "type": "string"
    },
    "intake_checkpoint_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Intake Checkpoint Digest",
      "type": "string"
    },
    "candidate_id": {
      "format": "uuid",
      "title": "Candidate Id",
      "type": "string"
    },
    "candidate_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Digest",
      "type": "string"
    },
    "target_id": {
      "format": "uuid",
      "title": "Target Id",
      "type": "string"
    },
    "target_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Target Version",
      "type": "string"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_version": {
      "minimum": 1,
      "title": "Scope Version",
      "type": "integer"
    },
    "validation_run_id": {
      "format": "uuid",
      "title": "Validation Run Id",
      "type": "string"
    },
    "validation_run_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Run Digest",
      "type": "string"
    },
    "evidence_bundle_id": {
      "format": "uuid",
      "title": "Evidence Bundle Id",
      "type": "string"
    },
    "evidence_bundle_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Bundle Digest",
      "type": "string"
    },
    "fresh_fact_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 5,
      "minItems": 5,
      "title": "Fresh Fact Ids",
      "type": "array"
    },
    "validation_evidence_refs": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Validation Evidence Refs",
      "type": "array"
    },
    "validation_context_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Context Digest",
      "type": "string"
    },
    "review_context_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Context Digest",
      "type": "string"
    },
    "validation_producer_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Producer Digest",
      "type": "string"
    },
    "review_producer_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Producer Digest",
      "type": "string"
    },
    "required_counterevidence_angles": {
      "default": [
        "environment_parity",
        "reachability",
        "security_control",
        "version_binding"
      ],
      "items": {
        "$ref": "#/$defs/CounterevidenceAngle"
      },
      "title": "Required Counterevidence Angles",
      "type": "array"
    },
    "request_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/SandboxRunRequest"
    },
    "limits": {
      "$ref": "#/$defs/CampaignCandidateCriticExecutionLimits"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "human_approval_required": {
      "const": true,
      "default": true,
      "title": "Human Approval Required",
      "type": "boolean"
    },
    "finding_creation_requested": {
      "const": false,
      "default": false,
      "title": "Finding Creation Requested",
      "type": "boolean"
    },
    "submission_requested": {
      "const": false,
      "default": false,
      "title": "Submission Requested",
      "type": "boolean"
    }
  },
  "required": [
    "execution_plan_id",
    "critic_intake_plan_id",
    "critic_intake_plan_digest",
    "critic_intake_outcome_id",
    "critic_intake_outcome_digest",
    "intake_checkpoint_id",
    "intake_checkpoint_digest",
    "candidate_id",
    "candidate_digest",
    "target_id",
    "target_version",
    "scope_id",
    "scope_version",
    "validation_run_id",
    "validation_run_digest",
    "evidence_bundle_id",
    "evidence_bundle_digest",
    "fresh_fact_ids",
    "validation_evidence_refs",
    "validation_context_digest",
    "review_context_digest",
    "validation_producer_digest",
    "review_producer_digest",
    "request_digest",
    "request",
    "limits",
    "created_at",
    "deadline",
    "idempotency_key"
  ],
  "title": "CampaignCandidateCriticExecutionPlan",
  "type": "object"
}
