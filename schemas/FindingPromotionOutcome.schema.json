{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "target_version": {
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        },
        "source_graph_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Graph Id",
          "type": "string"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "scope_version": {
          "minimum": 1,
          "title": "Scope Version",
          "type": "integer"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "cwe": {
          "pattern": "^CWE-[1-9][0-9]*$",
          "title": "Cwe",
          "type": "string"
        },
        "entry_point": {
          "$ref": "#/$defs/SourceLocation"
        },
        "sink": {
          "$ref": "#/$defs/SourceLocation"
        },
        "code_path": {
          "items": {
            "$ref": "#/$defs/SourceLocation"
          },
          "minItems": 1,
          "title": "Code Path",
          "type": "array"
        },
        "preconditions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "security_invariant": {
          "minLength": 1,
          "title": "Security Invariant",
          "type": "string"
        },
        "hypothesis": {
          "minLength": 1,
          "title": "Hypothesis",
          "type": "string"
        },
        "signal_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Signal Ids",
          "type": "array"
        },
        "cheapest_disproof": {
          "minLength": 1,
          "title": "Cheapest Disproof",
          "type": "string"
        },
        "duplicate_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Duplicate Fingerprint",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "state": {
          "$ref": "#/$defs/CandidateState",
          "default": "proposed"
        }
      },
      "required": [
        "target_id",
        "target_version",
        "source_graph_id",
        "scope_id",
        "scope_version",
        "title",
        "cwe",
        "entry_point",
        "sink",
        "code_path",
        "security_invariant",
        "hypothesis",
        "signal_ids",
        "cheapest_disproof",
        "duplicate_fingerprint",
        "confidence"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "CandidateState": {
      "enum": [
        "proposed",
        "rejected",
        "duplicate",
        "validation_pending",
        "validation_running",
        "validated",
        "inconclusive",
        "critic_reviewed",
        "promoted"
      ],
      "title": "CandidateState",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "format": "uuid",
          "title": "Finding Id",
          "type": "string"
        },
        "candidate_id": {
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "root_cause": {
          "minLength": 1,
          "title": "Root Cause",
          "type": "string"
        },
        "affected_versions": {
          "items": {
            "type": "string"
          },
          "title": "Affected Versions",
          "type": "array"
        },
        "preconditions": {
          "items": {
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "impact": {
          "minLength": 1,
          "title": "Impact",
          "type": "string"
        },
        "severity_assessment": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "title": "Severity Assessment",
          "type": "object"
        },
        "validation_run_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Validation Run Ids",
          "type": "array"
        },
        "evidence_bundle_id": {
          "format": "uuid",
          "title": "Evidence Bundle Id",
          "type": "string"
        },
        "duplicate_family_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Family Id"
        },
        "state": {
          "default": "verified",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "root_cause",
        "affected_versions",
        "preconditions",
        "impact",
        "severity_assessment",
        "validation_run_ids",
        "evidence_bundle_id"
      ],
      "title": "Finding",
      "type": "object"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        }
      },
      "required": [
        "path",
        "line"
      ],
      "title": "SourceLocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "outcome_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Outcome Id",
      "type": "string"
    },
    "execution_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Plan Id",
      "type": "string"
    },
    "approval_action_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approval Action Id",
      "type": "string"
    },
    "approval_id": {
      "format": "uuid",
      "title": "Approval Id",
      "type": "string"
    },
    "approval_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approval Digest",
      "type": "string"
    },
    "intake_record_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Intake Record Id",
      "type": "string"
    },
    "promotion_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Promotion Plan Id",
      "type": "string"
    },
    "promotion_plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Promotion Plan Digest",
      "type": "string"
    },
    "source_candidate_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Candidate Digest",
      "type": "string"
    },
    "promoted_candidate": {
      "$ref": "#/$defs/Candidate"
    },
    "promoted_candidate_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Promoted Candidate Digest",
      "type": "string"
    },
    "finding": {
      "$ref": "#/$defs/Finding"
    },
    "finding_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Finding Digest",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    }
  },
  "required": [
    "outcome_id",
    "execution_plan_id",
    "approval_action_id",
    "approval_id",
    "approval_digest",
    "intake_record_id",
    "promotion_plan_id",
    "promotion_plan_digest",
    "source_candidate_digest",
    "promoted_candidate",
    "promoted_candidate_digest",
    "finding",
    "finding_digest",
    "completed_at"
  ],
  "title": "FindingPromotionOutcome",
  "type": "object"
}
