{
  "$defs": {
    "AnalyzerExclusion": {
      "additionalProperties": false,
      "properties": {
        "source_ref_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Ref Digest",
          "type": "string"
        },
        "reason_code": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "source_ref_digest",
        "reason_code"
      ],
      "title": "AnalyzerExclusion",
      "type": "object"
    },
    "AnalyzerKind": {
      "enum": [
        "codeql",
        "trivy",
        "checkov",
        "kubesec"
      ],
      "title": "AnalyzerKind",
      "type": "string"
    },
    "AnalyzerLocation": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "start_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Line"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "start_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Column"
        },
        "end_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Column"
        }
      },
      "required": [
        "path"
      ],
      "title": "AnalyzerLocation",
      "type": "object"
    },
    "AnalyzerObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Id",
          "type": "string"
        },
        "analyzer": {
          "$ref": "#/$defs/AnalyzerKind"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "target_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        },
        "rule_id_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rule Id Digest",
          "type": "string"
        },
        "rule_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rule Fingerprint",
          "type": "string"
        },
        "cwes": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Cwes",
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/AnalyzerSeverity"
        },
        "message_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Message Digest",
          "type": "string"
        },
        "locations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AnalyzerLocation"
          },
          "title": "Locations",
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "analyzer",
        "target_id",
        "target_version",
        "rule_id_digest",
        "rule_fingerprint",
        "cwes",
        "severity",
        "message_digest"
      ],
      "title": "AnalyzerObservation",
      "type": "object"
    },
    "AnalyzerSeverity": {
      "enum": [
        "unknown",
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "AnalyzerSeverity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "observation_set_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Observation Set Id",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "snapshot_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Digest",
      "type": "string"
    },
    "adapter_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Adapter Id",
      "type": "string"
    },
    "adapter_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Adapter Digest",
      "type": "string"
    },
    "analyzer": {
      "$ref": "#/$defs/AnalyzerKind"
    },
    "target_id": {
      "format": "uuid",
      "title": "Target Id",
      "type": "string"
    },
    "target_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Target Version",
      "type": "string"
    },
    "observations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AnalyzerObservation"
      },
      "title": "Observations",
      "type": "array"
    },
    "exclusions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AnalyzerExclusion"
      },
      "title": "Exclusions",
      "type": "array"
    }
  },
  "required": [
    "observation_set_id",
    "snapshot_id",
    "snapshot_digest",
    "adapter_id",
    "adapter_digest",
    "analyzer",
    "target_id",
    "target_version"
  ],
  "title": "AnalyzerObservationSet",
  "type": "object"
}
