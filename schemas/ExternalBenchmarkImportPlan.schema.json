{
  "$defs": {
    "ExternalImportLimits": {
      "additionalProperties": false,
      "properties": {
        "max_files": {
          "default": 20000,
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Max Files",
          "type": "integer"
        },
        "max_single_file_bytes": {
          "default": 20971520,
          "exclusiveMinimum": 0,
          "title": "Max Single File Bytes",
          "type": "integer"
        },
        "max_total_bytes": {
          "default": 209715200,
          "exclusiveMinimum": 0,
          "title": "Max Total Bytes",
          "type": "integer"
        },
        "max_cases": {
          "default": 10000,
          "exclusiveMinimum": 0,
          "title": "Max Cases",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "title": "ExternalImportLimits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "snapshot_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Digest",
      "type": "string"
    },
    "adapter_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Adapter Id",
      "type": "string"
    },
    "adapter_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Adapter Digest",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/ExternalImportLimits"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "snapshot_id",
    "snapshot_digest",
    "adapter_id",
    "adapter_digest",
    "limits",
    "created_at",
    "deadline",
    "idempotency_key"
  ],
  "title": "ExternalBenchmarkImportPlan",
  "type": "object"
}
