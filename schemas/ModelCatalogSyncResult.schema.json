{
  "$defs": {
    "ModelCatalogEntry": {
      "additionalProperties": false,
      "properties": {
        "entry_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Entry Digest",
          "type": "string"
        },
        "provider_profile_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Provider Profile Digest",
          "type": "string"
        },
        "provider_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Provider Id",
          "type": "string"
        },
        "provider_model_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$",
          "title": "Provider Model Id",
          "type": "string"
        },
        "display_name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:/+()_-]{0,127}$",
          "title": "Display Name",
          "type": "string"
        },
        "aliases": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Aliases",
          "type": "array"
        },
        "declared_limits": {
          "$ref": "#/$defs/ModelDeclaredLimits",
          "default": {
            "max_context_tokens": null,
            "max_output_tokens": null
          }
        },
        "pricing": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelPricingMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "catalog_observed_at": {
          "format": "date-time",
          "title": "Catalog Observed At",
          "type": "string"
        }
      },
      "required": [
        "entry_digest",
        "provider_profile_digest",
        "provider_id",
        "provider_model_id",
        "display_name",
        "catalog_observed_at"
      ],
      "title": "ModelCatalogEntry",
      "type": "object"
    },
    "ModelCatalogSnapshot": {
      "additionalProperties": false,
      "properties": {
        "snapshot_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Digest",
          "type": "string"
        },
        "provider_profile_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Provider Profile Digest",
          "type": "string"
        },
        "provider_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Provider Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ModelCatalogSource"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/ModelCatalogEntry"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Entries",
          "type": "array"
        },
        "source_receipt_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Receipt Digest",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "snapshot_digest",
        "provider_profile_digest",
        "provider_id",
        "source",
        "entries",
        "source_receipt_digest",
        "observed_at"
      ],
      "title": "ModelCatalogSnapshot",
      "type": "object"
    },
    "ModelCatalogSource": {
      "enum": [
        "manual",
        "offline_fixture",
        "provider_api"
      ],
      "title": "ModelCatalogSource",
      "type": "string"
    },
    "ModelCatalogSyncStatus": {
      "enum": [
        "passed",
        "failed",
        "timed_out"
      ],
      "title": "ModelCatalogSyncStatus",
      "type": "string"
    },
    "ModelDeclaredLimits": {
      "additionalProperties": false,
      "properties": {
        "max_context_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Context Tokens"
        },
        "max_output_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        }
      },
      "title": "ModelDeclaredLimits",
      "type": "object"
    },
    "ModelPricingMetadata": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "const": "USD",
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "input_microunits_per_million_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Microunits Per Million Tokens"
        },
        "output_microunits_per_million_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Microunits Per Million Tokens"
        }
      },
      "title": "ModelPricingMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "result_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Id",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Id",
      "type": "string"
    },
    "provider_profile_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Provider Profile Digest",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ModelCatalogSyncStatus"
    },
    "snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelCatalogSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cleanup_verified": {
      "title": "Cleanup Verified",
      "type": "boolean"
    },
    "diagnostic_code": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Diagnostic Code",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    }
  },
  "required": [
    "result_id",
    "request_id",
    "provider_profile_digest",
    "status",
    "cleanup_verified",
    "diagnostic_code",
    "completed_at"
  ],
  "title": "ModelCatalogSyncResult",
  "type": "object"
}
