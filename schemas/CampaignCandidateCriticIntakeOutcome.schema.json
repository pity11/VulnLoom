      "type": "string"
    },
    "checkpoint": {
      "$ref": "#/$defs/CampaignCandidateCriticIntakeCheckpoint"
    },
    "attempt": {
      "maximum": 3,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "critic_admitted": {
      "const": true,
      "default": true,
      "title": "Critic Admitted",
      "type": "boolean"
    },
    "critic_started": {
      "const": false,
      "default": false,
      "title": "Critic Started",
      "type": "boolean"
    },
    "critic_review_created": {
      "const": false,
      "default": false,
      "title": "Critic Review Created",
      "type": "boolean"
    },
    "finding_created": {
      "const": false,
      "default": false,
      "title": "Finding Created",
      "type": "boolean"
    },
    "submission_authorized": {
      "const": false,
      "default": false,
      "title": "Submission Authorized",
      "type": "boolean"
    },
    "cleanup_complete": {
      "const": true,
      "default": true,
      "title": "Cleanup Complete",
      "type": "boolean"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    }
  },
  "required": [
    "outcome_id",
    "critic_intake_plan_id",
    "checkpoint",
    "attempt",
    "completed_at"
  ],
  "title": "CampaignCandidateCriticIntakeOutcome",
  "type": "object"
}
