      "type": "string"
    },
    "recipe_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Recipe Plan Id",
      "type": "string"
    },
    "recipe_outcome_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Recipe Outcome Digest",
      "type": "string"
    },
    "registry_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Registry Digest",
      "type": "string"
    },
    "recipe_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Recipe Id",
      "type": "string"
    },
    "index_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Index Id",
      "type": "string"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "target_id": {
      "format": "uuid",
      "title": "Target Id",
      "type": "string"
    },
    "target_version": {
