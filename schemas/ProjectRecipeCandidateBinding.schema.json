    "recipe_plan_id",
    "recipe_outcome_digest",
    "registry_digest",
    "recipe_id",
    "index_id",
    "manifest_id",
    "target_id",
    "target_version",
    "scope_id",
    "scope_version",
    "candidate_id",
    "candidate_digest",
