    },
    "candidate_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Digest",
      "type": "string"
    },
    "bound_at": {
      "format": "date-time",
      "title": "Bound At",
      "type": "string"
    }
