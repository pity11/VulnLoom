{
  "$defs": {
    "TestIdentityAdmissionLimits": {
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "default": 10.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "max_session_uses": {
          "const": 1,
          "default": 1,
          "title": "Max Session Uses",
          "type": "integer"
        }
      },
      "title": "TestIdentityAdmissionLimits",
      "type": "object"
    },
    "TestIdentityPurpose": {
      "enum": [
        "authentication",
        "read_only_role_observation",
        "state_change_validation"
      ],
      "title": "TestIdentityPurpose",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "record_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Id",
      "type": "string"
    },
    "identity_ref": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Identity Ref",
      "type": "string"
    },
    "credential_ref": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Credential Ref",
      "type": "string"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_version": {
      "minimum": 1,
      "title": "Scope Version",
      "type": "integer"
    },
    "target_id": {
      "format": "uuid",
      "title": "Target Id",
      "type": "string"
    },
    "target_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Digest",
      "type": "string"
    },
    "purposes": {
      "items": {
        "$ref": "#/$defs/TestIdentityPurpose"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Purposes",
      "type": "array"
    },
    "role_refs": {
      "items": {
        "pattern": "^role:[a-zA-Z0-9._-]{1,200}$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Role Refs",
      "type": "array"
    },
    "limits": {
      "$ref": "#/$defs/TestIdentityAdmissionLimits"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "admission_expires_at": {
      "format": "date-time",
      "title": "Admission Expires At",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "credential_material_present": {
      "const": false,
      "default": false,
      "title": "Credential Material Present",
      "type": "boolean"
    },
    "authentication_authorized": {
      "const": false,
      "default": false,
      "title": "Authentication Authorized",
      "type": "boolean"
    },
    "session_authorized": {
      "const": false,
      "default": false,
      "title": "Session Authorized",
      "type": "boolean"
    },
    "state_change_authorized": {
      "const": false,
      "default": false,
      "title": "State Change Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "plan_id",
    "record_id",
    "identity_ref",
    "credential_ref",
    "scope_id",
    "scope_version",
    "target_id",
    "target_digest",
    "purposes",
    "role_refs",
    "limits",
    "created_at",
    "deadline",
    "admission_expires_at",
    "idempotency_key"
  ],
  "title": "TestIdentityAdmissionPlan",
  "type": "object"
}
