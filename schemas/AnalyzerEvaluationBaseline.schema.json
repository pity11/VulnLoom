        },
        "duplicate_match_count": {
          "minimum": 0,
          "title": "Duplicate Match Count",
          "type": "integer"
        },
        "exclusion_count": {
          "minimum": 0,
          "title": "Exclusion Count",
          "type": "integer"
        },
        "truth_recall": {
          "maximum": 1,
          "minimum": 0,
          "title": "Truth Recall",
          "type": "number"
        },
        "observation_precision": {
          "maximum": 1,
          "minimum": 0,
          "title": "Observation Precision",
          "type": "number"
        },
        "duplicate_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Duplicate Rate",
