{
  "$defs": {
    "BenchmarkBaseline": {
      "additionalProperties": false,
      "properties": {
        "baseline_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Baseline Id",
          "type": "string"
        },
        "suite_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Suite Id",
          "type": "string"
        },
        "suite_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Suite Digest",
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/BenchmarkMetrics"
        }
      },
      "required": [
        "baseline_id",
        "suite_id",
        "suite_digest",
        "metrics"
      ],
      "title": "BenchmarkBaseline",
      "type": "object"
    },
    "BenchmarkMetrics": {
      "additionalProperties": false,
      "properties": {
        "ground_truth_count": {
          "minimum": 0,
          "title": "Ground Truth Count",
          "type": "integer"
        },
        "candidate_count": {
          "minimum": 0,
          "title": "Candidate Count",
          "type": "integer"
        },
        "finding_count": {
          "minimum": 0,
          "title": "Finding Count",
          "type": "integer"
        },
        "matched_finding_count": {
          "minimum": 0,
          "title": "Matched Finding Count",
          "type": "integer"
        },
        "candidate_recall": {
          "maximum": 1,
          "minimum": 0,
          "title": "Candidate Recall",
          "type": "number"
        },
        "finding_precision": {
          "maximum": 1,
          "minimum": 0,
          "title": "Finding Precision",
          "type": "number"
        },
        "duplicate_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Duplicate Rate",
          "type": "number"
        },
        "evidence_completeness": {
          "maximum": 1,
          "minimum": 0,
          "title": "Evidence Completeness",
          "type": "number"
        },
        "policy_violation_count": {
          "minimum": 0,
          "title": "Policy Violation Count",
          "type": "integer"
        },
        "total_elapsed_ms": {
          "minimum": 0,
          "title": "Total Elapsed Ms",
          "type": "integer"
        },
        "total_cost_microunits": {
          "minimum": 0,
          "title": "Total Cost Microunits",
          "type": "integer"
        },
        "cost_per_finding_microunits": {
          "minimum": 0,
          "title": "Cost Per Finding Microunits",
          "type": "integer"
        }
      },
      "required": [
        "ground_truth_count",
        "candidate_count",
        "finding_count",
        "matched_finding_count",
        "candidate_recall",
        "finding_precision",
        "duplicate_rate",
        "evidence_completeness",
        "policy_violation_count",
        "total_elapsed_ms",
        "total_cost_microunits",
        "cost_per_finding_microunits"
      ],
      "title": "BenchmarkMetrics",
      "type": "object"
    },
    "BenchmarkRegressionPolicy": {
      "additionalProperties": false,
      "properties": {
        "min_candidate_recall": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Candidate Recall",
          "type": "number"
        },
        "min_finding_precision": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Finding Precision",
          "type": "number"
        },
        "max_duplicate_rate": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Max Duplicate Rate",
          "type": "number"
        },
        "min_evidence_completeness": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Evidence Completeness",
          "type": "number"
        },
        "max_policy_violations": {
          "default": 0,
          "minimum": 0,
          "title": "Max Policy Violations",
          "type": "integer"
        },
        "max_total_elapsed_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Total Elapsed Ms"
        },
        "max_cost_per_finding_microunits": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Per Finding Microunits"
        },
        "max_candidate_recall_drop": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Max Candidate Recall Drop",
          "type": "number"
        },
        "max_finding_precision_drop": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Max Finding Precision Drop",
          "type": "number"
        },
        "max_evidence_completeness_drop": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Max Evidence Completeness Drop",
          "type": "number"
        },
        "max_duplicate_rate_increase": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Max Duplicate Rate Increase",
          "type": "number"
        },
        "max_runtime_increase_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Max Runtime Increase Ms",
          "type": "integer"
        },
        "max_cost_per_finding_increase_microunits": {
          "default": 0,
          "minimum": 0,
          "title": "Max Cost Per Finding Increase Microunits",
          "type": "integer"
        }
      },
      "title": "BenchmarkRegressionPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "suite_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Suite Id",
      "type": "string"
    },
    "suite_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Suite Digest",
      "type": "string"
    },
    "observation_set_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Observation Set Id",
      "type": "string"
    },
    "observation_set_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Observation Set Digest",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/BenchmarkRegressionPolicy"
    },
    "baseline": {
      "anyOf": [
        {
          "$ref": "#/$defs/BenchmarkBaseline"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "suite_id",
    "suite_digest",
    "observation_set_id",
    "observation_set_digest",
    "policy",
    "created_at",
    "deadline",
    "idempotency_key"
  ],
  "title": "BenchmarkPlan",
  "type": "object"
}
