{
  "$defs": {
    "CriticAssertionMaterialization": {
      "additionalProperties": false,
      "properties": {
        "materialization_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Materialization Id",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Id",
          "type": "string"
        },
        "requirement_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "replay_validation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Replay Validation Id",
          "type": "string"
        },
        "review_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Review Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "assertions": {
          "items": {
            "$ref": "#/$defs/EvidenceAssertion"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Assertions",
          "type": "array"
        },
        "ruleset_digest": {
          "const": "8b3b076e39dd57aec63c60049b02329891e5193f7a81371f1afd131e9b9b401f",
          "title": "Ruleset Digest",
          "type": "string"
        },
        "review_executed": {
          "const": false,
          "default": false,
          "title": "Review Executed",
          "type": "boolean"
        },
        "request_execution_authorized": {
          "const": false,
          "default": false,
          "title": "Request Execution Authorized",
          "type": "boolean"
        },
        "candidate_proposal_eligible": {
          "const": false,
          "default": false,
          "title": "Candidate Proposal Eligible",
          "type": "boolean"
        },
        "finding_authorized": {
          "const": false,
          "default": false,
          "title": "Finding Authorized",
          "type": "boolean"
        },
        "materialized_at": {
          "format": "date-time",
          "title": "Materialized At",
          "type": "string"
        }
      },
      "required": [
        "materialization_id",
        "plan_id",
        "requirement_id",
        "replay_validation_id",
        "review_id",
        "evidence_refs",
        "assertions",
        "ruleset_digest",
        "materialized_at"
      ],
      "title": "CriticAssertionMaterialization",
      "type": "object"
    },
    "EvidenceAssertion": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assertion Id",
          "type": "string"
        },
        "requirement_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/EvidenceRequirementStage"
        },
        "fact": {
          "$ref": "#/$defs/EvidenceFactKind"
        },
        "verdict": {
          "$ref": "#/$defs/EvidenceFactVerdict"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "producer_ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9:._-]{0,127}$",
          "title": "Producer Ref",
          "type": "string"
        },
        "context_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Context Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "assertion_id",
        "requirement_id",
        "stage",
        "fact",
        "verdict",
        "evidence_refs",
        "producer_ref",
        "context_id",
        "observed_at"
      ],
      "title": "EvidenceAssertion",
      "type": "object"
    },
    "EvidenceFactKind": {
      "enum": [
        "sealed_get_succeeded",
        "unauthenticated_request_proven",
        "sensitive_data_class_present",
        "independent_replay_matched",
        "redaction_boundary_proven",
        "access_control_enforced",
        "public_by_design",
        "synthetic_or_placeholder_data",
        "environment_or_version_mismatch",
        "no_state_change_proven",
        "no_test_artifacts_remain"
      ],
      "title": "EvidenceFactKind",
      "type": "string"
    },
    "EvidenceFactVerdict": {
      "enum": [
        "supported",
        "refuted",
        "inconclusive"
      ],
      "title": "EvidenceFactVerdict",
      "type": "string"
    },
    "EvidenceRequirementStage": {
      "enum": [
        "observation",
        "validation",
        "critic",
        "cleanup"
      ],
      "title": "EvidenceRequirementStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "materialization": {
      "$ref": "#/$defs/CriticAssertionMaterialization"
    },
    "attempt": {
      "maximum": 3,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "cleanup_complete": {
      "const": true,
      "default": true,
      "title": "Cleanup Complete",
      "type": "boolean"
    }
  },
  "required": [
    "plan_id",
    "materialization",
    "attempt"
  ],
  "title": "CriticAssertionMaterializationOutcome",
  "type": "object"
}
