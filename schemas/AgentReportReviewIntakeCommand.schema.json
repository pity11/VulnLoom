  "required": [
    "command_id",
    "intake_plan_id",
    "intake_plan_digest",
    "draft_outcome_binding_id",
    "report_review_plan_id",
    "report_review_plan_digest",
    "report_id",
    "report_digest",
    "decision",
    "reason_code",
    "reviewer",
    "decided_at"
