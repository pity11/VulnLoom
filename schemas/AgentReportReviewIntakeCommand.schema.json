      "type": "string"
    },
    "AgentReportReviewIntakeReason": {
      "enum": [
        "human_accepted_exact_review",
        "human_rejected",
        "human_deferred"
      ],
      "title": "AgentReportReviewIntakeReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "command_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Command Id",
      "type": "string"
    },
    "intake_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Intake Plan Id",
      "type": "string"
    },
    "intake_plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Intake Plan Digest",
      "type": "string"
    },
    "draft_outcome_binding_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Draft Outcome Binding Id",
      "type": "string"
    },
    "report_review_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Review Plan Id",
      "type": "string"
    },
    "report_review_plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Review Plan Digest",
      "type": "string"
    },
    "report_id": {
