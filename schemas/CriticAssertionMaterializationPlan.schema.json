{
  "$defs": {
    "CriticAssertionMaterializationLimits": {
      "additionalProperties": false,
      "properties": {
        "max_evidence_refs": {
          "default": 16,
          "maximum": 32,
          "minimum": 1,
          "title": "Max Evidence Refs",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 10.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "title": "CriticAssertionMaterializationLimits",
      "type": "object"
    },
    "CriticEvidenceConclusion": {
      "additionalProperties": false,
      "properties": {
        "fact": {
          "$ref": "#/$defs/EvidenceFactKind"
        },
        "verdict": {
          "$ref": "#/$defs/EvidenceFactVerdict"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "fact",
        "verdict",
        "evidence_refs"
      ],
      "title": "CriticEvidenceConclusion",
      "type": "object"
    },
    "CriticEvidenceReview": {
      "additionalProperties": false,
      "properties": {
        "review_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Review Id",
          "type": "string"
        },
        "requirement_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "target_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "scope_version": {
          "minimum": 1,
          "title": "Scope Version",
          "type": "integer"
        },
        "review_context_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Review Context Id",
          "type": "string"
        },
        "producer_ref": {
          "const": "critic:counterevidence-review-v1",
          "default": "critic:counterevidence-review-v1",
          "title": "Producer Ref",
          "type": "string"
        },
        "conclusions": {
          "items": {
            "$ref": "#/$defs/CriticEvidenceConclusion"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Conclusions",
          "type": "array"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        }
      },
      "required": [
        "review_id",
        "requirement_id",
        "target_id",
        "target_version",
        "scope_id",
        "scope_version",
        "review_context_id",
        "conclusions",
        "reviewed_at"
      ],
      "title": "CriticEvidenceReview",
      "type": "object"
    },
    "EvidenceFactKind": {
      "enum": [
        "sealed_get_succeeded",
        "unauthenticated_request_proven",
        "sensitive_data_class_present",
        "independent_replay_matched",
        "redaction_boundary_proven",
        "access_control_enforced",
        "public_by_design",
        "synthetic_or_placeholder_data",
        "environment_or_version_mismatch",
        "no_state_change_proven",
        "no_test_artifacts_remain"
      ],
      "title": "EvidenceFactKind",
      "type": "string"
    },
    "EvidenceFactVerdict": {
      "enum": [
        "supported",
        "refuted",
        "inconclusive"
      ],
      "title": "EvidenceFactVerdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "requirement_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Requirement Id",
      "type": "string"
    },
    "replay_validation_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Replay Validation Plan Id",
      "type": "string"
    },
    "replay_validation_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Replay Validation Id",
      "type": "string"
    },
    "validation_context_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Context Id",
      "type": "string"
    },
    "validation_producer_ref": {
      "const": "validator:sealed-get-replay-v1",
      "title": "Validation Producer Ref",
      "type": "string"
    },
    "validation_evidence_refs": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Validation Evidence Refs",
      "type": "array"
    },
    "review": {
      "$ref": "#/$defs/CriticEvidenceReview"
    },
    "target_id": {
      "format": "uuid",
      "title": "Target Id",
      "type": "string"
    },
    "target_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Target Version",
      "type": "string"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_version": {
      "minimum": 1,
      "title": "Scope Version",
      "type": "integer"
    },
    "ruleset_digest": {
      "const": "8b3b076e39dd57aec63c60049b02329891e5193f7a81371f1afd131e9b9b401f",
      "default": "8b3b076e39dd57aec63c60049b02329891e5193f7a81371f1afd131e9b9b401f",
      "title": "Ruleset Digest",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/CriticAssertionMaterializationLimits"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "requirement_id",
    "replay_validation_plan_id",
    "replay_validation_id",
    "validation_context_id",
    "validation_producer_ref",
    "validation_evidence_refs",
    "review",
    "target_id",
    "target_version",
    "scope_id",
    "scope_version",
    "limits",
    "created_at",
    "deadline",
    "idempotency_key"
  ],
  "title": "CriticAssertionMaterializationPlan",
  "type": "object"
}
