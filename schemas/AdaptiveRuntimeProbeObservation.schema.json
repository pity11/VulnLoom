{
  "$defs": {
    "AdaptiveRuntimeProbeKind": {
      "enum": [
        "boundary",
        "timeout_cleanup"
      ],
      "title": "AdaptiveRuntimeProbeKind",
      "type": "string"
    },
    "RuntimeAssuranceLevel": {
      "enum": [
        "local_docker",
        "rootless_production"
      ],
      "title": "RuntimeAssuranceLevel",
      "type": "string"
    },
    "SandboxRunStatus": {
      "enum": [
        "completed",
        "checkpointed",
        "failed",
        "timed_out",
        "cancelled"
      ],
      "title": "SandboxRunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "observation_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Observation Id",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "adaptive_outcome_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Adaptive Outcome Id",
      "type": "string"
    },
    "coverage_ledger_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Coverage Ledger Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/AdaptiveRuntimeProbeKind"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "image_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Image Digest",
      "type": "string"
    },
    "sandbox_profile_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sandbox Profile Digest",
      "type": "string"
    },
    "invocation_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Invocation Digest",
      "type": "string"
    },
    "runner_result_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runner Result Digest",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/SandboxRunStatus"
    },
    "error_codes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "title": "Error Codes",
      "type": "array"
    },
    "assurance_level": {
      "$ref": "#/$defs/RuntimeAssuranceLevel"
    },
    "actual_container_observed": {
      "const": true,
      "default": true,
      "title": "Actual Container Observed",
      "type": "boolean"
    },
    "network_disabled": {
      "const": true,
      "default": true,
      "title": "Network Disabled",
      "type": "boolean"
    },
    "non_root": {
      "const": true,
      "default": true,
      "title": "Non Root",
      "type": "boolean"
    },
    "read_only_root": {
      "const": true,
      "default": true,
      "title": "Read Only Root",
      "type": "boolean"
    },
    "capabilities_dropped": {
      "const": true,
      "default": true,
      "title": "Capabilities Dropped",
      "type": "boolean"
    },
    "no_new_privileges": {
      "const": true,
      "default": true,
      "title": "No New Privileges",
      "type": "boolean"
    },
    "seccomp_enforced": {
      "const": true,
      "default": true,
      "title": "Seccomp Enforced",
      "type": "boolean"
    },
    "resource_limits_enforced": {
      "const": true,
      "default": true,
      "title": "Resource Limits Enforced",
      "type": "boolean"
    },
    "environment_allowlisted": {
      "const": true,
      "default": true,
      "title": "Environment Allowlisted",
      "type": "boolean"
    },
    "content_mount_read_only": {
      "const": true,
      "default": true,
      "title": "Content Mount Read Only",
      "type": "boolean"
    },
    "docker_socket_absent": {
      "const": true,
      "default": true,
      "title": "Docker Socket Absent",
      "type": "boolean"
    },
    "cleanup_verified": {
      "const": true,
      "default": true,
      "title": "Cleanup Verified",
      "type": "boolean"
    },
    "container_absent": {
      "const": true,
      "default": true,
      "title": "Container Absent",
      "type": "boolean"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    }
  },
  "required": [
    "observation_id",
    "plan_id",
    "adaptive_outcome_id",
    "coverage_ledger_id",
    "kind",
    "run_id",
    "task_id",
    "image_digest",
    "sandbox_profile_digest",
    "invocation_digest",
    "runner_result_digest",
    "status",
    "assurance_level",
    "observed_at"
  ],
  "title": "AdaptiveRuntimeProbeObservation",
  "type": "object"
}
