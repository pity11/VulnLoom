{
  "$defs": {
    "LocalCandidateObservation": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "cwe": {
          "pattern": "^CWE-[1-9][0-9]*$",
          "title": "Cwe",
          "type": "string"
        },
        "duplicate_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Duplicate Fingerprint",
          "type": "string"
        },
        "signal_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Signal Ids",
          "type": "array"
        },
        "entry_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Entry Path",
          "type": "string"
        },
        "sink_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Sink Path",
          "type": "string"
        },
        "code_path_count": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Code Path Count",
          "type": "integer"
        }
      },
      "required": [
        "candidate_id",
        "cwe",
        "duplicate_fingerprint",
        "signal_ids",
        "entry_path",
        "sink_path",
        "code_path_count"
      ],
      "title": "LocalCandidateObservation",
      "type": "object"
    },
    "LocalSourceCaseObservation": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Case Id",
          "type": "string"
        },
        "target_version": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Target Version",
          "type": "string"
        },
        "source_graph_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Graph Id",
          "type": "string"
        },
        "candidate_set_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Set Id",
          "type": "string"
        },
        "candidates": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LocalCandidateObservation"
          },
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "target_version",
        "source_graph_id",
        "candidate_set_id"
      ],
      "title": "LocalSourceCaseObservation",
      "type": "object"
    },
    "LocalSourceEffectCounters": {
      "additionalProperties": false,
      "properties": {
        "runner_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Runner Calls",
          "type": "integer"
        },
        "broker_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Broker Calls",
          "type": "integer"
        },
        "provider_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Provider Calls",
          "type": "integer"
        },
        "target_processes": {
          "default": 0,
          "minimum": 0,
          "title": "Target Processes",
          "type": "integer"
        },
        "public_network_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Public Network Calls",
          "type": "integer"
        },
        "target_builds": {
          "default": 0,
          "minimum": 0,
          "title": "Target Builds",
          "type": "integer"
        },
        "automatic_approvals": {
          "default": 0,
          "minimum": 0,
          "title": "Automatic Approvals",
          "type": "integer"
        },
        "submissions": {
          "default": 0,
          "minimum": 0,
          "title": "Submissions",
          "type": "integer"
        }
      },
      "title": "LocalSourceEffectCounters",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "observation_set_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Observation Set Id",
      "type": "string"
    },
    "suite_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Suite Id",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/LocalSourceCaseObservation"
      },
      "title": "Observations",
      "type": "array"
    },
    "effects": {
      "$ref": "#/$defs/LocalSourceEffectCounters",
      "default": {
        "runner_calls": 0,
        "broker_calls": 0,
        "provider_calls": 0,
        "target_processes": 0,
        "public_network_calls": 0,
        "target_builds": 0,
        "automatic_approvals": 0,
        "submissions": 0
      }
    }
  },
  "required": [
    "observation_set_id",
    "suite_id",
    "observations"
  ],
  "title": "LocalSourceObservationSet",
  "type": "object"
}
