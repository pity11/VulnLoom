{
  "$defs": {
    "RuntimeAssuranceLevel": {
      "enum": [
        "local_docker",
        "rootless_production"
      ],
      "title": "RuntimeAssuranceLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "outcome_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Outcome Id",
      "type": "string"
    },
    "campaign_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Campaign Plan Id",
      "type": "string"
    },
    "goal_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Goal Id",
      "type": "string"
    },
    "flow_binding_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 2,
      "title": "Flow Binding Ids",
      "type": "array"
    },
    "target_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Target Ids",
      "type": "array"
    },
    "minimum_assurance_level": {
      "$ref": "#/$defs/RuntimeAssuranceLevel"
    },
    "attempt": {
      "maximum": 3,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "qualified_autonomy": {
      "const": "a4_goal_driven_campaign",
      "default": "a4_goal_driven_campaign",
      "title": "Qualified Autonomy",
      "type": "string"
    },
    "qualified": {
      "const": true,
      "default": true,
      "title": "Qualified",
      "type": "boolean"
    },
    "campaign_started": {
      "const": false,
      "default": false,
      "title": "Campaign Started",
      "type": "boolean"
    },
    "execution_authority_granted": {
      "const": false,
      "default": false,
      "title": "Execution Authority Granted",
      "type": "boolean"
    },
    "dynamic_target_expansion_granted": {
      "const": false,
      "default": false,
      "title": "Dynamic Target Expansion Granted",
      "type": "boolean"
    },
    "credential_access_granted": {
      "const": false,
      "default": false,
      "title": "Credential Access Granted",
      "type": "boolean"
    },
    "submission_granted": {
      "const": false,
      "default": false,
      "title": "Submission Granted",
      "type": "boolean"
    },
    "candidate_created": {
      "const": false,
      "default": false,
      "title": "Candidate Created",
      "type": "boolean"
    },
    "finding_created": {
      "const": false,
      "default": false,
      "title": "Finding Created",
      "type": "boolean"
    }
  },
  "required": [
    "outcome_id",
    "campaign_plan_id",
    "goal_id",
    "flow_binding_ids",
    "target_ids",
    "minimum_assurance_level",
    "attempt",
    "completed_at"
  ],
  "title": "GoalDrivenCampaignQualificationOutcome",
  "type": "object"
}
