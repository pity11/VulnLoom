{
  "$defs": {
    "ApprovalAction": {
      "enum": [
        "run_validation",
        "run_critic",
        "run_untrusted_build",
        "mutate_target_state",
        "use_real_credentials",
        "external_callback",
        "submit_report",
        "review_report",
        "export_report",
        "execute_red_team_action"
      ],
      "title": "ApprovalAction",
      "type": "string"
    },
    "CredentialSessionLimits": {
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "default": 10.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "lease_ttl_seconds": {
          "default": 60,
          "maximum": 300,
          "minimum": 1,
          "title": "Lease Ttl Seconds",
          "type": "integer"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "max_session_uses": {
          "const": 1,
          "default": 1,
          "title": "Max Session Uses",
          "type": "integer"
        }
      },
      "title": "CredentialSessionLimits",
      "type": "object"
    },
    "TestIdentityPurpose": {
      "enum": [
        "authentication",
        "read_only_role_observation",
        "state_change_validation"
      ],
      "title": "TestIdentityPurpose",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "admission_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Admission Plan Id",
      "type": "string"
    },
    "admission_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Admission Id",
      "type": "string"
    },
    "record_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Id",
      "type": "string"
    },
    "identity_ref": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Identity Ref",
      "type": "string"
    },
    "credential_ref": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Credential Ref",
      "type": "string"
    },
    "engagement_id": {
      "format": "uuid",
      "title": "Engagement Id",
      "type": "string"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_version": {
      "minimum": 1,
      "title": "Scope Version",
      "type": "integer"
    },
    "target_id": {
      "format": "uuid",
      "title": "Target Id",
      "type": "string"
    },
    "target_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Digest",
      "type": "string"
    },
    "purpose": {
      "$ref": "#/$defs/TestIdentityPurpose"
    },
    "role_ref": {
      "pattern": "^role:[a-zA-Z0-9._-]{1,200}$",
      "title": "Role Ref",
      "type": "string"
    },
    "action_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Action Digest",
      "type": "string"
    },
    "action_name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Action Name",
      "type": "string"
    },
    "mutates_state": {
      "title": "Mutates State",
      "type": "boolean"
    },
    "required_approvals": {
      "items": {
        "$ref": "#/$defs/ApprovalAction"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Required Approvals",
      "type": "array"
    },
    "limits": {
      "$ref": "#/$defs/CredentialSessionLimits"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "lease_expires_at": {
      "format": "date-time",
      "title": "Lease Expires At",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "network_execution_authorized": {
      "const": false,
      "default": false,
      "title": "Network Execution Authorized",
      "type": "boolean"
    },
    "third_party_account_authorized": {
      "const": false,
      "default": false,
      "title": "Third Party Account Authorized",
      "type": "boolean"
    },
    "secret_material_present": {
      "const": false,
      "default": false,
      "title": "Secret Material Present",
      "type": "boolean"
    }
  },
  "required": [
    "plan_id",
    "admission_plan_id",
    "admission_id",
    "record_id",
    "identity_ref",
    "credential_ref",
    "engagement_id",
    "scope_id",
    "scope_version",
    "target_id",
    "target_digest",
    "purpose",
    "role_ref",
    "action_digest",
    "action_name",
    "mutates_state",
    "required_approvals",
    "limits",
    "created_at",
    "deadline",
    "lease_expires_at",
    "idempotency_key"
  ],
  "title": "CredentialSessionPlan",
  "type": "object"
}
