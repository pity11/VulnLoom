{
  "$defs": {
    "SourceLanguage": {
      "enum": [
        "python",
        "javascript",
        "typescript"
      ],
      "title": "SourceLanguage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "path": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Path",
      "type": "string"
    },
    "language": {
      "$ref": "#/$defs/SourceLanguage"
    },
    "size": {
      "minimum": 0,
      "title": "Size",
      "type": "integer"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    }
  },
  "required": [
    "path",
    "language",
    "size",
    "sha256"
  ],
  "title": "SourceFileRecord",
  "type": "object"
}
