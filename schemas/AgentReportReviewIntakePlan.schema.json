{
  "$defs": {
    "ReportChannel": {
      "enum": [
        "generic",
        "edusrc",
        "cnvd",
        "vendor",
        "cve-draft"
      ],
      "title": "ReportChannel",
      "type": "string"
    },
    "ReportReviewStatus": {
      "enum": [
        "draft",
        "changes_requested",
        "rejected",
        "human_approved",
        "exported",
        "submitted"
      ],
      "title": "ReportReviewStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "intake_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Intake Plan Id",
      "type": "string"
    },
    "draft_execution_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Draft Execution Plan Id",
      "type": "string"
    },
    "draft_execution_plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Draft Execution Plan Digest",
      "type": "string"
    },
    "draft_outcome_binding_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Draft Outcome Binding Id",
      "type": "string"
    },
    "draft_outcome_binding_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Draft Outcome Binding Digest",
      "type": "string"
    },
    "report_outcome_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Outcome Digest",
      "type": "string"
    },
    "report_review_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Review Plan Id",
      "type": "string"
    },
    "report_review_plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Review Plan Digest",
      "type": "string"
    },
    "report_id": {
      "format": "uuid",
      "title": "Report Id",
      "type": "string"
    },
    "report_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Digest",
      "type": "string"
    },
    "artifact_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Digest",
      "type": "string"
    },
    "report_family_id": {
      "format": "uuid",
      "title": "Report Family Id",
      "type": "string"
    },
    "report_version": {
      "minimum": 1,
      "title": "Report Version",
      "type": "integer"
    },
    "finding_id": {
      "format": "uuid",
      "title": "Finding Id",
      "type": "string"
    },
    "candidate_id": {
      "format": "uuid",
      "title": "Candidate Id",
      "type": "string"
    },
    "evidence_bundle_id": {
      "format": "uuid",
      "title": "Evidence Bundle Id",
      "type": "string"
    },
    "evidence_bundle_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Bundle Digest",
      "type": "string"
    },
    "evidence_catalog_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Catalog Digest",
      "type": "string"
    },
    "channel": {
      "$ref": "#/$defs/ReportChannel"
    },
    "review_status": {
      "$ref": "#/$defs/ReportReviewStatus"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_version": {
      "minimum": 1,
      "title": "Scope Version",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision_deadline": {
      "format": "date-time",
      "title": "Decision Deadline",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "intake_plan_id",
    "draft_execution_plan_id",
    "draft_execution_plan_digest",
    "draft_outcome_binding_id",
    "draft_outcome_binding_digest",
    "report_outcome_digest",
    "report_review_plan_id",
    "report_review_plan_digest",
    "report_id",
    "report_digest",
    "artifact_digest",
    "report_family_id",
    "report_version",
    "finding_id",
    "candidate_id",
    "evidence_bundle_id",
    "evidence_bundle_digest",
    "evidence_catalog_digest",
    "channel",
    "review_status",
    "scope_id",
    "scope_version",
    "created_at",
    "decision_deadline",
    "idempotency_key"
  ],
  "title": "AgentReportReviewIntakePlan",
  "type": "object"
}
