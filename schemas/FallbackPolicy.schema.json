{
  "$defs": {
    "FallbackTrigger": {
      "enum": [
        "rate_limited",
        "timeout",
        "provider_unavailable",
        "empty_response"
      ],
      "title": "FallbackTrigger",
      "type": "string"
    },
    "ModelReference": {
      "additionalProperties": false,
      "properties": {
        "provider_profile_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Provider Profile Digest",
          "type": "string"
        },
        "capability_manifest_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Capability Manifest Digest",
          "type": "string"
        },
        "provider_model_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$",
          "title": "Provider Model Id",
          "type": "string"
        }
      },
      "required": [
        "provider_profile_digest",
        "capability_manifest_digest",
        "provider_model_id"
      ],
      "title": "ModelReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "policy_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Digest",
      "type": "string"
    },
    "ordered_models": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ModelReference"
      },
      "maxItems": 4,
      "title": "Ordered Models",
      "type": "array"
    },
    "triggers": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FallbackTrigger"
      },
      "maxItems": 4,
      "title": "Triggers",
      "type": "array"
    },
    "max_fallback_attempts": {
      "default": 0,
      "maximum": 4,
      "minimum": 0,
      "title": "Max Fallback Attempts",
      "type": "integer"
    },
    "allow_cross_provider": {
      "default": false,
      "title": "Allow Cross Provider",
      "type": "boolean"
    },
    "require_operator_approval": {
      "default": false,
      "title": "Require Operator Approval",
      "type": "boolean"
    },
    "only_before_effect_commit": {
      "const": true,
      "default": true,
      "title": "Only Before Effect Commit",
      "type": "boolean"
    }
  },
  "required": [
    "policy_digest"
  ],
  "title": "FallbackPolicy",
  "type": "object"
}
