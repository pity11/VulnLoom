{
  "$defs": {
    "ReportChannel": {
      "enum": [
        "generic",
        "edusrc",
        "cnvd",
        "vendor",
        "cve-draft"
      ],
      "title": "ReportChannel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "execution_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Plan Id",
      "type": "string"
    },
    "report_intake_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Intake Plan Id",
      "type": "string"
    },
    "report_intake_record_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Intake Record Id",
      "type": "string"
    },
    "report_intake_record_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Intake Record Digest",
      "type": "string"
    },
    "finding_promotion_execution_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Finding Promotion Execution Plan Id",
      "type": "string"
    },
    "finding_promotion_outcome_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Finding Promotion Outcome Id",
      "type": "string"
    },
    "finding_promotion_outcome_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Finding Promotion Outcome Digest",
      "type": "string"
    },
    "report_draft_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Draft Plan Id",
      "type": "string"
    },
    "report_draft_plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Draft Plan Digest",
      "type": "string"
    },
    "evidence_catalog_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Catalog Digest",
      "type": "string"
    },
    "report_family_id": {
      "format": "uuid",
      "title": "Report Family Id",
      "type": "string"
    },
    "report_version": {
      "minimum": 1,
      "title": "Report Version",
      "type": "integer"
    },
    "finding_id": {
      "format": "uuid",
      "title": "Finding Id",
      "type": "string"
    },
    "candidate_id": {
      "format": "uuid",
      "title": "Candidate Id",
      "type": "string"
    },
    "evidence_bundle_id": {
      "format": "uuid",
      "title": "Evidence Bundle Id",
      "type": "string"
    },
    "channel": {
      "$ref": "#/$defs/ReportChannel"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_version": {
      "minimum": 1,
      "title": "Scope Version",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "execution_plan_id",
    "report_intake_plan_id",
    "report_intake_record_id",
    "report_intake_record_digest",
    "finding_promotion_execution_plan_id",
    "finding_promotion_outcome_id",
    "finding_promotion_outcome_digest",
    "report_draft_plan_id",
    "report_draft_plan_digest",
    "evidence_catalog_digest",
    "report_family_id",
    "report_version",
    "finding_id",
    "candidate_id",
    "evidence_bundle_id",
    "channel",
    "scope_id",
    "scope_version",
    "created_at",
    "deadline",
    "idempotency_key"
  ],
  "title": "AgentReportDraftExecutionPlan",
  "type": "object"
}
