{
  "$defs": {
    "CampaignPhaseKind": {
      "enum": [
        "scope_confirmation",
        "observation",
        "hypothesis",
        "validation",
        "critic_review",
        "cleanup_confirmation"
      ],
      "title": "CampaignPhaseKind",
      "type": "string"
    },
    "RuntimeAssuranceLevel": {
      "enum": [
        "local_docker",
        "rootless_production"
      ],
      "title": "RuntimeAssuranceLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "observation_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Observation Id",
      "type": "string"
    },
    "runtime_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Plan Id",
      "type": "string"
    },
    "campaign_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Campaign Plan Id",
      "type": "string"
    },
    "campaign_outcome_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Campaign Outcome Id",
      "type": "string"
    },
    "phase_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Phase Id",
      "type": "string"
    },
    "phase_kind": {
      "$ref": "#/$defs/CampaignPhaseKind"
    },
    "ordinal": {
      "maximum": 6,
      "minimum": 1,
      "title": "Ordinal",
      "type": "integer"
    },
    "prerequisite_phase_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 8,
      "title": "Prerequisite Phase Ids",
      "type": "array"
    },
    "approval_id": {
      "format": "uuid",
      "title": "Approval Id",
      "type": "string"
    },
    "approval_action": {
      "const": "advance_campaign_phase",
      "default": "advance_campaign_phase",
      "title": "Approval Action",
      "type": "string"
    },
    "approval_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approval Digest",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "image_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Image Digest",
      "type": "string"
    },
    "sandbox_profile_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sandbox Profile Digest",
      "type": "string"
    },
    "invocation_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Invocation Digest",
      "type": "string"
    },
    "runner_result_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runner Result Digest",
      "type": "string"
    },
    "status": {
      "const": "completed",
      "default": "completed",
      "title": "Status",
      "type": "string"
    },
    "assurance_level": {
      "$ref": "#/$defs/RuntimeAssuranceLevel"
    },
    "actual_container_observed": {
      "const": true,
      "default": true,
      "title": "Actual Container Observed",
      "type": "boolean"
    },
    "network_disabled": {
      "const": true,
      "default": true,
      "title": "Network Disabled",
      "type": "boolean"
    },
    "non_root": {
      "const": true,
      "default": true,
      "title": "Non Root",
      "type": "boolean"
    },
    "read_only_root": {
      "const": true,
      "default": true,
      "title": "Read Only Root",
      "type": "boolean"
    },
    "capabilities_dropped": {
      "const": true,
      "default": true,
      "title": "Capabilities Dropped",
      "type": "boolean"
    },
    "no_new_privileges": {
      "const": true,
      "default": true,
      "title": "No New Privileges",
      "type": "boolean"
    },
    "seccomp_enforced": {
      "const": true,
      "default": true,
      "title": "Seccomp Enforced",
      "type": "boolean"
    },
    "resource_limits_enforced": {
      "const": true,
      "default": true,
      "title": "Resource Limits Enforced",
      "type": "boolean"
    },
    "environment_allowlisted": {
      "const": true,
      "default": true,
      "title": "Environment Allowlisted",
      "type": "boolean"
    },
    "content_mount_read_only": {
      "const": true,
      "default": true,
      "title": "Content Mount Read Only",
      "type": "boolean"
    },
    "docker_socket_absent": {
      "const": true,
      "default": true,
      "title": "Docker Socket Absent",
      "type": "boolean"
    },
    "target_set_unchanged": {
      "const": true,
      "default": true,
      "title": "Target Set Unchanged",
      "type": "boolean"
    },
    "no_action_executed": {
      "const": true,
      "default": true,
      "title": "No Action Executed",
      "type": "boolean"
    },
    "cleanup_verified": {
      "const": true,
      "default": true,
      "title": "Cleanup Verified",
      "type": "boolean"
    },
    "container_absent": {
      "const": true,
      "default": true,
      "title": "Container Absent",
      "type": "boolean"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    }
  },
  "required": [
    "observation_id",
    "runtime_plan_id",
    "campaign_plan_id",
    "campaign_outcome_id",
    "phase_id",
    "phase_kind",
    "ordinal",
    "prerequisite_phase_ids",
    "approval_id",
    "approval_digest",
    "run_id",
    "task_id",
    "image_digest",
    "sandbox_profile_digest",
    "invocation_digest",
    "runner_result_digest",
    "assurance_level",
    "observed_at"
  ],
  "title": "CampaignPhaseRuntimeObservation",
  "type": "object"
}
