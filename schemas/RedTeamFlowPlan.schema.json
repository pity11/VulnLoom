{
  "$defs": {
    "AuthorizedWebTarget": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "AuthorizedWebTarget",
      "type": "object"
    },
    "AutonomyLevel": {
      "enum": [
        "a0_manual",
        "a1_assisted",
        "a2_bounded_execution",
        "a3_adaptive_flow",
        "a4_goal_driven_campaign"
      ],
      "title": "AutonomyLevel",
      "type": "string"
    },
    "ExecutionProfile": {
      "enum": [
        "benchmark",
        "production_safe",
        "pre_release",
        "red_team"
      ],
      "title": "ExecutionProfile",
      "type": "string"
    },
    "ImpactClass": {
      "enum": [
        "read_only",
        "state_change",
        "real_credential",
        "external_callback",
        "lateral_movement",
        "persistence"
      ],
      "title": "ImpactClass",
      "type": "string"
    },
    "RedTeamPhase": {
      "enum": [
        "recon",
        "initial_access",
        "validation",
        "post_exploitation"
      ],
      "title": "RedTeamPhase",
      "type": "string"
    },
    "RedTeamStopConditions": {
      "additionalProperties": false,
      "properties": {
        "stop_at": {
          "format": "date-time",
          "title": "Stop At",
          "type": "string"
        },
        "max_actions": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Actions",
          "type": "integer"
        },
        "max_consecutive_failures": {
          "default": 3,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Consecutive Failures",
          "type": "integer"
        }
      },
      "required": [
        "stop_at",
        "max_actions"
      ],
      "title": "RedTeamStopConditions",
      "type": "object"
    },
    "RulesOfEngagement": {
      "additionalProperties": false,
      "properties": {
        "roe_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Roe Id",
          "type": "string"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "scope_version": {
          "minimum": 1,
          "title": "Scope Version",
          "type": "integer"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "phases": {
          "items": {
            "$ref": "#/$defs/RedTeamPhase"
          },
          "minItems": 1,
          "title": "Phases",
          "type": "array"
        },
        "allowed_test_classes": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Allowed Test Classes",
          "type": "array"
        },
        "allowed_impacts": {
          "items": {
            "$ref": "#/$defs/ImpactClass"
          },
          "minItems": 1,
          "title": "Allowed Impacts",
          "type": "array"
        },
        "approval_required_impacts": {
          "items": {
            "$ref": "#/$defs/ImpactClass"
          },
          "title": "Approval Required Impacts",
          "type": "array"
        },
        "prohibited_impacts": {
          "items": {
            "$ref": "#/$defs/ImpactClass"
          },
          "title": "Prohibited Impacts",
          "type": "array"
        },
        "stop_conditions": {
          "$ref": "#/$defs/RedTeamStopConditions"
        },
        "emergency_contact_ref": {
          "pattern": "^contact:[a-zA-Z0-9._-]{1,200}$",
          "title": "Emergency Contact Ref",
          "type": "string"
        }
      },
      "required": [
        "roe_id",
        "scope_id",
        "scope_version",
        "target_id",
        "phases",
        "allowed_test_classes",
        "allowed_impacts",
        "approval_required_impacts",
        "prohibited_impacts",
        "stop_conditions",
        "emergency_contact_ref"
      ],
      "title": "RulesOfEngagement",
      "type": "object"
    },
    "Visibility": {
      "enum": [
        "black_box",
        "grey_box",
        "white_box",
        "hybrid"
      ],
      "title": "Visibility",
      "type": "string"
    },
    "WorkflowKind": {
      "enum": [
        "source_hunt",
        "pre_release_acceptance",
        "production_testing",
        "authorized_red_team"
      ],
      "title": "WorkflowKind",
      "type": "string"
    },
    "WorkflowMode": {
      "additionalProperties": false,
      "properties": {
        "workflow": {
          "$ref": "#/$defs/WorkflowKind"
        },
        "visibility": {
          "$ref": "#/$defs/Visibility"
        },
        "execution_profile": {
          "$ref": "#/$defs/ExecutionProfile"
        },
        "autonomy": {
          "$ref": "#/$defs/AutonomyLevel"
        }
      },
      "required": [
        "workflow",
        "visibility",
        "execution_profile",
        "autonomy"
      ],
      "title": "WorkflowMode",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/WorkflowMode"
    },
    "target": {
      "$ref": "#/$defs/AuthorizedWebTarget"
    },
    "rules": {
      "$ref": "#/$defs/RulesOfEngagement"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "mode",
    "target",
    "rules",
    "created_at",
    "deadline",
    "idempotency_key"
  ],
  "title": "RedTeamFlowPlan",
  "type": "object"
}
