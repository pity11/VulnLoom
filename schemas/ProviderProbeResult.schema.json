{
  "additionalProperties": false,
  "properties": {
    "result_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Id",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "rejected",
        "timed_out"
      ],
      "title": "Status",
      "type": "string"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "output_tokens": {
      "maximum": 512,
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "process_started": {
      "title": "Process Started",
      "type": "boolean"
    },
    "cleanup_verified": {
      "title": "Cleanup Verified",
      "type": "boolean"
    },
    "attempt_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Attempt Digest"
    },
    "receipt_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Receipt Digest"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "response_model": {
      "anyOf": [
        {
          "enum": [
            "deepseek-v4-flash",
            "deepseek-v4-flash-0731"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Model"
    }
  },
  "required": [
    "result_id",
    "plan_id",
    "status",
    "input_tokens",
    "output_tokens",
    "process_started",
    "cleanup_verified",
    "attempt_digest",
    "receipt_digest",
    "completed_at"
  ],
  "title": "ProviderProbeResult",
  "type": "object"
}
