{
  "$defs": {
    "AgentToolHandoffCleanup": {
      "additionalProperties": false,
      "properties": {
        "raw_agent_arguments_absent": {
          "title": "Raw Agent Arguments Absent",
          "type": "boolean"
        },
        "raw_tool_response_absent": {
          "title": "Raw Tool Response Absent",
          "type": "boolean"
        },
        "authorization_enforced": {
          "title": "Authorization Enforced",
          "type": "boolean"
        },
        "no_vulnloom_domain_state_changed": {
          "title": "No Vulnloom Domain State Changed",
          "type": "boolean"
        }
      },
      "required": [
        "raw_agent_arguments_absent",
        "raw_tool_response_absent",
        "authorization_enforced",
        "no_vulnloom_domain_state_changed"
      ],
      "title": "AgentToolHandoffCleanup",
      "type": "object"
    },
    "AgentToolHandoffStatus": {
      "enum": [
        "completed",
        "denied",
        "approval_required",
        "timed_out",
        "failed"
      ],
      "title": "AgentToolHandoffStatus",
      "type": "string"
    },
    "AgentToolObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Id",
          "type": "string"
        },
        "handoff_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Handoff Id",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "target_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "scope_version": {
          "minimum": 1,
          "title": "Scope Version",
          "type": "integer"
        },
        "tool_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Tool Id",
          "type": "string"
        },
        "broker_result_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Broker Result Digest",
          "type": "string"
        },
        "status_code": {
          "maximum": 599,
          "minimum": 100,
          "title": "Status Code",
          "type": "integer"
        },
        "final_url_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Final Url Digest",
          "type": "string"
        },
        "response_bytes": {
          "maximum": 20971520,
          "minimum": 0,
          "title": "Response Bytes",
          "type": "integer"
        },
        "response_body_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Body Sha256",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "handoff_id",
        "task_id",
        "target_id",
        "target_version",
        "scope_id",
        "scope_version",
        "tool_id",
        "broker_result_digest",
        "status_code",
        "final_url_digest",
        "response_bytes",
        "response_body_sha256",
        "evidence_refs",
        "observed_at"
      ],
      "title": "AgentToolObservation",
      "type": "object"
    },
    "BrokerResult": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "format": "uuid",
          "title": "Call Id",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "tool_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Tool Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/BrokerStatus"
        },
        "registry_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Registry Digest",
          "type": "string"
        },
        "call_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Call Digest",
          "type": "string"
        },
        "tool_calls_used": {
          "minimum": 0,
          "title": "Tool Calls Used",
          "type": "integer"
        },
        "policy_records": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PolicyRecord"
          },
          "title": "Policy Records",
          "type": "array"
        },
        "http": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpToolResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Error Codes",
          "type": "array"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "task_id",
        "tool_id",
        "status",
        "registry_digest",
        "call_digest",
        "tool_calls_used",
        "completed_at"
      ],
      "title": "BrokerResult",
      "type": "object"
    },
    "BrokerStatus": {
      "enum": [
        "completed",
        "denied",
        "approval_required",
        "timed_out",
        "failed"
      ],
      "title": "BrokerStatus",
      "type": "string"
    },
    "DecisionEffect": {
      "enum": [
        "allow",
        "deny",
        "approval_required"
      ],
      "title": "DecisionEffect",
      "type": "string"
    },
    "HttpToolResult": {
      "additionalProperties": false,
      "properties": {
        "status_code": {
          "maximum": 599,
          "minimum": 100,
          "title": "Status Code",
          "type": "integer"
        },
        "final_url_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Final Url Digest",
          "type": "string"
        },
        "peer_ip": {
          "minLength": 1,
          "title": "Peer Ip",
          "type": "string"
        },
        "response_bytes": {
          "minimum": 0,
          "title": "Response Bytes",
          "type": "integer"
        },
        "response_body_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Body Sha256",
          "type": "string"
        },
        "redirects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RedirectRecord"
          },
          "title": "Redirects",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "status_code",
        "final_url_digest",
        "peer_ip",
        "response_bytes",
        "response_body_sha256",
        "evidence_refs"
      ],
      "title": "HttpToolResult",
      "type": "object"
    },
    "PolicyRecord": {
      "additionalProperties": false,
      "properties": {
        "action_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Action Digest",
          "type": "string"
        },
        "effect": {
          "$ref": "#/$defs/DecisionEffect"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "obligations": {
          "items": {
            "type": "string"
          },
          "title": "Obligations",
          "type": "array"
        },
        "policy_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        }
      },
      "required": [
        "action_digest",
        "effect",
        "reasons",
        "obligations",
        "policy_digest"
      ],
      "title": "PolicyRecord",
      "type": "object"
    },
    "RedirectRecord": {
      "additionalProperties": false,
      "properties": {
        "status_code": {
          "maximum": 399,
          "minimum": 300,
          "title": "Status Code",
          "type": "integer"
        },
        "from_url_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "From Url Digest",
          "type": "string"
        },
        "to_url_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "To Url Digest",
          "type": "string"
        },
        "peer_ip": {
          "minLength": 1,
          "title": "Peer Ip",
          "type": "string"
        }
      },
      "required": [
        "status_code",
        "from_url_digest",
        "to_url_digest",
        "peer_ip"
      ],
      "title": "RedirectRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "outcome_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Outcome Id",
      "type": "string"
    },
    "handoff_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Handoff Id",
      "type": "string"
    },
    "agent_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Agent Plan Id",
      "type": "string"
    },
    "agent_outcome_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Agent Outcome Digest",
      "type": "string"
    },
    "broker_call_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Broker Call Digest",
      "type": "string"
    },
    "attempt": {
      "maximum": 2,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/AgentToolHandoffStatus"
    },
    "broker_result": {
      "$ref": "#/$defs/BrokerResult"
    },
    "observation": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentToolObservation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cleanup": {
      "$ref": "#/$defs/AgentToolHandoffCleanup"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    }
  },
  "required": [
    "outcome_id",
    "handoff_id",
    "agent_plan_id",
    "agent_outcome_digest",
    "broker_call_digest",
    "attempt",
    "status",
    "broker_result",
    "cleanup",
    "completed_at"
  ],
  "title": "AgentToolHandoffOutcome",
  "type": "object"
}
