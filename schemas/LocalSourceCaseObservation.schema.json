{
  "$defs": {
    "LocalCandidateObservation": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "cwe": {
          "pattern": "^CWE-[1-9][0-9]*$",
          "title": "Cwe",
          "type": "string"
        },
        "duplicate_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Duplicate Fingerprint",
          "type": "string"
        },
        "signal_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Signal Ids",
          "type": "array"
        },
        "entry_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Entry Path",
          "type": "string"
        },
        "sink_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Sink Path",
          "type": "string"
        },
        "code_path_count": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Code Path Count",
          "type": "integer"
        }
      },
      "required": [
        "candidate_id",
        "cwe",
        "duplicate_fingerprint",
        "signal_ids",
        "entry_path",
        "sink_path",
        "code_path_count"
      ],
      "title": "LocalCandidateObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Case Id",
      "type": "string"
    },
    "target_version": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Version",
      "type": "string"
    },
    "source_graph_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Graph Id",
      "type": "string"
    },
    "candidate_set_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Set Id",
      "type": "string"
    },
    "candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LocalCandidateObservation"
      },
      "title": "Candidates",
      "type": "array"
    }
  },
  "required": [
    "case_id",
    "target_version",
    "source_graph_id",
    "candidate_set_id"
  ],
  "title": "LocalSourceCaseObservation",
  "type": "object"
}
