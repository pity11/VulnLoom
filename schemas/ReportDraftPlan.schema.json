{
  "$defs": {
    "ReportChannel": {
      "enum": [
        "generic",
        "edusrc",
        "cnvd",
        "vendor",
        "cve-draft"
      ],
      "title": "ReportChannel",
      "type": "string"
    },
    "ReportSection": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ReportSectionKind"
        },
        "text": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "ReportSection",
      "type": "object"
    },
    "ReportSectionKind": {
      "enum": [
        "summary",
        "code_location",
        "request_response",
        "reproduction",
        "impact",
        "remediation"
      ],
      "title": "ReportSectionKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "finding_id": {
      "format": "uuid",
      "title": "Finding Id",
      "type": "string"
    },
    "finding_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Finding Digest",
      "type": "string"
    },
    "candidate_id": {
      "format": "uuid",
      "title": "Candidate Id",
      "type": "string"
    },
    "candidate_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Digest",
      "type": "string"
    },
    "evidence_bundle_id": {
      "format": "uuid",
      "title": "Evidence Bundle Id",
      "type": "string"
    },
    "evidence_bundle_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Bundle Digest",
      "type": "string"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_version": {
      "minimum": 1,
      "title": "Scope Version",
      "type": "integer"
    },
    "channel": {
      "$ref": "#/$defs/ReportChannel"
    },
    "title": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/ReportSection"
      },
      "maxItems": 32,
      "minItems": 6,
      "title": "Sections",
      "type": "array"
    },
    "prepared_by": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Prepared By",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "finding_id",
    "finding_digest",
    "candidate_id",
    "candidate_digest",
    "evidence_bundle_id",
    "evidence_bundle_digest",
    "scope_id",
    "scope_version",
    "channel",
    "title",
    "sections",
    "prepared_by",
    "created_at",
    "deadline",
    "idempotency_key"
  ],
  "title": "ReportDraftPlan",
  "type": "object"
}
